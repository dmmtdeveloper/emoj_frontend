# Front door of the site on Railway: Caddy serves the pages built ahead of
# time from disk and passes everything else to the Astro Node server
# (pages with API content, images, /admin/revalidar), which listens only on
# localhost inside the same container (scripts/start.sh).
#
# Mirrors vercel.ts: the same security headers, redirects, the /api rewrite
# to the backend and the cache rules. tests/caddyfile.test.ts fails when the
# two drift, so change both together. See docs/deploy-railway.md.
#
# Environment (Railway service variables):
#   PORT          set by Railway (8080 by default here).
#   NODE_PORT     where the Astro server listens on localhost (4321).
#   API_ORIGIN    public API origin for the CSP connect-src, e.g.
#                 https://api.emoj.cl (the contact form calls it directly).
#   API_UPSTREAM  where /api/* is proxied: the public origin, or the
#                 backend's private address (http://<service>.railway.internal:<port>).
{
	admin off
	auto_https off
	servers {
		# Railway's edge terminates TLS and sets X-Forwarded-*. The container
		# is only reachable through it, so keep those headers as they arrive:
		# the API rate-limits by the first X-Forwarded-For entry.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	root * /app/dist/client
	encode zstd gzip

	@admin path /admin*
	@assets path /_astro/*

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: https://*.t3.storageapi.dev; font-src 'self'; connect-src 'self' {$API_ORIGIN} https://api-staging-25e9.up.railway.app; frame-src https://challenges.cloudflare.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		-Server
	}

	# The admin panel is private: never indexed, never cached by proxies.
	header @admin {
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}

	# Hashed build assets never change, so they can be cached forever.
	header @assets {
		Cache-Control "public, max-age=31557600, immutable"
	}

	# Old WordPress addresses -> new pages, 301 (same list as vercel.ts).
	# Caddy tries exact paths before prefixes, like the order there.
	redir /archivo/2939 /noticias/visita-tecnica-canal-la-petaca 301
	redir /archivo/2899 /noticias/de-sitios-abandonados-a-plazas-comunitarias 301
	redir /archivo/2873 /noticias/redisenar-para-evolucionar 301
	redir /archivo/2841 /noticias/emojita-supervisora-felina 301
	redir /archivo* /noticias 301
	redir /jobs* /contacto 301
	redir /feed* /noticias 301
	redir /comments/feed /noticias 301
	redir /wp-admin* /admin/login 301
	redir /wp-login.php /admin/login 301

	# Same-origin API for the admin (first-party session cookie). The prefix
	# is stripped: /api/v1/auth/me -> <API_UPSTREAM>/v1/auth/me.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	# Pages built ahead of time and the build's assets, straight from disk.
	# trailingSlash "ignore": /nosotros and /nosotros/ both serve the page.
	@built file {
		try_files {path} {path}/index.html
	}
	handle @built {
		rewrite * {file_match.relative}
		file_server
	}

	# Everything else is rendered by the Astro server: the home, projects,
	# news, their images, the 404 page and the panel's refresh endpoint.
	handle {
		reverse_proxy 127.0.0.1:{$NODE_PORT:4321}
	}

	# Only when the Astro server does not answer (starting or crashed).
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
