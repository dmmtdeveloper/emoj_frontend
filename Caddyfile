# Front door of the site on Railway: Caddy serves the static build
# (`pnpm build` writes it to dist/) straight from disk. There is no server
# behind it: every page, image and sitemap is a file.
#
# Mirrors vercel.ts: the same security headers, redirects and cache rules.
# tests/caddyfile.test.ts fails when the two drift, so change both
# together. See docs/deploy-railway.md.
#
# Environment (Railway service variables):
#   PORT  set by Railway (8080 by default here).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /app/dist
	encode zstd gzip

	@assets path /_astro/*
	@speculation path /speculationrules.json

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		# Prerender pages on hover or press (public/speculationrules.json), so
		# the card-to-cover transition has its photo on the first visit.
		Speculation-Rules "\"/speculationrules.json\""
		-Server
	}

	# Browsers only read speculation rules sent with their own type.
	header @speculation {
		Content-Type "application/speculationrules+json"
	}

	# Hashed build assets never change, so they can be cached forever.
	header @assets {
		Cache-Control "public, max-age=31557600, immutable"
	}

	# Old WordPress addresses -> new pages, 301 (same list as vercel.ts).
	# Caddy tries exact paths before prefixes, like the order there.
	redir /archivo/2939 /noticias/visita-tecnica-canal-la-petaca 301
	redir /archivo/2899 /noticias/de-sitios-abandonados-a-plazas-comunitarias 301
	redir /archivo/2873 /noticias/redisenar-para-evolucionar 301
	redir /archivo/2841 /noticias/emojita-supervisora-felina 301
	redir /archivo* /noticias 301
	redir /jobs* /contacto 301
	redir /feed* /noticias 301
	redir /comments/feed /noticias 301
	redir /wp-admin* / 301
	redir /wp-login.php / 301

	# Railway healthcheck (Deploy -> Healthcheck Path) and the image's
	# HEALTHCHECK: Caddy answers it itself.
	respond /healthz 200

	# trailingSlash "ignore": /nosotros and /nosotros/ both serve the page.
	try_files {path} {path}/index.html
	file_server

	# Any other path: the 404 page, with status 404.
	handle_errors 404 {
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}
