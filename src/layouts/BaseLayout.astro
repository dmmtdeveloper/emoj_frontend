---
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import WhatsAppButton from "../components/layout/WhatsAppButton.astro";
import { serializeJsonLd } from "../lib/json-ld";
import { SITE_NAME } from "../lib/site";
import { whatsappHref, type WhatsAppContext } from "../lib/whatsapp";
import "../styles/global.css";

interface Props {
  /** Page title. Rendered as "<title> | EMOJ Consultora". */
  title: string;
  /** Meta description (aim for 120–160 characters). */
  description: string;
  /** Absolute or root-relative URL of the social share image. */
  image?: string;
  /** Alt text for the share image. */
  imageAlt?: string;
  /** Exclude the page from search engines. */
  noindex?: boolean;
  /** Structured data objects, rendered as JSON-LD (not executed as script). */
  jsonLd?: Record<string, unknown>[];
  /** The page opens with a full-bleed photo hero under a transparent header. */
  headerOverlay?: boolean;
  /** What the page is about, for the floating WhatsApp button's message. */
  whatsapp?: WhatsAppContext;
  /**
   * A draft shown through /preview: out of search engines, with a bar that
   * says it is not on the site yet.
   */
  preview?: boolean;
}

const DEFAULT_IMAGE = "/og-default.jpg";
const DEFAULT_IMAGE_ALT = "EMOJ Consultora. Humanizamos la ingeniería.";

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  imageAlt = DEFAULT_IMAGE_ALT,
  noindex = false,
  jsonLd = [],
  headerOverlay = false,
  whatsapp,
  preview = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://emoj.cl");
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const imageUrl = new URL(image, site).href;
const isDefaultImage = image === DEFAULT_IMAGE;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {isDefaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="theme-color"
      content="#FFF8F0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#170828"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((data) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializeJsonLd(data)}
      />
    ))}
  </head>
  <body id="top" class="relative flex min-h-dvh flex-col">
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    {headerOverlay && (
      <div
        data-header-sentinel
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-[140px]"
      />
    )}
    <SiteHeader overlay={headerOverlay} />
    <main id="contenido" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
    {preview ? (
      <>
        <div aria-hidden="true" class="h-20" />
        <div
          role="status"
          class="fixed inset-x-0 bottom-0 z-40 border-t border-border-strong bg-surface-raised shadow-(--shadow-md)"
        >
          <div class="container-site flex min-h-16 flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
            <p class="text-[15px] leading-5">
              <strong class="font-semibold">Vista previa.</strong> Así se verá
              cuando lo publiques; todavía no está en el sitio.
            </p>
            <a href="/admin" class="text-[15px] leading-5 font-medium">
              Volver al panel
            </a>
          </div>
        </div>
      </>
    ) : (
      <WhatsAppButton href={whatsappHref(whatsapp)} />
    )}
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
