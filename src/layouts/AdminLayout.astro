---
/**
 * Layout of the admin panel (/admin): private (noindex, no canonical, no
 * social tags, out of the sitemap), no site header or footer. The page body
 * is the React island (src/admin/AdminApp.tsx), rendered on the client only.
 */
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>{title} | Panel EMOJ</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-dvh bg-surface-sunken text-ink">
    <slot />
    <noscript>
      <p class="p-6">
        El panel de administración necesita JavaScript. Actívalo en tu navegador
        para continuar.
      </p>
    </noscript>
  </body>
</html>

<style is:global>
  /* User menu (native popover): under the navbar, aligned to the right. */
  .admin-popover {
    position: fixed;
    inset: 4.25rem 1rem auto auto;
    margin: 0;
  }

  /* Mobile drawer (native dialog) slides in from the left. */
  .admin-drawer {
    inset: 0 auto 0 0;
  }

  .admin-drawer::backdrop,
  .admin-dialog::backdrop {
    background-color: color-mix(in oklab, var(--plum-950) 55%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .admin-drawer[open] {
      animation: admin-drawer-in 220ms var(--ease-out);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .admin-dialog[open] {
      animation: admin-dialog-in 180ms var(--ease-out);
    }
  }

  @keyframes admin-dialog-in {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  /*
   * Loading and entrance motion: shimmer on placeholders (skeletons.tsx),
   * images that fade in once decoded (FadeImage in ui.tsx) and sections
   * that rise in on navigation. Nothing moves under reduced motion.
   */
  .admin-skeleton {
    background-color: var(--surface-sunken);
    background-image: linear-gradient(
      100deg,
      transparent 20%,
      color-mix(in oklab, var(--surface-raised) 60%, transparent) 50%,
      transparent 80%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 120% 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .admin-skeleton {
      animation: admin-shimmer 1.4s var(--ease-in-out) infinite;
    }

    .admin-fade {
      opacity: 0;
      transition: opacity 320ms var(--ease-out);
    }

    .admin-fade[data-loaded] {
      opacity: 1;
    }

    /* "backwards", not "both": a fill that outlives the animation keeps a
       `translate`, which would trap the editors' fixed action bar. */
    .admin-enter {
      animation: admin-enter 280ms var(--ease-out) backwards;
    }
  }

  @keyframes admin-shimmer {
    to {
      background-position: -120% 0;
    }
  }

  @keyframes admin-enter {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  /*
   * TipTap's base editor styles (normally injected as a <style> element,
   * which the Content-Security-Policy blocks: RichTextEditor.tsx sets
   * injectCSS: false). Kept in sync with @tiptap/core.
   */
  .ProseMirror {
    position: relative;
    overflow-wrap: break-word;
    white-space: pre-wrap;
    white-space: break-spaces;
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0;
  }

  .ProseMirror [contenteditable="false"] {
    white-space: normal;
  }

  .ProseMirror [contenteditable="false"] [contenteditable="true"] {
    white-space: pre-wrap;
  }

  img.ProseMirror-separator {
    display: inline !important;
    border: none !important;
    margin: 0 !important;
    width: 0 !important;
    height: 0 !important;
  }

  .ProseMirror-gapcursor {
    display: none;
    pointer-events: none;
    position: absolute;
    margin: 0;
  }

  .ProseMirror-gapcursor::after {
    content: "";
    display: block;
    position: absolute;
    top: -2px;
    width: 20px;
    border-top: 1px solid var(--ink);
    animation: prosemirror-cursor-blink 1.1s steps(2, start) infinite;
  }

  .ProseMirror-focused .ProseMirror-gapcursor {
    display: block;
  }

  .ProseMirror-hideselection *::selection {
    background: transparent;
  }

  .ProseMirror-hideselection * {
    caret-color: transparent;
  }

  @keyframes prosemirror-cursor-blink {
    to {
      visibility: hidden;
    }
  }

  @keyframes admin-drawer-in {
    from {
      translate: -100% 0;
    }
  }
</style>
