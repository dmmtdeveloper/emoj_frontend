---
/**
 * The EMOJ isotype (hand-drawn stroke + two dots) as inline SVG, so it can
 * be drawn with CSS (`pathLength="1"` + stroke-dashoffset). Geometry from
 * the official brand files (design/brand/oficial): `weight="bold"` (default)
 * is `isotipo-bold.svg`, the heavy stroke for small sizes such as the
 * header; `weight="fine"` uses the `isotipo-recorte` stroke and dots on the
 * same path.
 *
 * Colors come from tokens through custom properties, so the same mark works
 * on every surface:
 * - `--mark-stroke` (default `--brand`) and `--mark-dot` (default `--ink`).
 * - `tone="mono"` paints everything in `currentColor` (inverse surfaces,
 *   where `brand` on plum is a forbidden pair).
 *
 * Motion lives in `src/styles/motion.css` (`.isotipo-mark*`): `draw` plays
 * the stroke once on load, then pops the dots. Reduced motion shows the
 * final state.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"svg">, "viewBox" | "role"> {
  /** Accessible name. Empty string (default) hides the mark from AT. */
  label?: string;
  /** Draw the stroke and pop the dots when the page loads. */
  draw?: boolean;
  tone?: "brand" | "mono";
  /** Official stroke: `bold` for small sizes, `fine` (recorte) for large. */
  weight?: "bold" | "fine";
}

const {
  label = "",
  draw = false,
  tone = "brand",
  weight = "bold",
  class: className,
  ...rest
} = Astro.props;

const stroke = weight === "bold" ? "20" : "10.19";
const dot = weight === "bold" ? "10.5" : "7.93";

const a11y =
  label === ""
    ? { "aria-hidden": "true" as const }
    : { role: "img" as const, "aria-label": label };
---

<svg
  viewBox="100 46 652 245"
  fill="none"
  focusable="false"
  class:list={[
    "isotipo-mark",
    `isotipo-mark--${tone}`,
    draw && "isotipo-mark--draw",
    className,
  ]}
  {...a11y}
  {...rest}
>
  <path
    class="isotipo-mark__ghost"
    pathLength="1"
    stroke-width={stroke}
    stroke-miterlimit="10"
    d="M704.94,151.52c-68.63,24.41-86.21-35.68-122.4,25.65-33.54,56.83-43.33,109.37-86.06,102.96-84.6-12.69,29.25-202.14-37.01-222.01-92.89-27.87-156.27,247.23-255.95,220.47-82.92-22.26,40.5-246.03,82.15-209.9,31.04,26.93-59.38,100.11-137.89,122.95"
  ></path>
  <path
    class="isotipo-mark__stroke"
    pathLength="1"
    stroke-width={stroke}
    stroke-miterlimit="10"
    d="M704.94,151.52c-68.63,24.41-86.21-35.68-122.4,25.65-33.54,56.83-43.33,109.37-86.06,102.96-84.6-12.69,29.25-202.14-37.01-222.01-92.89-27.87-156.27,247.23-255.95,220.47-82.92-22.26,40.5-246.03,82.15-209.9,31.04,26.93-59.38,100.11-137.89,122.95"
  ></path>
  <circle
    class="isotipo-mark__dot isotipo-mark__dot--start"
    cx="121.46"
    cy="198.25"
    r={dot}
  ></circle>
  <circle
    class="isotipo-mark__dot isotipo-mark__dot--end"
    cx="731.23"
    cy="141.49"
    r={dot}
  ></circle>
</svg>
