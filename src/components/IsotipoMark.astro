---
/**
 * The EMOJ isotype (hand-drawn stroke + two dots) as inline SVG, so it can
 * be drawn with CSS (`pathLength="1"` + stroke-dashoffset). Source:
 * `src/assets/brand/emoj-isotipo-nav.svg` (keep the paths in sync).
 *
 * Colors come from tokens through custom properties, so the same mark works
 * on every surface:
 * - `--mark-stroke` (default `--brand`) and `--mark-dot` (default `--ink`).
 * - `tone="mono"` paints everything in `currentColor` (inverse surfaces,
 *   where `brand` on plum is a forbidden pair).
 *
 * Motion lives in `src/styles/motion.css` (`.isotipo-mark*`): `draw` plays
 * the stroke once on load, then pops the dots. Reduced motion shows the
 * final state.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"svg">, "viewBox" | "role"> {
  /** Accessible name. Empty string (default) hides the mark from AT. */
  label?: string;
  /** Draw the stroke and pop the dots when the page loads. */
  draw?: boolean;
  tone?: "brand" | "mono";
}

const {
  label = "",
  draw = false,
  tone = "brand",
  class: className,
  ...rest
} = Astro.props;

const a11y =
  label === ""
    ? { "aria-hidden": "true" as const }
    : { role: "img" as const, "aria-label": label };
---

<svg
  viewBox="0 0 470 171"
  fill="none"
  focusable="false"
  class:list={[
    "isotipo-mark",
    `isotipo-mark--${tone}`,
    draw && "isotipo-mark--draw",
    className,
  ]}
  {...a11y}
  {...rest}
>
  <path
    class="isotipo-mark__ghost"
    pathLength="1"
    stroke-width="10.19"
    stroke-miterlimit="10"
    d="M443.892 73.2754C392.381 90.721 379.186 47.7751 352.023 91.6072C326.849 132.223 319.501 169.773 287.429 165.192C223.931 156.123 309.383 20.7239 259.651 6.52299C189.931 -13.3955 142.36 183.217 67.5435 164.091C5.30653 148.182 97.9414 -11.7446 129.202 14.0773C152.5 33.324 84.6338 85.6253 25.7069 101.949"
  ></path>
  <path
    class="isotipo-mark__stroke"
    pathLength="1"
    stroke-width="10.19"
    stroke-miterlimit="10"
    d="M443.892 73.2754C392.381 90.721 379.186 47.7751 352.023 91.6072C326.849 132.223 319.501 169.773 287.429 165.192C223.931 156.123 309.383 20.7239 259.651 6.52299C189.931 -13.3955 142.36 183.217 67.5435 164.091C5.30653 148.182 97.9414 -11.7446 129.202 14.0773C152.5 33.324 84.6338 85.6253 25.7069 101.949"
  ></path>
  <path
    class="isotipo-mark__dot isotipo-mark__dot--start"
    d="M5.95199 112.333C9.23918 112.333 11.904 109.796 11.904 106.666C11.904 103.535 9.23918 100.998 5.95199 100.998C2.6648 100.998 0 103.535 0 106.666C0 109.796 2.6648 112.333 5.95199 112.333Z"
  ></path>
  <path
    class="isotipo-mark__dot isotipo-mark__dot--end"
    d="M463.625 71.7677C466.912 71.7677 469.577 69.2302 469.577 66.1001C469.577 62.9701 466.912 60.4326 463.625 60.4326C460.337 60.4326 457.673 62.9701 457.673 66.1001C457.673 69.2302 460.337 71.7677 463.625 71.7677Z"
  ></path>
</svg>
