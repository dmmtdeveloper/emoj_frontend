---
/**
 * Home hero, "del croquis a la obra". Three real photos from the original
 * emoj.cl hero (water, a pumping station and an aerial industrial view)
 * under a plum veil and a faint four-column grid, like a drawing sheet.
 *
 * At its foot, a data strip in the data typeface (`font-data`, facts from
 * src/lib/hero-facts.ts) and the reference clients as a moving band of
 * logos (ClientsStrip, `tone="inverse"`).
 *
 * The photos play on their own (src/scripts/hero-slideshow.ts): each one
 * zooms in slowly and the next enters with a left-to-right wipe, like a
 * stroke being drawn. A counter with a progress line shows the current
 * photo, and a button pauses the change (WCAG 2.2.2). The slideshow holds
 * while the hero is off screen or the tab is hidden.
 *
 * Without JavaScript or with reduced motion the hero shows the first photo
 * only (no autoplay, no counter). The section slides under the transparent
 * header (BaseLayout `headerOverlay`).
 */
import { ArrowRight, Pause, Play } from "@lucide/astro";
import { Picture } from "astro:assets";
import water from "../../assets/photos/agua-manos.jpg";
import pumping from "../../assets/photos/estacion-bombeo-tuberias.jpg";
import aerial from "../../assets/photos/vista-aerea-industrial.jpg";
import { getServices } from "../../lib/get-services";
import { heroFacts } from "../../lib/hero-facts";
import { TAGLINE } from "../../lib/site";
import ButtonLink from "../ui/ButtonLink.astro";
import ClientsStrip from "./ClientsStrip.astro";

const photos = [
  {
    src: water,
    alt: "Manos recibiendo un chorro de agua limpia.",
    position: "object-[72%_center]",
    widths: [640, 960, 1280, 1600, 2130],
  },
  {
    src: pumping,
    alt: "Estación de bombeo con tuberías blancas y bombas azules sobre una losa de hormigón.",
    position: "object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
  {
    src: aerial,
    alt: "Vista aérea de un complejo industrial costero con una chimenea alta.",
    position: "object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
];

const facts = heroFacts((await getServices()).length);
---

<section class="hero relative -mt-(--header-h) bg-plum-950 text-sand-50">
  <div class="hero__frame relative isolate overflow-hidden" data-hero>
    {photos.map((photo, i) => (
      <div
        class:list={[
          "hero__media absolute inset-0 -z-10 overflow-hidden",
          `hero__media--${i + 1}`,
        ]}
        data-hero-slide
        data-state={i === 0 ? "active" : undefined}
      >
        <Picture
          src={photo.src}
          alt={photo.alt}
          formats={["avif", "webp"]}
          widths={photo.widths}
          sizes="100vw"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "low"}
          class:list={["hero__img h-full w-full object-cover", photo.position]}
          pictureAttributes={{ class: "contents" }}
        />
      </div>
    ))}
    <div class="absolute inset-0 -z-10 bg-plum-950/65" aria-hidden="true"></div>
    <div
      class="absolute inset-0 -z-10 hidden bg-linear-to-r from-plum-950/55 to-transparent to-70% md:block"
      aria-hidden="true"
    ></div>
    {/* Drawing-sheet grid: four columns, hairlines only. */}
    <div
      class="pointer-events-none absolute inset-0 -z-10 hidden md:block"
      aria-hidden="true"
    >
      <div class="container-site h-full">
        <div class="grid h-full grid-cols-4 border-r border-sand-50/[0.07]">
          <span class="border-l border-sand-50/[0.07]"></span>
          <span class="border-l border-sand-50/[0.07]"></span>
          <span class="border-l border-sand-50/[0.07]"></span>
          <span class="border-l border-sand-50/[0.07]"></span>
        </div>
      </div>
    </div>

    <div class="flex min-h-[max(640px,100svh)] flex-col">
      <div class="container-site flex flex-1 flex-col justify-end gap-6 pt-[calc(var(--header-h)+48px)] pb-10 md:justify-center md:gap-7 md:pb-12">
        <p class="hero-in font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sand-300 uppercase">
          {TAGLINE}
        </p>
        <h1 class="hero-in hero-in--2 text-display max-w-[15ch] font-medium tracking-[-0.035em]">
          Ingeniería civil del primer trazo a la obra
        </h1>
        <p class="hero-in hero-in--3 text-lead max-w-[46ch] text-sand-100">
          Agua potable, caminos, estructuras y fundaciones para empresas de
          Valparaíso y Coquimbo. Un equipo que te acompaña de principio a fin.
        </p>
        <div class="hero-in hero-in--4 flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:gap-7">
          <ButtonLink
            href="/contacto"
            variant="on-photo-solid"
            class="min-h-12 px-6 text-base"
          >
            Cotizar proyecto
          </ButtonLink>
          <a
            href="/proyectos"
            class="group inline-flex min-h-12 items-center gap-2 self-start text-base font-semibold text-sand-50 no-underline hover:text-sand-50 sm:self-auto"
          >
            Ver proyectos
            <ArrowRight
              size={20}
              stroke-width={1.75}
              aria-hidden="true"
              class="transition-transform duration-300 ease-(--ease-out) group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>

      <div class="container-site">
        {/* Photo counter with a progress line, and the pause button. */}
        <div class="hero__counter items-center justify-end gap-4 pb-4 text-[13px] leading-4 font-medium tracking-[0.14em] text-sand-100 tabular-nums">
          <span class="flex items-center gap-4 font-data" aria-hidden="true">
            <span class="w-[2ch]" data-hero-count>
              01
            </span>
            <span class="relative block h-0.5 w-16 overflow-hidden rounded-full bg-sand-50/25 md:w-24">
              <span
                class="hero__progress absolute inset-0 origin-left rounded-full bg-sand-50"
                data-hero-progress
              ></span>
            </span>
            <span>{String(photos.length).padStart(2, "0")}</span>
          </span>
          <button
            type="button"
            class="hero__toggle grid size-9 place-items-center rounded-full border border-sand-50/40 text-sand-50 transition-colors hover:bg-sand-50/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand-50"
            aria-label="Pausar el cambio de fotos"
            data-hero-toggle
          >
            <Pause
              class="hero__icon-pause"
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
            <Play
              class="hero__icon-play"
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <dl class="hero-in hero-in--4 grid grid-cols-2 border-t border-sand-50/20 md:grid-cols-4">
          {facts.map((fact) => (
            <div class="flex flex-col gap-1.5 border-sand-50/20 py-4 pr-4 even:border-l even:pl-4 md:border-l md:px-6 md:py-5 md:first:border-l-0 md:first:pl-0">
              <dt class="font-data text-[12px] leading-4 font-medium tracking-[0.1em] text-sand-300 uppercase">
                {fact.label}
              </dt>
              <dd class="font-data text-[17px] leading-6 font-medium text-sand-50 md:text-xl md:leading-7">
                {fact.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <ClientsStrip tone="inverse" />
    </div>
  </div>
</section>

<script>
  import "../../scripts/hero-slideshow";
</script>

<style>
  /* Static fallback: only the first photo; no counter. */
  .hero__media--2,
  .hero__media--3,
  .hero__counter {
    display: none;
  }

  /*
   * Slideshow, armed by src/scripts/hero-slideshow.ts (never with reduced
   * motion). `data-state` on each photo: "active" is on top and wipes in,
   * "prev" stays visible underneath until the wipe covers it; the rest are
   * hidden. The slow zoom keeps running from "active" to "prev" (same
   * animation), so the outgoing photo never jumps.
   */
  .hero__frame[data-slideshow] .hero__media {
    display: block;
    visibility: hidden;
  }

  .hero__frame[data-slideshow] .hero__media[data-state] {
    visibility: visible;
  }

  .hero__frame[data-slideshow] .hero__media[data-state="prev"] {
    z-index: -11;
  }

  .hero__frame[data-slideshow] .hero__counter {
    display: flex;
  }

  .hero__icon-play,
  .hero__frame[data-paused] .hero__icon-pause {
    display: none;
  }

  .hero__frame[data-paused] .hero__icon-play {
    display: block;
  }

  .hero__media--1 {
    --zoom-origin: 70% 55%;
  }

  .hero__media--2 {
    --zoom-origin: 30% 40%;
  }

  .hero__media--3 {
    --zoom-origin: 55% 65%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media[data-state="active"] {
      animation: wipe-right 1300ms var(--ease-in-out) both;
    }

    .hero__media[data-state] :global(.hero__img) {
      transform-origin: var(--zoom-origin, center);
      animation: hero-zoom var(--hero-zoom-ms, 9000ms) linear both;
    }

    .hero__frame[data-slideshow] .hero__progress[data-run] {
      animation: hero-fill var(--hero-slide-ms, 6500ms) linear both;
    }

    /* Paused by the person or off screen: everything holds still. */
    .hero__frame:is([data-paused], [data-held]) .hero__progress[data-run],
    .hero__frame:is([data-paused], [data-held]) .hero__media[data-state],
    .hero__frame:is([data-paused], [data-held])
      .hero__media[data-state]
      :global(.hero__img) {
      animation-play-state: paused;
    }

    .hero-in {
      animation: rise 900ms var(--ease-out) 250ms both;
    }

    .hero-in--2 {
      animation-delay: 380ms;
    }

    .hero-in--3 {
      animation-delay: 560ms;
    }

    .hero-in--4 {
      animation-delay: 700ms;
    }
  }

  /* A slow push-in, from slightly zoomed so the first frames already move. */
  @keyframes hero-zoom {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.14);
    }
  }

  @keyframes hero-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
