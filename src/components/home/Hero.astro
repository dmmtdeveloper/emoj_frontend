---
/**
 * Home hero, "del croquis a la obra". Three real photos from the original
 * emoj.cl hero (water, a pumping station and an aerial industrial view).
 *
 * The section is a scroll track: its inner frame sticks to the viewport
 * while the page scrolls through the track, and photos 2 and 3 enter with a
 * left-to-right wipe (like a stroke being drawn) driven by the scroll
 * (CSS view timeline, no JavaScript). Headline and buttons stay put; a
 * counter with a drawn progress line shows the current photo. On load the
 * first photo is revealed with the same wipe.
 *
 * Without scroll-driven animations or with reduced motion the hero is a
 * single, non-sticky screen with the first photo (no autoplay, no carousel).
 * The section slides under the transparent header (BaseLayout
 * `headerOverlay`).
 */
import { ArrowRight } from "@lucide/astro";
import { Picture } from "astro:assets";
import water from "../../assets/photos/agua-manos.jpg";
import pumping from "../../assets/photos/estacion-bombeo-tuberias.jpg";
import aerial from "../../assets/photos/vista-aerea-industrial.jpg";
import { TAGLINE } from "../../lib/site";
import ButtonLink from "../ui/ButtonLink.astro";
import Scribble from "../ui/Scribble.astro";

const photos = [
  {
    src: water,
    alt: "Manos recibiendo un chorro de agua limpia.",
    position: "object-[72%_center]",
    widths: [640, 960, 1280, 1600, 2130],
  },
  {
    src: pumping,
    alt: "Estación de bombeo con tuberías blancas y bombas azules sobre una losa de hormigón.",
    position: "object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
  {
    src: aerial,
    alt: "Vista aérea de un complejo industrial costero con una chimenea alta.",
    position: "object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
];
---

<section class="hero relative -mt-(--header-h) bg-plum-950 text-sand-50">
  <div class="hero__frame relative isolate overflow-hidden">
    {photos.map((photo, i) => (
      <div
        class:list={[
          "hero__media absolute inset-0 -z-10 overflow-hidden",
          `hero__media--${i + 1}`,
        ]}
      >
        <Picture
          src={photo.src}
          alt={photo.alt}
          formats={["avif", "webp"]}
          widths={photo.widths}
          sizes="100vw"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "low"}
          class:list={["hero__img h-full w-full object-cover", photo.position]}
          pictureAttributes={{ class: "contents" }}
        />
      </div>
    ))}
    <div
      class="absolute inset-0 -z-10 bg-plum-950/65 md:bg-transparent md:bg-linear-to-r md:from-plum-950/80 md:via-plum-950/55 md:to-plum-950/15"
      aria-hidden="true"
    ></div>
    <div
      class="hero__grid blueprint absolute inset-0 -z-10 text-sand-50 opacity-50"
      aria-hidden="true"
    ></div>
    {/* Brighter copy of the grid, shown only around the mouse (script). */}
    <div class="hero__glow absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="container-site flex min-h-[max(560px,88svh)] flex-col justify-end gap-6 pt-[calc(var(--header-h)+48px)] pb-20 md:min-h-[max(680px,100svh)] md:justify-center md:gap-8 md:pb-24">
      <p class="hero-in eyebrow eyebrow-inverse [--eyebrow-rule:var(--sage-300)]">
        {TAGLINE}
      </p>
      <h1 class="hero-in hero-in--2 text-display max-w-[14ch]">
        Ingeniería civil del{" "}
        <span class="hero__em relative inline-block whitespace-nowrap">
          primer trazo
          <Scribble
            draw="load"
            class="absolute -bottom-[0.14em] left-[-2%] h-[0.3em] w-[104%] text-brick-400"
          />
        </span>{" "}
        a la obra
      </h1>
      <p class="hero-in hero-in--3 text-lead max-w-[46ch] text-sand-100">
        Más de 30 años diseñando agua potable, caminos, estructuras y
        fundaciones para empresas de las regiones de Valparaíso y Coquimbo, con
        un equipo que te acompaña de principio a fin.
      </p>
      <div class="hero-in hero-in--4 flex flex-col gap-3 pt-2 sm:flex-row">
        <ButtonLink href="/contacto">
          Cotizar proyecto
          <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
        </ButtonLink>
        <ButtonLink href="/servicios" variant="on-photo">
          Ver servicios
        </ButtonLink>
      </div>
    </div>

    {/* Photo counter with a drawn progress line (decorative). */}
    <div
      class="hero__counter absolute right-[max(1rem,calc((100vw-1200px)/2+1.5rem))] bottom-8 hidden items-center gap-4 text-[13px] leading-4 font-semibold tracking-[0.14em] text-sand-100 tabular-nums md:flex"
      aria-hidden="true"
    >
      <span class="relative inline-block w-[2ch]">
        <span class="hero__count hero__count--1">01</span>
        <span class="hero__count hero__count--2 absolute inset-0 opacity-0">
          02
        </span>
        <span class="hero__count hero__count--3 absolute inset-0 opacity-0">
          03
        </span>
      </span>
      <span class="relative block h-0.5 w-24 overflow-hidden rounded-full bg-sand-50/25">
        <span class="hero__progress absolute inset-0 origin-left scale-x-[0.3333] rounded-full bg-sand-50"></span>
      </span>
      <span>03</span>
    </div>

    <div
      class="hero__cue absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-[12px] leading-4 font-semibold tracking-[0.18em] text-sand-100 uppercase md:flex"
      aria-hidden="true"
    >
      Desliza
      <span class="hero__cue-line relative block h-12 w-px overflow-hidden bg-sand-50/30"></span>
    </div>
  </div>
</section>

<script>
  import { spotlightEnabled, spotlightPoint } from "../../lib/motion/spotlight";

  const frame = document.querySelector<HTMLElement>(".hero__frame");
  const enabled = spotlightEnabled({
    prefersReducedMotion: matchMedia("(prefers-reduced-motion: reduce)")
      .matches,
    finePointer: matchMedia("(hover: hover) and (pointer: fine)").matches,
  });

  if (frame && enabled) {
    let pointer: { clientX: number; clientY: number } | null = null;
    let queued = false;
    const paint = (): void => {
      queued = false;
      if (!pointer) return;
      const { x, y } = spotlightPoint(frame.getBoundingClientRect(), pointer);
      frame.style.setProperty("--spot-x", x);
      frame.style.setProperty("--spot-y", y);
    };
    const schedule = (): void => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };
    frame.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      pointer = { clientX: event.clientX, clientY: event.clientY };
      frame.dataset["spotlight"] = "";
      schedule();
    });
    frame.addEventListener("pointerleave", () => {
      pointer = null;
      delete frame.dataset["spotlight"];
    });
    // The frame moves under a still mouse while the page scrolls.
    addEventListener("scroll", schedule, { passive: true });
  }
</script>

<style>
  .hero__grid {
    mask-image: radial-gradient(120% 90% at 0% 100%, white 0%, transparent 70%);
  }

  /*
   * Spotlight: the same 24px dot / 96px line grid, brighter and with a soft
   * halo per dot, masked to a circle around the pointer (--spot-x/--spot-y,
   * set by the script below on mouse devices). Hidden until the pointer is
   * over the hero.
   */
  .hero__glow {
    background-image:
      radial-gradient(
        circle at 12px 12px,
        var(--sand-50) 1.4px,
        transparent 2.2px
      ),
      radial-gradient(
        circle at 12px 12px,
        color-mix(in oklab, var(--sand-50) 45%, transparent) 2px,
        transparent 6px
      ),
      linear-gradient(
        to right,
        color-mix(in oklab, var(--sand-50) 22%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--sand-50) 22%, transparent) 1px,
        transparent 1px
      );
    background-size:
      24px 24px,
      24px 24px,
      96px 96px,
      96px 96px;
    /* Dots drawn at the cell centre (so the halo is not cut by the cell
       edge) and shifted back onto the base grid's dots at (1px, 1px). */
    background-position:
      -11px -11px,
      -11px -11px,
      0 0,
      0 0;
    mask-image: radial-gradient(
      circle 200px at var(--spot-x, -999px) var(--spot-y, -999px),
      white 0%,
      color-mix(in srgb, white 45%, transparent) 45%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
    pointer-events: none;
  }

  .hero__frame[data-spotlight] .hero__glow {
    opacity: 1;
  }

  .hero__cue-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--sand-50);
    transform: translateY(-100%);
  }

  /* Static fallback: only the first photo; no counter. */
  .hero__media--2,
  .hero__media--3,
  .hero__counter {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media--1 {
      animation: wipe-right 1300ms var(--ease-in-out) both;
    }

    .hero__media--1 :global(.hero__img) {
      animation: settle 3200ms var(--ease-out) both;
    }

    .hero__grid {
      animation: fade-in 1400ms ease 700ms both;
    }

    .hero-in {
      animation: rise 900ms var(--ease-out) 250ms both;
    }

    .hero-in--2 {
      animation-delay: 380ms;
    }

    .hero-in--3 {
      animation-delay: 560ms;
    }

    .hero-in--4 {
      animation-delay: 700ms;
    }

    .hero__em :global(svg) {
      --draw-delay: 1150ms;
    }

    .hero__cue {
      animation: fade-in 800ms ease 1600ms both;
    }

    .hero__cue-line::after {
      animation: cue 2400ms var(--ease-in-out) 1800ms infinite;
    }

    /*
     * Scroll track: the section is taller than the viewport and its frame
     * sticks while the page scrolls through it. Progress runs over the
     * `contain` range (from the section's top at the top of the viewport to
     * its bottom at the bottom). `animation-timeline` goes through var()
     * (see motion.css: the minifier would otherwise fold it away).
     */
    @supports (animation-timeline: view()) {
      /*
       * The overlay header stays transparent while the frame is pinned and
       * solidifies once the page really moves: track height minus one
       * viewport, minus the header the section slides under (motion.css).
       */
      :global(body:has(.hero__frame)) {
        --header-solid-start: calc(260svh - 100svh - var(--header-h));
      }

      .hero {
        --hero-timeline: --hero;
        height: 260svh;
        view-timeline-name: --hero;
      }

      .hero__frame {
        position: sticky;
        top: 0;
        height: 100svh;
      }

      .hero__frame > .container-site {
        min-height: 100%;
      }

      .hero__media--2,
      .hero__media--3 {
        display: block;
        animation: hero-wipe linear both;
        animation-timeline: var(--hero-timeline);
      }

      .hero__media--2 :global(.hero__img),
      .hero__media--3 :global(.hero__img) {
        animation: hero-settle linear both;
        animation-timeline: var(--hero-timeline);
      }

      .hero__media--2,
      .hero__media--2 :global(.hero__img) {
        animation-range: contain 14% contain 40%;
      }

      .hero__media--3,
      .hero__media--3 :global(.hero__img) {
        animation-range: contain 54% contain 80%;
      }

      @media (min-width: 48rem) {
        .hero__counter {
          display: flex;
        }
      }

      .hero__count--1,
      .hero__count--2,
      .hero__count--3,
      .hero__progress,
      .hero__cue {
        animation-timeline: var(--hero-timeline);
        animation-range: contain 0% contain 100%;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .hero__count--1 {
        animation-name: hero-count-1;
      }

      .hero__count--2 {
        animation-name: hero-count-2;
      }

      .hero__count--3 {
        animation-name: hero-count-3;
      }

      .hero__progress {
        animation-name: hero-progress;
      }

      /* The scroll cue fades out once the photos start changing. */
      .hero__cue {
        animation-name: hero-cue-out;
        animation-delay: 0ms;
      }

      .hero__cue-line::after {
        animation: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line::after {
      transform: none;
    }
  }

  @keyframes hero-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes hero-count-1 {
    0%,
    26% {
      opacity: 1;
    }
    30%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-count-2 {
    0%,
    26% {
      opacity: 0;
    }
    30%,
    66% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-count-3 {
    0%,
    66% {
      opacity: 0;
    }
    70%,
    100% {
      opacity: 1;
    }
  }

  /*
   * Animates `scale` (not `transform`): the bar's resting width comes from
   * Tailwind's `scale-x-*`, which sets the `scale` property, and a transform
   * keyframe would multiply with it (the bar stopped at a third).
   */
  @keyframes hero-progress {
    0%,
    14% {
      scale: 0.3333 1;
    }
    40%,
    54% {
      scale: 0.6667 1;
    }
    80%,
    100% {
      scale: 1 1;
    }
  }

  @keyframes hero-cue-out {
    0%,
    6% {
      opacity: 1;
    }
    14%,
    100% {
      opacity: 0;
    }
  }
</style>
