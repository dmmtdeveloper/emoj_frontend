---
/**
 * Home hero, "del croquis a la obra". Three real photos from the original
 * emoj.cl hero (water, a pumping station and an aerial industrial view).
 *
 * The photos play on their own (src/scripts/hero-slideshow.ts): each one
 * zooms in slowly and the next enters with a left-to-right wipe, like a
 * stroke being drawn. A counter with a progress line shows the current
 * photo, and a button pauses the change (WCAG 2.2.2). The slideshow holds
 * while the hero is off screen or the tab is hidden.
 *
 * Without JavaScript or with reduced motion the hero shows the first photo
 * only (no autoplay, no counter). The section slides under the transparent
 * header (BaseLayout `headerOverlay`).
 */
import { ArrowRight, Pause, Play } from "@lucide/astro";
import { Picture } from "astro:assets";
import water from "../../assets/photos/agua-manos.jpg";
import pumping from "../../assets/photos/estacion-bombeo-tuberias.jpg";
import aerial from "../../assets/photos/vista-aerea-industrial.jpg";
import { TAGLINE } from "../../lib/site";
import ButtonLink from "../ui/ButtonLink.astro";
import Scribble from "../ui/Scribble.astro";

const photos = [
  {
    src: water,
    alt: "Manos recibiendo un chorro de agua limpia.",
    position: "object-[72%_center]",
    widths: [640, 960, 1280, 1600, 2130],
  },
  {
    src: pumping,
    alt: "Estación de bombeo con tuberías blancas y bombas azules sobre una losa de hormigón.",
    position: "object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
  {
    src: aerial,
    alt: "Vista aérea de un complejo industrial costero con una chimenea alta.",
    position: "object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
];
---

<section class="hero relative -mt-(--header-h) bg-plum-950 text-sand-50">
  <div class="hero__frame relative isolate overflow-hidden" data-hero>
    {photos.map((photo, i) => (
      <div
        class:list={[
          "hero__media absolute inset-0 -z-10 overflow-hidden",
          `hero__media--${i + 1}`,
        ]}
        data-hero-slide
        data-state={i === 0 ? "active" : undefined}
      >
        <Picture
          src={photo.src}
          alt={photo.alt}
          formats={["avif", "webp"]}
          widths={photo.widths}
          sizes="100vw"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "low"}
          class:list={["hero__img h-full w-full object-cover", photo.position]}
          pictureAttributes={{ class: "contents" }}
        />
      </div>
    ))}
    <div
      class="absolute inset-0 -z-10 bg-plum-950/65 md:bg-transparent md:bg-linear-to-r md:from-plum-950/80 md:via-plum-950/55 md:to-plum-950/15"
      aria-hidden="true"
    ></div>
    <div
      class="hero__grid blueprint absolute inset-0 -z-10 text-sand-50 opacity-50"
      aria-hidden="true"
    ></div>
    {/* Interactive 3D dot grid (src/scripts/dot-grid.ts), mouse only. */}
    <canvas
      class="hero__dots absolute inset-0 -z-10 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <div class="container-site flex min-h-[max(560px,88svh)] flex-col justify-end gap-6 pt-[calc(var(--header-h)+48px)] pb-20 md:min-h-[max(680px,100svh)] md:justify-center md:gap-8 md:pb-24">
      <p class="hero-in eyebrow eyebrow-inverse [--eyebrow-rule:var(--sage-300)]">
        {TAGLINE}
      </p>
      <h1 class="hero-in hero-in--2 text-display max-w-[14ch]">
        Ingeniería civil del{" "}
        <span class="hero__em relative inline-block whitespace-nowrap">
          primer trazo
          <Scribble
            draw="load"
            class="absolute -bottom-[0.14em] left-[-2%] h-[0.3em] w-[104%] text-brick-400"
          />
        </span>{" "}
        a la obra
      </h1>
      <p class="hero-in hero-in--3 text-lead max-w-[46ch] text-sand-100">
        Más de 30 años diseñando agua potable, caminos, estructuras y
        fundaciones para empresas de las regiones de Valparaíso y Coquimbo, con
        un equipo que te acompaña de principio a fin.
      </p>
      <div class="hero-in hero-in--4 flex flex-col gap-3 pt-2 sm:flex-row">
        <ButtonLink href="/contacto">
          Cotizar proyecto
          <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
        </ButtonLink>
        <ButtonLink href="/servicios" variant="on-photo">
          Ver servicios
        </ButtonLink>
      </div>
    </div>

    {/* Photo counter with a progress line, and the pause button. */}
    <div class="hero__counter absolute right-[max(1rem,calc((100vw-1200px)/2+1.5rem))] bottom-6 items-center gap-4 text-[13px] leading-4 font-medium tracking-[0.14em] text-sand-100 tabular-nums md:bottom-8">
      <span class="flex items-center gap-4" aria-hidden="true">
        <span class="w-[2ch]" data-hero-count>
          01
        </span>
        <span class="relative block h-0.5 w-16 overflow-hidden rounded-full bg-sand-50/25 md:w-24">
          <span
            class="hero__progress absolute inset-0 origin-left rounded-full bg-sand-50"
            data-hero-progress
          ></span>
        </span>
        <span>{String(photos.length).padStart(2, "0")}</span>
      </span>
      <button
        type="button"
        class="hero__toggle grid size-9 place-items-center rounded-full border border-sand-50/40 text-sand-50 transition-colors hover:bg-sand-50/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand-50"
        aria-label="Pausar el cambio de fotos"
        data-hero-toggle
      >
        <Pause
          class="hero__icon-pause"
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
        <Play
          class="hero__icon-play"
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
      </button>
    </div>

    <div
      class="hero__cue absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-[12px] leading-4 font-medium tracking-[0.18em] text-sand-100 uppercase md:flex"
      aria-hidden="true"
    >
      Desliza
      <span class="hero__cue-line relative block h-12 w-px overflow-hidden bg-sand-50/30"></span>
    </div>
  </div>
</section>

<script>
  import "../../scripts/dot-grid";
  import "../../scripts/hero-slideshow";
</script>

<style>
  .hero__grid {
    mask-image: radial-gradient(120% 90% at 0% 100%, white 0%, transparent 70%);
  }

  /* The canvas grid replaces the CSS one once the script runs. */
  .hero__dots {
    display: none;
  }

  .hero__frame[data-dot-grid] .hero__dots {
    display: block;
  }

  .hero__frame[data-dot-grid] .hero__grid {
    display: none;
  }

  .hero__cue-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--sand-50);
    transform: translateY(-100%);
  }

  /* Static fallback: only the first photo; no counter. */
  .hero__media--2,
  .hero__media--3,
  .hero__counter {
    display: none;
  }

  /*
   * Slideshow, armed by src/scripts/hero-slideshow.ts (never with reduced
   * motion). `data-state` on each photo: "active" is on top and wipes in,
   * "prev" stays visible underneath until the wipe covers it; the rest are
   * hidden. The slow zoom keeps running from "active" to "prev" (same
   * animation), so the outgoing photo never jumps.
   */
  .hero__frame[data-slideshow] .hero__media {
    display: block;
    visibility: hidden;
  }

  .hero__frame[data-slideshow] .hero__media[data-state] {
    visibility: visible;
  }

  .hero__frame[data-slideshow] .hero__media[data-state="prev"] {
    z-index: -11;
  }

  .hero__frame[data-slideshow] .hero__counter {
    display: flex;
  }

  .hero__icon-play,
  .hero__frame[data-paused] .hero__icon-pause {
    display: none;
  }

  .hero__frame[data-paused] .hero__icon-play {
    display: block;
  }

  .hero__media--1 {
    --zoom-origin: 70% 55%;
  }

  .hero__media--2 {
    --zoom-origin: 30% 40%;
  }

  .hero__media--3 {
    --zoom-origin: 55% 65%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media[data-state="active"] {
      animation: wipe-right 1300ms var(--ease-in-out) both;
    }

    .hero__media[data-state] :global(.hero__img) {
      transform-origin: var(--zoom-origin, center);
      animation: hero-zoom var(--hero-zoom-ms, 9000ms) linear both;
    }

    .hero__frame[data-slideshow] .hero__progress[data-run] {
      animation: hero-fill var(--hero-slide-ms, 6500ms) linear both;
    }

    /* Paused by the person or off screen: everything holds still. */
    .hero__frame:is([data-paused], [data-held]) .hero__progress[data-run],
    .hero__frame:is([data-paused], [data-held]) .hero__media[data-state],
    .hero__frame:is([data-paused], [data-held])
      .hero__media[data-state]
      :global(.hero__img) {
      animation-play-state: paused;
    }

    .hero__grid {
      animation: fade-in 1400ms ease 700ms both;
    }

    .hero-in {
      animation: rise 900ms var(--ease-out) 250ms both;
    }

    .hero-in--2 {
      animation-delay: 380ms;
    }

    .hero-in--3 {
      animation-delay: 560ms;
    }

    .hero-in--4 {
      animation-delay: 700ms;
    }

    .hero__em :global(svg) {
      --draw-delay: 1150ms;
    }

    .hero__cue {
      animation: fade-in 800ms ease 1600ms both;
    }

    .hero__cue-line::after {
      animation: cue 2400ms var(--ease-in-out) 1800ms infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line::after {
      transform: none;
    }
  }

  /* A slow push-in, from slightly zoomed so the first frames already move. */
  @keyframes hero-zoom {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.14);
    }
  }

  @keyframes hero-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
