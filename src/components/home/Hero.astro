---
/**
 * Home hero, "del croquis a la obra": the real photo is revealed with a
 * left-to-right wipe (like a stroke being drawn) while it settles from a
 * slight zoom; a plum-950 veil keeps text contrast and a faint blueprint
 * grid sits on top. The headline's key phrase gets a hand-drawn underline.
 * The section slides under the transparent header (BaseLayout
 * `headerOverlay`). Static: no carousel, no autoplay video.
 */
import { ArrowRight } from "@lucide/astro";
import { Picture } from "astro:assets";
import hero from "../../assets/photos/agua-manos.jpg";
import { TAGLINE } from "../../lib/site";
import ButtonLink from "../ui/ButtonLink.astro";
import Scribble from "../ui/Scribble.astro";
---

<section class="hero relative isolate -mt-(--header-h) overflow-hidden bg-plum-950 text-sand-50">
  <div class="hero__media absolute inset-0 -z-10 overflow-hidden">
    <Picture
      src={hero}
      alt="Manos recibiendo un chorro de agua limpia."
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1600, 2130]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img h-full w-full object-cover object-[72%_center]"
      pictureAttributes={{ class: "contents" }}
    />
  </div>
  <div
    class="absolute inset-0 -z-10 bg-plum-950/65 md:bg-transparent md:bg-linear-to-r md:from-plum-950/80 md:via-plum-950/55 md:to-plum-950/15"
    aria-hidden="true"
  ></div>
  <div
    class="hero__grid blueprint absolute inset-0 -z-10 text-sand-50 opacity-50"
    aria-hidden="true"
  ></div>

  <div class="container-site flex min-h-[max(560px,88svh)] flex-col justify-end gap-6 pt-[calc(var(--header-h)+48px)] pb-14 md:min-h-[max(680px,100svh)] md:justify-center md:gap-8 md:pb-24">
    <p class="hero-in eyebrow eyebrow-inverse [--eyebrow-rule:var(--sage-300)]">
      {TAGLINE}
    </p>
    <h1 class="hero-in hero-in--2 text-display max-w-[14ch]">
      Ingeniería civil del{" "}
      <span class="hero__em relative inline-block whitespace-nowrap">
        primer trazo
        <Scribble
          draw="load"
          class="absolute -bottom-[0.14em] left-[-2%] h-[0.3em] w-[104%] text-brick-400"
        />
      </span>{" "}
      a la obra
    </h1>
    <p class="hero-in hero-in--3 text-lead max-w-[46ch] text-sand-100">
      Más de 30 años diseñando agua potable, caminos, estructuras y fundaciones
      para empresas de las regiones de Valparaíso y Coquimbo, con un equipo que
      te acompaña de principio a fin.
    </p>
    <div class="hero-in hero-in--4 flex flex-col gap-3 pt-2 sm:flex-row">
      <ButtonLink href="/contacto">
        Cotizar proyecto
        <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
      </ButtonLink>
      <ButtonLink href="/servicios" variant="on-photo">
        Ver servicios
      </ButtonLink>
    </div>
  </div>

  <div
    class="hero__cue absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-[12px] leading-4 font-semibold tracking-[0.18em] text-sand-100 uppercase md:flex"
    aria-hidden="true"
  >
    Desliza
    <span class="hero__cue-line relative block h-12 w-px overflow-hidden bg-sand-50/30"></span>
  </div>
</section>

<style>
  .hero__grid {
    mask-image: radial-gradient(120% 90% at 0% 100%, white 0%, transparent 70%);
  }

  .hero__cue-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--sand-50);
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media {
      animation: wipe-right 1300ms var(--ease-in-out) both;
    }

    .hero__media :global(.hero__img) {
      animation: settle 3200ms var(--ease-out) both;
    }

    .hero__grid {
      animation: fade-in 1400ms ease 700ms both;
    }

    .hero-in {
      animation: rise 900ms var(--ease-out) 250ms both;
    }

    .hero-in--2 {
      animation-delay: 380ms;
    }

    .hero-in--3 {
      animation-delay: 560ms;
    }

    .hero-in--4 {
      animation-delay: 700ms;
    }

    .hero__em :global(svg) {
      --draw-delay: 1150ms;
    }

    .hero__cue {
      animation: fade-in 800ms ease 1600ms both;
    }

    .hero__cue-line::after {
      animation: cue 2400ms var(--ease-in-out) 1800ms infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line::after {
      transform: none;
    }
  }
</style>
