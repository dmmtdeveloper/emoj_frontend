---
/**
 * Home hero: 30 years of consulting, water supply and sanitation, and the
 * experience, technology and quality behind each project. Three real photos
 * from the original emoj.cl hero (water, a pumping station and an aerial industrial view)
 * under light plum veils (the photos lead, with a calmer headline up to
 * 72px) and a faint four-column grid, like a drawing sheet. Each photo has
 * its own crop on phones.
 *
 * The hero carries no data strip: the figures live in the facts band
 * (FactsBand), next to the client logos (ClientsStrip `tone="accent"`).
 *
 * The photos play on their own (src/scripts/hero-slideshow.ts): each one
 * zooms in slowly and the next enters with a left-to-right wipe, like a
 * stroke being drawn. A counter with a progress line shows the current
 * photo, and one plain pause icon beside it stops the change (WCAG 2.2.2).
 * The slideshow holds while the hero is off screen or the tab is hidden.
 *
 * Without JavaScript or with reduced motion the hero shows the first photo
 * only (no autoplay, no counter). The section slides under the transparent
 * header (BaseLayout `headerOverlay`).
 */
import { ArrowRight, Pause, Play } from "@lucide/astro";
import { Picture } from "astro:assets";
import water from "../../assets/photos/agua-manos.jpg";
import pumping from "../../assets/photos/estacion-bombeo-tuberias.jpg";
import aerial from "../../assets/photos/vista-aerea-industrial.jpg";
import { TAGLINE } from "../../lib/site";
import ButtonLink from "../ui/ButtonLink.astro";

const photos = [
  {
    src: water,
    alt: "Manos recibiendo un chorro de agua limpia.",
    position: "object-[60%_center] md:object-[58%_center]",
    widths: [640, 960, 1280, 1600, 2130],
  },
  {
    src: pumping,
    alt: "Estación de bombeo con tuberías blancas y bombas azules sobre una losa de hormigón.",
    position: "object-[48%_center] md:object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
  {
    src: aerial,
    alt: "Vista aérea de un complejo industrial costero con una chimenea alta.",
    position: "object-[38%_center] md:object-center",
    widths: [640, 960, 1280, 1600, 2000],
  },
];
---

<section class="hero relative -mt-(--header-h) bg-plum-950 text-sand-50">
  <div class="hero__frame relative isolate overflow-hidden" data-hero>
    {/* Photos, drifting slower than the page on desktop (motion.css). */}
    <div class="hero__parallax absolute inset-0 -z-10">
      {photos.map((photo, i) => (
        <div
          class:list={[
            "hero__media absolute inset-0 -z-10 overflow-hidden",
            `hero__media--${i + 1}`,
          ]}
          data-hero-slide
          data-state={i === 0 ? "active" : undefined}
        >
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={["avif", "webp"]}
            widths={photo.widths}
            sizes="100vw"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "low"}
            class:list={[
              "hero__img h-full w-full object-cover",
              photo.position,
            ]}
            pictureAttributes={{ class: "contents" }}
          />
        </div>
      ))}
    </div>
    {/*
      Veils kept light so the photos lead. Phones: a fade from the foot,
      where the text sits. Wider screens: a faint wash, a fade behind the
      text on the left and one at the foot, under the photo counter.
    */}
    <div
      class="absolute inset-0 -z-10 bg-linear-to-t from-plum-950/90 via-plum-950/45 via-55% to-plum-950/25 md:bg-plum-950/20 md:bg-none"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 -z-10 hidden bg-linear-to-r from-plum-950/80 via-plum-950/40 via-40% to-transparent to-70% md:block"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 -z-10 hidden bg-linear-to-t from-plum-950/70 to-transparent to-35% md:block"
      aria-hidden="true"
    ></div>
    {/* Drawing-sheet grid: four columns, hairlines only. */}
    <div
      class="pointer-events-none absolute inset-0 -z-10 hidden md:block"
      aria-hidden="true"
    >
      <div class="container-site h-full">
        <div class="grid h-full grid-cols-4 border-r border-sand-50/[0.07]">
          <span class="border-l border-sand-50/[0.07]"></span>
          <span class="border-l border-sand-50/[0.07]"></span>
          <span class="border-l border-sand-50/[0.07]"></span>
          <span class="border-l border-sand-50/[0.07]"></span>
        </div>
      </div>
    </div>

    <div class="flex min-h-[max(640px,100svh)] flex-col">
      <div class="hero__content container-site flex flex-1 flex-col justify-end gap-6 pt-[calc(var(--header-h)+48px)] pb-10 md:justify-center md:gap-7 md:pb-12">
        <p class="hero-in font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sand-300 uppercase">
          {TAGLINE}
        </p>
        <h1 class="hero-in hero-in--2 max-w-[15ch] text-[clamp(2.5rem,1.5rem+3.2vw,4.5rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance">
          Más de 30&nbsp;años{" "}
          <em class="font-medium text-sage-300">innovando</em> en consultoría
        </h1>
        <p class="hero-in hero-in--3 text-lead max-w-[46ch] text-sand-100">
          Diseñamos soluciones eficientes para el abastecimiento y saneamiento
          de agua, con la experiencia, la tecnología y la calidad que exige cada
          proyecto de ingeniería civil.
        </p>
        <div class="hero-in hero-in--4 flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:gap-7">
          <ButtonLink
            href="/contacto"
            variant="on-photo-solid"
            class="min-h-12 px-6 text-base"
          >
            Cotizar proyecto
          </ButtonLink>
          <a
            href="/proyectos"
            class="group inline-flex min-h-12 items-center gap-2 self-start text-base font-semibold text-sand-50 no-underline hover:text-sand-50 sm:self-auto"
          >
            Ver proyectos
            <ArrowRight
              size={20}
              stroke-width={1.75}
              aria-hidden="true"
              class="transition-transform duration-300 ease-(--ease-out) group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>

      <div class="container-site">
        {/*
          Photo counter and one quiet pause control (WCAG 2.2.2), both
          shown only while the slideshow runs. Left-aligned on phones so the
          WhatsApp button (bottom right) never covers the pause control.
        */}
        <div class="hero__counter items-center justify-start gap-3 pb-6 md:justify-end md:pb-8 text-[13px] leading-4 font-medium tracking-[0.14em] text-sand-100 tabular-nums">
          <span
            class="hero__count items-center gap-4 font-data"
            aria-hidden="true"
          >
            <span class="w-[2ch]" data-hero-count>
              01
            </span>
            <span class="relative block h-0.5 w-16 overflow-hidden rounded-full bg-sand-50/25 md:w-24">
              <span
                class="hero__progress absolute inset-0 origin-left rounded-full bg-sand-50"
                data-hero-progress
              ></span>
            </span>
            <span>{String(photos.length).padStart(2, "0")}</span>
          </span>
          <label class="-mr-2 inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-sand-200 transition-colors hover:text-sand-50 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-sand-50">
            <input
              type="checkbox"
              class="hero__pause peer sr-only"
              data-hero-toggle
            />
            <Pause
              size={16}
              stroke-width={2}
              aria-hidden="true"
              class="peer-checked:hidden"
            />
            <Play
              size={16}
              stroke-width={2}
              aria-hidden="true"
              class="hidden peer-checked:block"
            />
            <span class="sr-only">Pausar el cambio de fotos</span>
          </label>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/hero-slideshow";
</script>

<style>
  /* Static fallback: only the first photo; no counter, no pause. */
  .hero__media--2,
  .hero__media--3,
  .hero__counter {
    display: none;
  }

  /*
   * Slideshow, armed by src/scripts/hero-slideshow.ts (never with reduced
   * motion). `data-state` on each photo: "active" is on top and wipes in,
   * "prev" stays visible underneath until the wipe covers it; the rest are
   * hidden. The slow zoom keeps running from "active" to "prev" (same
   * animation), so the outgoing photo never jumps.
   */
  .hero__frame[data-slideshow] .hero__media {
    display: block;
    visibility: hidden;
  }

  .hero__frame[data-slideshow] .hero__media[data-state] {
    visibility: visible;
  }

  .hero__frame[data-slideshow] .hero__media[data-state="prev"] {
    z-index: -11;
  }

  .hero__frame[data-slideshow] :is(.hero__counter, .hero__count) {
    display: flex;
  }

  .hero__media--1 {
    --zoom-origin: 55% 50%;
  }

  .hero__media--2 {
    --zoom-origin: 30% 40%;
  }

  .hero__media--3 {
    --zoom-origin: 55% 65%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media[data-state="active"] {
      animation: wipe-right 1300ms var(--ease-in-out) both;
    }

    .hero__media[data-state] :global(.hero__img) {
      transform-origin: var(--zoom-origin, center);
      animation: hero-zoom var(--hero-zoom-ms, 9000ms) linear both;
    }

    .hero__frame[data-slideshow] .hero__progress[data-run] {
      animation: hero-fill var(--hero-slide-ms, 6500ms) linear both;
    }

    /* Paused by the person or off screen: everything holds still. */
    .hero__frame:is([data-paused], [data-held]) .hero__progress[data-run],
    .hero__frame:is([data-paused], [data-held]) .hero__media[data-state],
    .hero__frame:is([data-paused], [data-held])
      .hero__media[data-state]
      :global(.hero__img) {
      animation-play-state: paused;
    }

    .hero-in {
      animation: rise 900ms var(--ease-out) 250ms both;
    }

    .hero-in--2 {
      animation-delay: 380ms;
    }

    .hero-in--3 {
      animation-delay: 560ms;
    }

    .hero-in--4 {
      animation-delay: 700ms;
    }
  }

  /* A clear push-in (1 → 1.22) across each photo's time on screen. */
  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.22);
    }
  }

  @keyframes hero-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
