            </div>
          </dl>
        </li>
        {STAGES.map((stage, i) => (
          <li class="wf__step" data-wf-step={i}>
            <div class="wf__step-num">{pad(i + 1)}</div>
            <div class="wf__step-body">
              <h3>{stage.title}</h3>
              <p>{stage.text}</p>
              {i === STAGES.length - 1 && (
                <a class="wf__cta" href="/contacto">
