                  <ArrowRight size={16} aria-hidden="true" />
                </a>
              )}
            </div>
            <dl>
              {stage.facts.map(([term, value]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ol>

