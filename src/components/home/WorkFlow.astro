---
/**
 * "Cómo trabajamos": the six stages of an EMOJ project told by the isotype
 * stroke. As the page scrolls, the stroke draws itself like a river from the
 * left dot to the right one, stopping at a station per stage; the panel
 * below shows that stage. When the river is complete, everything else steps
 * back and the official logo stays (stroke, "Emoj Consultora" and tagline).
 *
 * The section is a tall scroll track with a sticky stage; the logic is
 * src/lib/motion/work-flow.ts and the wiring src/scripts/work-flow.ts.
 * It follows the site theme: in light, the brand book's color logo on cream
 * (Auburn stroke, Russian Violet dots and words); in dark, its negative on
 * plum with a sage river. Behind both, the official pattern, very faint.
 *
 * Geometry is the official brand files, never redrawn: the stroke and dots
 * of `isotipo-recorte`, the words of `vertical-recorte` and the tagline of
 * `vertical-tagline-recorte-negativo`, shifted together to this stroke.
 *
 * Without JavaScript, or with reduced motion, the section is a plain list:
 * the finished logo stroke and the six stages one under the other.
 */
import { ArrowRight } from "@lucide/astro";
import { STATIONS } from "../../lib/motion/work-flow";

const STROKE =
  "M704.94,151.52c-68.63,24.41-86.21-35.68-122.4,25.65-33.54,56.83-43.33,109.37-86.06,102.96-84.6-12.69,29.25-202.14-37.01-222.01-92.89-27.87-156.27,247.23-255.95,220.47-82.92-22.26,40.5-246.03,82.15-209.9,31.04,26.93-59.38,100.11-137.89,122.95";

/** Station centres on STROKE, at the STATIONS shares from the left dot. */
const STATION_POINTS = [
  [186, 177.13],
  [203.58, 278.61],
  [346.6, 148.51],
  [442.21, 56.31],
  [477.42, 272.03],
  [671.45, 157.7],
] as const;

/**
 * Where each stage name sits around its station: a direction (x, y in -1..1)
 * and the text anchor. Chosen by measuring each label box against the stroke
 * so no name crosses it.
 */
const LABEL_PLACES = [
  { dx: -0.75, dy: -0.75, anchor: "end" },
  { dx: -0.75, dy: 0.75, anchor: "end" },
  { dx: 0.75, dy: 0.75, anchor: "start" },
  { dx: -0.75, dy: -0.75, anchor: "end" },
  { dx: -0.75, dy: 0.75, anchor: "end" },
  { dx: 0, dy: 1, anchor: "middle" },
] as const;

const STAGES = [
  {
    title: "Conversamos",
    text: "Escuchamos qué necesitas, revisamos tus antecedentes y definimos contigo el alcance, los plazos y los entregables.",
    facts: [
      ["Entregamos", "Propuesta técnica y económica"],
      ["Contigo", "Un coordinador desde el día uno"],
    ],
  },
  {
    title: "Vamos a terreno",
    text: "Visitamos el lugar, levantamos la topografía y tomamos las muestras de suelo que el diseño va a necesitar.",
    facts: [
      ["En terreno", "Topografía · calicatas · catastro"],
      ["Resultado", "Datos reales, no supuestos"],
    ],
  },
  {
    title: "Estudiamos",
    text: "Hacemos los estudios base de hidráulica, tránsito y mecánica de suelos para diseñar sobre lo que el terreno nos dice.",
    facts: [
      ["Estudios", "Hidráulico · tránsito · geotecnia"],
      ["Entregamos", "Informes y recomendaciones"],
    ],
  },
  {
    title: "Diseñamos",
    text: "Ingenieros y proyectistas desarrollan el proyecto completo, con cada especialidad coordinada desde el primer plano.",
    facts: [
      ["Entregamos", "Planos · memorias de cálculo · presupuesto"],
      ["Normativa", "NCh 691 · NCh 1105 · NCh 433"],
    ],
  },
  {
    title: "Aprobamos",
    text: "Ingresamos el proyecto a los organismos que corresponda y respondemos sus observaciones hasta que queda aprobado.",
    facts: [
      ["Ante", "SERVIU · MOP · DOH · sanitarias · DOM"],
      ["Resultado", "Proyecto listo para licitar"],
    ],
  },
  {
    title: "Acompañamos la obra",
    text: "Asesoramos durante la construcción para que lo que se construye sea lo que se diseñó.",
    facts: [
      ["En obra", "Asesoría técnica e inspección"],
      ["Ya son obra", "ESVAL · Aguas del Valle · SAAM"],
    ],
  },
] as const;

const pad = (n: number) => String(n).padStart(2, "0");
if (
  STAGES.length !== STATIONS.length ||
  STATION_POINTS.length !== STATIONS.length
) {
  throw new Error(
    "WorkFlow: one stage and one station point per STATIONS entry",
  );
}
