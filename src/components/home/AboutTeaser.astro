---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import pumping from "../../assets/photos/estacion-bombeo-tuberias.jpg";
import { MISSION } from "../../lib/site";
import StrokeLine from "../ui/StrokeLine.astro";
---

<section
  aria-labelledby="quienes-somos"
  class="relative overflow-hidden bg-surface"
>
  <StrokeLine class="absolute top-10 -left-40 hidden w-[560px] text-border-strong opacity-40 lg:block" />
  <div class="relative mx-auto grid max-w-[1200px] gap-12 px-4 py-16 md:py-24 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div class="flex flex-col gap-6 lg:order-2">
      <p class="text-[13px] leading-4 font-semibold tracking-[0.08em] text-ink-muted uppercase">
        Quiénes somos
      </p>
      <h2
        id="quienes-somos"
        class="text-[26px] leading-8 font-semibold tracking-[-0.01em] md:text-[34px] md:leading-10"
      >
        Una consultora de ingeniería con base en Quilpué
      </h2>
      <p class="max-w-[60ch]">
        EMOJ Consultora SpA nació en la Región de Valparaíso y lleva más de 30
        años proyectando obras sanitarias, viales y estructurales en las
        regiones de Valparaíso y Coquimbo.
      </p>
      <blockquote class="border-l-2 border-brand pl-6 text-ink-muted">
        <p class="max-w-[60ch]">
          <span class="font-semibold text-ink">Nuestra misión:</span>{" "}
          {MISSION.charAt(0).toLowerCase() + MISSION.slice(1)}
        </p>
      </blockquote>
      <a
        href="/nosotros"
        class="inline-flex min-h-11 items-center gap-2 self-start font-semibold underline-offset-4 hover:underline"
      >
        Conoce más sobre nosotros
        <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
      </a>
    </div>
    <Image
      src={pumping}
      alt="Estación de bombeo con tuberías blancas y bombas azules sobre una losa de hormigón."
      widths={[480, 800, 1200]}
      sizes="(min-width: 1200px) 560px, (min-width: 1024px) 46vw, 100vw"
      loading="lazy"
      class="aspect-[4/3] w-full rounded-lg object-cover lg:order-1"
    />
  </div>
</section>
