---
/**
 * Key facts on `surface-inverse` (first of the two inverse sections allowed
 * per page; the footer is the second). Only verifiable facts.
 * The numbers count up when they scroll into view (src/scripts/motion.ts):
 * the HTML holds the final value, the animated copy is hidden from AT and a
 * static copy is read instead. Reduced motion shows the final values.
 */
import { CLIENTS } from "../../lib/site";
import StrokeLine from "../ui/StrokeLine.astro";

const clients = `${CLIENTS.slice(0, -1).join(", ")} y ${CLIENTS.at(-1)}`;

const FACTS = [
  { value: "30+", label: "años de experiencia en ingeniería civil" },
  { value: "7", label: "especialidades coordinadas por un mismo equipo" },
  { value: "2", label: "regiones: Valparaíso y Coquimbo" },
  { value: String(CLIENTS.length), label: "clientes de referencia" },
] as const;
---

<section
  aria-labelledby="cifras"
  class="relative isolate z-[3] overflow-clip bg-surface-inverse text-ink-inverse"
>
  <StrokeLine
    draw="view-back"
    class="absolute -right-24 -bottom-10 -z-10 w-[640px] opacity-25 md:w-[900px]"
  />
  <div class="container-site flex flex-col gap-12 py-16 md:gap-16 md:py-28 lg:py-32">
    <h2 id="cifras" class="eyebrow eyebrow-inverse" data-reveal>
      EMOJ en cifras
    </h2>
    <dl
      class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4 lg:gap-x-8"
      data-reveal-stagger
    >
      {FACTS.map(({ value, label }) => (
        <div class="flex flex-col gap-3 border-l border-ink-inverse/30 pl-4 md:pl-6">
          <dt class="order-2 max-w-[22ch] text-base leading-6 md:text-[17px]">
            {label}
          </dt>
          <dd class="order-1 text-[clamp(3rem,2rem+5vw,6rem)] leading-[0.95] font-semibold tracking-[-0.04em] tabular-nums">
            <span aria-hidden="true" data-count>
              {value}
            </span>
            <span class="sr-only">{value}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p
      class="max-w-[65ch] text-sm leading-5 font-medium opacity-90"
      data-reveal
    >
      Clientes de referencia: {clients}.
    </p>
  </div>
</section>
