---
/**
 * Key facts as a full-bleed sage band (`accent`, plum text: 9.35:1, the
 * same in both themes): the years of experience as one huge figure and the
 * other facts beside it, all in the data typeface (`font-data`). A thin,
 * faint isotype stroke runs behind. Only verifiable facts.
 *
 * The numbers count up when they scroll into view (src/scripts/motion.ts):
 * the HTML holds the final value, the animated copy is hidden from AT and a
 * static copy is read instead. Reduced motion shows the final values.
 *
 * At its foot, the reference clients as a moving band of logos
 * (ClientsStrip `tone="accent"`), right under the client count.
 */
import { CLIENTS } from "../../lib/site";
import IsotipoMark from "../IsotipoMark.astro";
import ClientsStrip from "./ClientsStrip.astro";

const LEAD = { value: "30+", label: "años de experiencia en ingeniería civil" };

const FACTS = [
  { value: "7", label: "especialidades coordinadas por un mismo equipo" },
  { value: "2", label: "regiones: Valparaíso y Coquimbo" },
  { value: String(CLIENTS.length), label: "clientes de referencia" },
] as const;
---

<section
  aria-labelledby="cifras"
  class="relative isolate z-[3] overflow-clip bg-accent text-on-accent"
>
  <IsotipoMark
    tone="mono"
    weight="fine"
    class="facts-mark pointer-events-none absolute -bottom-24 -left-10 -z-10 h-auto w-[140%] max-w-none opacity-15 md:w-[110%]"
  />
  <div class="container-site flex flex-col gap-10 pt-16 pb-10 md:gap-14 md:pt-28 md:pb-14 lg:pt-32 lg:pb-16">
    <h2
      id="cifras"
      class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] uppercase"
      data-reveal
    >
      EMOJ en cifras
    </h2>
    <dl class="grid lg:grid-cols-2 lg:gap-x-16" data-reveal-stagger>
      <div class="flex flex-col justify-end gap-3 pb-10 lg:row-span-3 lg:pb-0">
        <dt class="order-2 max-w-[24ch] text-xl leading-7 font-medium md:text-2xl md:leading-8">
          {LEAD.label}
        </dt>
        <dd class="order-1 font-data text-[clamp(7rem,4rem+14vw,18rem)] leading-[0.8] font-semibold tracking-[-0.07em] tabular-nums">
          <span aria-hidden="true" data-count>
            {LEAD.value}
          </span>
          <span class="sr-only">{LEAD.value}</span>
        </dd>
      </div>
      {FACTS.map(({ value, label }) => (
        <div class="flex items-baseline gap-6 border-t-2 border-plum-950 py-5 md:gap-8 md:py-6 lg:col-start-2">
          <dt class="order-2 text-base leading-6 font-medium md:text-[17px]">
            {label}
          </dt>
          <dd class="order-1 w-[2.2ch] shrink-0 font-data text-[clamp(3.5rem,2.5rem+3.5vw,6rem)] leading-[0.9] font-semibold tracking-[-0.05em] tabular-nums">
            <span aria-hidden="true" data-count>
              {value}
            </span>
            <span class="sr-only">{value}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <ClientsStrip tone="accent" />
</section>

<style>
  /* A thin pen line, not the logo's weight. */
  .facts-mark :global(path) {
    stroke-width: 3.5;
  }
</style>
