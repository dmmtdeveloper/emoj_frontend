---
/**
 * Home: the published projects (featured first, src/lib/content/
 * rail-projects.ts) as a horizontal rail of tall photo cards on a dark
 * section ("Ya son obra."), showing whole cards within the page container. The rail scrolls natively
 * (scroll-snap, touch, trackpad); src/scripts/project-rail.ts adds the
 * arrows, the "01 / 07" counter and the progress line. The parent renders
 * this section only when there is at least one featured project.
 *
 * Each card is one link. The photo of the card being opened morphs into the
 * cover of the project page (motion.css `.vt-project`, named on navigation
 * by src/scripts/project-transition.ts); it carries its own rounding so the
 * snapshot keeps the card's corners.
 * The section is plum in both themes; text and controls are cream and the
 * accents sage (brand on plum is a forbidden pair).
 */
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ProjectSummary } from "../../lib/api/client";
import { fitWidth } from "../../lib/content/format";
import { mediaPath } from "../../lib/content/media";
import { projectTransitionName } from "../../lib/content/transition";
import ButtonLink from "../ui/ButtonLink.astro";

interface Props {
  projects: ProjectSummary[];
  serviceTitles: Record<string, string>;
}

const { projects, serviceTitles } = Astro.props;
const total = String(projects.length).padStart(2, "0");
const facts = (project: ProjectSummary) =>
  [project.location || project.region, project.year]
    .filter(Boolean)
    .join(" · ");
const firstService = (project: ProjectSummary) => {
  const slug = project.services[0];
  return slug ? (serviceTitles[slug] ?? slug) : null;
};
const round =
  "inline-flex size-12 items-center justify-center rounded-full transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand-50 disabled:cursor-default disabled:opacity-40 md:size-14";
---

<section
  aria-labelledby="proyectos-destacados"
  class="overflow-clip bg-plum-950 text-sand-50"
  data-rail
>
  <div class="flex flex-col gap-10 py-16 md:gap-12 md:py-28 lg:py-32">
    <div
      class="container-site flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
      data-reveal
    >
      <div class="flex flex-col gap-4">
        <p class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sage-300 uppercase">
          Proyectos · <span data-rail-count>01</span> / {total}
        </p>
        <h2
          id="proyectos-destacados"
          class="text-[clamp(2.25rem,1.6rem+2.6vw,4rem)] leading-[0.98] font-semibold tracking-[-0.05em]"
        >
          Ya son <em class="font-medium text-sage-300">obra</em>.
        </h2>
      </div>
      <div class="flex items-center gap-3">
        <ButtonLink
          href="/proyectos"
          variant="on-photo"
          pill
          class="min-h-12 px-6 text-base md:min-h-14"
        >
          Ver todos
        </ButtonLink>
        <div class="rail-controls items-center gap-3">
          <button
            type="button"
            class:list={[
              round,
              "border border-sand-50/30 text-sand-100 hover:border-sand-50/60 hover:text-sand-50",
            ]}
            aria-label="Proyecto anterior"
            data-rail-prev
          >
            <ArrowLeft size={22} stroke-width={2} aria-hidden="true" />
          </button>
          <button
            type="button"
            class:list={[round, "bg-sage-300 text-plum-950 hover:bg-sage-200"]}
            aria-label="Proyecto siguiente"
            data-rail-next
          >
            <ArrowRight size={22} stroke-width={2} aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>

    <div class="container-site">
      <ul
        class="rail -mx-2 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain p-2 md:gap-5"
        data-rail-list
      >
        {projects.map((project) => (
          <li class="shrink-0 basis-[85%] snap-start sm:basis-[calc((100%-1rem)/2)] md:basis-[calc((100%-1.25rem)/2)] lg:basis-[calc((100%-2.5rem)/3)]">
            <a
              href={`/proyectos/${project.slug}`}
              class="group relative isolate flex aspect-[3/4] flex-col justify-end overflow-hidden rounded-lg bg-plum-900 p-6 text-sand-50 no-underline hover:text-sand-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sand-50 md:p-7"
            >
              {project.cover && (
                <Image
                  src={mediaPath("proyectos", project.slug, project.cover)}
                  alt=""
                  {...fitWidth(project.cover, 880)}
                  widths={[320, 480, 640, 880]}
                  sizes="(min-width: 1200px) 380px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 85vw"
                  loading="lazy"
                  data-vt={projectTransitionName(project.slug)}
                  class="vt-project absolute inset-0 -z-20 h-full w-full rounded-lg object-cover transition-[scale] duration-700 ease-(--ease-out) group-hover:scale-[1.04]"
                />
              )}
              <span
                class="absolute inset-0 -z-10 bg-linear-to-b from-plum-950/10 via-plum-950/30 to-plum-950/95"
                aria-hidden="true"
              ></span>
              {firstService(project) && (
                <span class="absolute top-5 left-5 inline-flex min-h-8 items-center rounded-full border border-sand-50/25 bg-plum-950/60 px-3.5 font-data text-[12px] leading-4 font-medium tracking-[0.06em] uppercase backdrop-blur-sm">
                  {firstService(project)}
                </span>
              )}
              <h3 class="text-[24px] leading-[1.15] font-semibold tracking-[-0.02em] text-balance md:text-[28px]">
                {project.title}
              </h3>
              {facts(project) && (
                <p class="mt-2 font-data text-sm leading-5 text-sand-200">
                  {facts(project)}
                </p>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="rail-controls container-site items-center gap-6">
      <div class="h-0.5 flex-1 overflow-hidden rounded-full bg-sand-50/15">
        <div
          class="h-full origin-left scale-x-0 rounded-full bg-sage-300 transition-transform duration-200"
          data-rail-progress
        ></div>
      </div>
      <p
        class="font-data text-[12px] leading-4 font-medium tracking-[0.1em] text-sand-300 uppercase"
        aria-hidden="true"
      >
        Desliza para ver más
      </p>
    </div>
  </div>
</section>

<script>
  import "../../scripts/project-rail";
</script>

<style>
  /*
   * Whole cards only, inside the page container: three on desktop, two on
   * tablets, and on phones one with a peek of the next to invite a swipe.
   * The 8px padding (cancelled by -mx-2) keeps focus rings from clipping.
   */
  .rail {
    scroll-padding-inline: var(--space-2);
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  /* Arrows and progress only once the script runs and there is overflow. */
  .rail-controls {
    display: none;
  }

  [data-rail-ready][data-rail-scrollable] .rail-controls {
    display: flex;
  }
</style>
