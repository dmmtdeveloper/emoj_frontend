---
/**
 * Chapter 02 · Servicios. The specialties as a fanned deck of browser
 * windows, one per specialty: a bar with its address over a photo
 * of a real project of that specialty (or, without one, its technical
 * sketch on a drawing sheet), and at the bottom a plum gradient carrying
 * its icon, title, summary and link. A caption under the deck names it.
 *
 * While the chapter is pinned the deck takes the centre and the scroll
 * shuffles it: the top card is thrown off to the left and the next one
 * comes up (fanPlace()), its sketch drawing itself as it rises. Scrolling
 * back rewinds it. Only the card on top can be reached (`inert`).
 *
 * The cards are real content: without the scenes mark (no JavaScript,
 * reduced motion) the scene reads as a plain list of complete cards.
 */
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getProjects } from "../../../lib/content";
import { coversByService } from "../../../lib/content/service-covers";
import { getServices } from "../../../lib/get-services";
import { spanishNumberWord } from "../../../lib/number-words";
import ServiceIcon from "../../services/ServiceIcon.astro";
import Chapter from "./Chapter.astro";
import Croquis from "./Croquis.astro";

interface Props {
  /** Chapter number in the label ("02"), from the home's chapter order. */
  number: string;
}

const { number: chapterNumber } = Astro.props;
const services = await getServices();
const specialties = spanishNumberWord(services.length, { capitalize: true });
const covers = coversByService(
  services.map((s) => s.data.slug),
  await getProjects(),
);

type Photo =
  { src: ImageMetadata } | { src: string; width: number; height: number };

const photoFor = (service: (typeof services)[number]): Photo | null => {
  const found = covers.get(service.data.slug);
  if (found)
    return {
      src: found.cover.src,
      width: found.cover.width,
      height: found.cover.height,
    };
  return service.data.image ? { src: service.data.image } : null;
};

const pad = (n: number) => String(n).padStart(2, "0");
const items = services.map((service, i) => ({
  service,
  number: pad(i + 1),
  photo: photoFor(service),
}));
const total = pad(services.length);
const widths = [480, 800, 1200, 1600];
const sizes = "(min-width: 1024px) 66vw, 92vw";
---

<Chapter
  id="servicios-titulo"
  number={chapterNumber}
  label="Servicios"
  navSection="/servicios"
  class="ch-services"
>
  <Fragment slot="title">
    {specialties} especialidades. Un solo <em>equipo</em>.
  </Fragment>

  <ol class="svc" slot="scene" data-scene-services>
    {items.map(({ service, number, photo }, i) => (
      <li class="svc-item" data-item>
        <article class="svc-page group" data-card>
          <div class="svc-page__bar" aria-hidden="true">
            <span class="svc-page__dots">
              <i />
              <i />
              <i />
            </span>
            <span class="svc-page__url">
              emoj.cl/servicios/{service.data.slug}
            </span>
          </div>
          <div class="svc-page__view">
            <div class="svc-page__media" aria-hidden="true">
              {photo ? (
                "width" in photo ? (
                  <Image
                    src={photo.src}
                    alt=""
                    width={photo.width}
                    height={photo.height}
                    widths={widths}
                    sizes={sizes}
                    loading={i < 2 ? "eager" : "lazy"}
                    class="svc-page__photo"
                  />
                ) : (
                  <Image
                    src={photo.src}
                    alt=""
                    widths={widths}
                    sizes={sizes}
                    loading={i < 2 ? "eager" : "lazy"}
                    class="svc-page__photo"
                  />
                )
              ) : (
                <div class="svc-page__sheet blueprint" data-sketch>
                  <Croquis slug={service.data.slug} class="svc-page__croquis" />
                </div>
              )}
            </div>
            <div class="svc-page__copy">
              <h3 class="svc-page__title">
                <span class="svc-page__icon">
                  <ServiceIcon name={service.data.icon} />
                </span>
                <a href={`/servicios/${service.data.slug}`}>
                  {service.data.title}
                </a>
              </h3>
              <p class="svc-page__text">{service.data.summary}</p>
              <span class="svc-page__go" aria-hidden="true">
                <ArrowUpRight size={22} stroke-width={2} />
              </span>
            </div>
          </div>
        </article>
        <p class="svc-caption" aria-hidden="true" data-caption>
          <span class="svc-caption__dot"></span>
          <span class="svc-caption__name">{service.data.title}</span>
          <span class="svc-caption__count">
            {number} / {total}
          </span>
        </p>
      </li>
    ))}
  </ol>

  <p class="ch-text">
    <strong>Coordinamos todas las especialidades de tu proyecto,</strong> del
    primer croquis a la obra terminada.
  </p>
  <a href="/servicios" class="ch-more">
    Ver todos los servicios
    <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
  </a>
  <div class="svc-help">
    <p class="svc-help__question">¿No sabes cuál necesitas?</p>
    <a href="/contacto" class="btn-primary">
      Cuéntanos tu proyecto
      <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
    </a>
  </div>
</Chapter>

<script>
  import { fanPlace, fanTurn } from "../../../lib/motion/chapters";
  import {
    eachScene,
    scenesOn,
    scrubbedScene,
  } from "../../../scripts/chapters/scrub";

  /** The stretch of the pinned scroll that shuffles the deck (shares),
   * inside the desktop focus so the deck is at the centre meanwhile. */
  const SHUFFLE_FROM = 0.16;
  const SHUFFLE_TO = 0.84;
  /** Share of each turn the card on top rests, readable. */
  const HOLD = 0.55;

  eachScene("[data-scene-services]", (root, _$, $$) => {
    const items = $$("[data-item]").map((item) => ({
      item,
      card: item.querySelector<HTMLElement>("[data-card]"),
      caption: item.querySelector<HTMLElement>("[data-caption]"),
      sketch: item.querySelector<HTMLElement>("[data-sketch]"),
    }));
    // No tweens of its own: the fan is placed from the timeline's time.
    const timeline = scrubbedScene(root, () => undefined);
    // At rest (no scenes) every card stays complete in a plain list.
    if (!scenesOn()) return;

    const place = (time: number) => {
      const turn = fanTurn(time, items.length, SHUFFLE_FROM, SHUFFLE_TO, HOLD);
      items.forEach(({ item, card, caption, sketch }, i) => {
        const at = fanPlace(i - turn, i % 2 === 0 ? 1 : -1);
        item.style.zIndex = String(at.z);
        if (card) {
          card.style.transform = `translate(${at.x * 100}%, ${at.y * 100}%) rotate(${at.rotate}deg) scale(${at.scale})`;
          card.style.opacity = String(at.opacity);
          card.style.setProperty("--svc-copy", String(at.copy));
        }
        if (caption) caption.style.opacity = String(at.copy);
        sketch?.style.setProperty("--svc-draw", String(at.draw));
        // Only the card on top with its copy fully shown can be reached
        // (and its icon plays its gesture); while the copy fades in or out
        // nothing is, so a faded link is never live.
        const live = at.copy >= 1;
        if (item.inert === live) item.inert = !live;
        card?.toggleAttribute("data-icon-play", live);
      });
    };
    timeline.onUpdate = (self) => place(self.currentTime);
    place(timeline.currentTime);
  });
</script>
