---
/**
 * Chapter 02 · Servicios. The seven specialties, one card at a time: a
 * photo of a real project of that specialty (or, without one, its
 * technical sketch) fills the card, blurred under a plum veil, and the
 * specialty's icon, title, summary and link sit on it. While the chapter
 * is pinned the scroll brings each card in turn: its photo wipes up sharp
 * over the last one (chapter 04's motion language), then blurs as the text
 * settles on it.
 *
 * The cards are real content: without the scenes mark (no JavaScript,
 * reduced motion) the scene reads as a plain list of complete cards, and
 * while it plays only the card on show can be reached (`inert`).
 */
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { contentSource } from "../../../lib/content";
import { mediaPath } from "../../../lib/content/media";
import { coversByService } from "../../../lib/content/service-covers";
import { getServices } from "../../../lib/get-services";
import ServiceIcon from "../../services/ServiceIcon.astro";
import Chapter from "./Chapter.astro";
import Croquis from "./Croquis.astro";

const services = await getServices();
const covers = coversByService(
  services.map((s) => s.data.slug),
  await contentSource().getProjects(),
);

type Photo =
  { src: ImageMetadata } | { src: string; width: number; height: number };

const photoFor = (service: (typeof services)[number]): Photo | null => {
  const found = covers.get(service.data.slug);
  if (found)
    return {
      src: mediaPath("proyectos", found.slug, found.cover),
      width: found.cover.width,
      height: found.cover.height,
    };
  return service.data.image ? { src: service.data.image } : null;
};

const pad = (n: number) => String(n).padStart(2, "0");
const items = services.map((service, i) => ({
  service,
  number: pad(i + 1),
  photo: photoFor(service),
}));
const total = pad(services.length);
const sizes = "(min-width: 1024px) 70vw, 92vw";
---

<Chapter
  id="servicios-titulo"
  number="02"
  label="Servicios"
  navSection="/servicios"
  class="ch-services"
>
  <Fragment slot="title">
    Siete especialidades. Un solo <em>equipo</em>.
  </Fragment>

  <ol class="svc" slot="scene" data-scene-services>
    {items.map(({ service, number, photo }, i) => (
      <li class="svc-item" data-item>
        <article class="svc-card group" data-card>
          <div class="svc-card__shot" aria-hidden="true" data-shot>
            <div class="svc-card__media" data-media>
              {photo ? (
                "width" in photo ? (
                  <Image
                    src={photo.src}
                    alt=""
                    width={photo.width}
                    height={photo.height}
                    widths={[480, 800, 1200]}
                    sizes={sizes}
                    loading={i < 2 ? "eager" : "lazy"}
                    class="svc-card__photo"
                  />
                ) : (
                  <Image
                    src={photo.src}
                    alt=""
                    widths={[480, 800, 1200]}
                    sizes={sizes}
                    loading={i < 2 ? "eager" : "lazy"}
                    class="svc-card__photo"
                  />
                )
              ) : (
                <div class="svc-card__sheet blueprint">
                  <Croquis slug={service.data.slug} class="svc-card__croquis" />
                </div>
              )}
            </div>
            <div class="svc-card__veil" />
          </div>
          <div class="svc-card__top" data-part>
            <span class="svc-card__icon">
              <ServiceIcon name={service.data.icon} />
            </span>
            {i === 0 && (
              <span class="svc-card__badge">Especialidad principal</span>
            )}
            <span class="svc-card__count" aria-hidden="true">
              {number} / {total}
            </span>
          </div>
          <h3 class="svc-card__title" data-part>
            <a href={`/servicios/${service.data.slug}`}>{service.data.title}</a>
          </h3>
          <p class="svc-card__text" data-part>
            {service.data.summary}
          </p>
          <span class="svc-card__go" aria-hidden="true" data-part>
            <ArrowUpRight size={24} stroke-width={2} />
          </span>
        </article>
      </li>
    ))}
  </ol>

  <p class="ch-text">
    <strong>Coordinamos todas las especialidades de tu proyecto,</strong> del
    primer croquis a la obra terminada.
  </p>
  <a href="/servicios" class="ch-more">
    Ver todos los servicios
    <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
  </a>
  <div class="svc-help">
    <p class="svc-help__question">¿No sabes cuál necesitas?</p>
    <a href="/contacto" class="ch-button">
      Cuéntanos tu proyecto
      <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
    </a>
  </div>
</Chapter>

<script>
  import { stagger, utils } from "animejs";
  import { showingAt, stageTimes } from "../../../lib/motion/chapters";
  import {
    eachScene,
    SCENE_LENGTH,
    scenesOn,
    scrubbedScene,
  } from "../../../scripts/chapters/scrub";

  const L = SCENE_LENGTH;
  /** The stretch of the pinned scroll where the specialties change. */
  const SWAPS_FROM = 0.1;
  const SWAPS_TO = 0.86;
  /** Share of a swap's slot spent on the change itself; the rest rests. */
  const CHANGE = 0.6;
  /** The photo hides while it waits: wiped down to its bottom edge. */
  const HIDDEN = "inset(100% 0% 0% 0%)";
  const SHOWN = "inset(0% 0% 0% 0%)";

  eachScene("[data-scene-services]", (root, _$, $$) => {
    const items = $$("[data-item]").map((item) => {
      const media = item.querySelector<HTMLElement>("[data-media]");
      return {
        item,
        media,
        card: item.querySelector<HTMLElement>("[data-card]"),
        shot: item.querySelector<HTMLElement>("[data-shot]"),
        parts: [...item.querySelectorAll<HTMLElement>("[data-part]")],
        photo: media?.querySelector("img") ?? null,
        sketch: media?.querySelector(".croquis") ? media : null,
      };
    });
    const swaps = stageTimes(
      Math.max(0, items.length - 1),
      SWAPS_FROM,
      SWAPS_TO,
    );
    const slot = swaps.length > 1 ? (swaps[1] ?? 0) - (swaps[0] ?? 0) : L;
    const span = slot * CHANGE;

    // At rest (no scenes) every card stays complete: no swaps to play.
    const playing = scenesOn();
    if (playing) {
      items.slice(1).forEach(({ shot, card, parts, sketch }) => {
        if (shot) utils.set(shot, { clipPath: HIDDEN });
        if (card) utils.set(card, { "--svc-blur": 0 });
        utils.set(parts, { opacity: 0, translateY: 16 });
        if (sketch) utils.set(sketch, { "--svc-draw": 0 });
      });
    }

    const timeline = scrubbedScene(
      root,
      (tl) => {
        if (!playing) return;
        swaps.forEach((at, k) => {
          const from = items[k];
          const to = items[k + 1];
          if (!from || !to) return;

          // The text on show steps up and out…
          tl.add(
            from.parts,
            {
              opacity: [1, 0],
              translateY: [0, -16],
              duration: span * 0.3,
              ease: "inQuad",
            },
            at,
          );
          if (from.photo) {
            tl.add(
              from.photo,
              { scale: [1, 1.06], duration: span * 0.6, ease: "inOutCubic" },
              at,
            );
          }
          // …while the next photo wipes up sharp over the last one…
          if (to.shot) {
            tl.add(
              to.shot,
              {
                clipPath: [HIDDEN, SHOWN],
                duration: span * 0.6,
                ease: "inOutCubic",
              },
              at,
            );
          }
          if (to.photo) {
            tl.add(
              to.photo,
              { scale: [1.14, 1], duration: span, ease: "outCubic" },
              at,
            );
          }
          // …(a sketch draws itself on its sheet)…
          if (to.sketch) {
            tl.add(
              to.sketch,
              { "--svc-draw": [0, 1], duration: span, ease: "linear" },
              at + span * 0.1,
            );
          }
          // …then blurs under its veil as the new text settles on it.
          if (to.card) {
            tl.add(
              to.card,
              { "--svc-blur": [0, 1], duration: span * 0.5, ease: "inOutQuad" },
              at + span * 0.5,
            );
          }
          tl.add(
            to.parts,
            {
              opacity: [0, 1],
              translateY: [16, 0],
              duration: span * 0.4,
              delay: stagger(span * 0.06),
              ease: "outQuad",
            },
            at + span * 0.55,
          );
        });
      },
      { focus: false },
    );

    // Only the specialty on show can be reached (the switch falls between
    // the old text leaving and the new one arriving); its icon plays its
    // gesture.
    const marks = swaps.map((at) => at + span * 0.45);
    let showing = -1;
    const show = (time: number) => {
      const now = showingAt(time, marks);
      if (now === showing) return;
      showing = now;
      items.forEach(({ item, card }, i) => {
        item.inert = i !== now;
        card?.toggleAttribute("data-icon-play", i === now);
      });
    };
    if (playing) {
      timeline.onUpdate = (self) => show(self.currentTime);
      show(timeline.currentTime);
    }
  });
</script>
