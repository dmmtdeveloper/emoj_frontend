---
/**
 * Chapter 02 · Servicios. The seven services as a list under the title,
 * and beside it a deck of "pages", one per service: a photo of a real
 * project of that service (or, without one, its technical sketch on a
 * drawing sheet) under a bar with the service's address. While the chapter
 * is pinned the scroll shuffles the deck: the front page is thrown aside
 * and goes to the back, the next service comes forward (its sketch drawing
 * itself) and is named under the deck.
 *
 * The list holds the links; the deck is decorative.
 */
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { contentSource } from "../../../lib/content";
import { mediaPath } from "../../../lib/content/media";
import { coversByService } from "../../../lib/content/service-covers";
import { getServices } from "../../../lib/get-services";
import Chapter from "./Chapter.astro";
import Croquis from "./Croquis.astro";

const services = await getServices();
const covers = coversByService(
  services.map((s) => s.data.slug),
  await contentSource().getProjects(),
);

type Photo =
  { src: ImageMetadata } | { src: string; width: number; height: number };

const photoFor = (service: (typeof services)[number]): Photo | null => {
  const found = covers.get(service.data.slug);
  if (found)
    return {
      src: mediaPath("proyectos", found.slug, found.cover),
      width: found.cover.width,
      height: found.cover.height,
    };
  return service.data.image ? { src: service.data.image } : null;
};

const pad = (n: number) => String(n).padStart(2, "0");
const pages = services.map((service, i) => ({
  service,
  number: pad(i + 1),
  photo: photoFor(service),
}));
const total = pad(services.length);
---

<Chapter
  id="servicios-titulo"
  number="02"
  label="Servicios"
  navSection="/servicios"
  class="ch-services"
>
  <Fragment slot="title">
    Siete especialidades. Un solo <em>equipo</em>.
  </Fragment>

  <div class="svc" slot="scene" aria-hidden="true" data-scene-services>
    <div class="svc-deck">
      {pages.map(({ service, photo }, i) => (
        <div class="svc-page" data-page>
          <div class="svc-page__bar">
            <span class="svc-page__dots">
              <i />
              <i />
              <i />
            </span>
            <span class="svc-page__url">
              emoj.cl/servicios/{service.data.slug}
            </span>
          </div>
          <div class="svc-page__view">
            {photo ? (
              "width" in photo ? (
                <Image
                  src={photo.src}
                  alt=""
                  width={photo.width}
                  height={photo.height}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 40vw, 92vw"
                  loading={i < 2 ? "eager" : "lazy"}
                  class="svc-page__photo"
                />
              ) : (
                <Image
                  src={photo.src}
                  alt=""
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 40vw, 92vw"
                  loading={i < 2 ? "eager" : "lazy"}
                  class="svc-page__photo"
                />
              )
            ) : (
              <div class="svc-page__sheet blueprint">
                <Croquis slug={service.data.slug} class="svc-page__croquis" />
              </div>
            )}
            <span class="svc-page__title">{service.data.title}</span>
          </div>
        </div>
      ))}
    </div>
    <p class="svc-names">
      {pages.map(({ service, number }) => (
        <span class="svc-name" data-name>
          <span class="svc-name__dot" />
          {service.data.title}
          <span class="svc-name__count">
            {number} / {total}
          </span>
        </span>
      ))}
    </p>
  </div>

  <p class="ch-text">
    <strong>Coordinamos todas las especialidades de tu proyecto,</strong> del
    primer croquis a la obra terminada.
  </p>
  <ol class="ch-list ch-list--compact">
    {pages.map(({ service, number }) => (
      <li class="ch-row">
        <a href={`/servicios/${service.data.slug}`} class="ch-row__link">
          <span class="ch-row__num">{number}</span>
          <span class="ch-row__title">{service.data.title}</span>
          <ArrowUpRight size={16} stroke-width={1.75} aria-hidden="true" />
        </a>
      </li>
    ))}
  </ol>
  <a href="/servicios" class="ch-more">
    Ver los servicios
    <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
  </a>
</Chapter>

<script>
  import { utils } from "animejs";
  import { deckSlot } from "../../../lib/motion/chapters";
  import {
    eachScene,
    SCENE_LENGTH,
    scrubbedScene,
    type SceneTimeline,
  } from "../../../scripts/chapters/scrub";

  // Slot 0 is the front of the deck; the rest wait hidden at the back.
  const SLOTS = [
    { x: "0%", y: "0%", rotate: 0, scale: 1, opacity: 1 },
    { x: "6%", y: "-5%", rotate: 4, scale: 0.94, opacity: 1 },
    { x: "-6%", y: "-9%", rotate: -5, scale: 0.88, opacity: 0.85 },
  ];
  const HIDDEN = { x: "0%", y: "-12%", rotate: 0, scale: 0.82, opacity: 0 };
  const slot = (k: number) => SLOTS[k] ?? HIDDEN;

  eachScene("[data-scene-services]", (root, _$, $$) => {
    const pages = $$("[data-page]");
    const names = $$("[data-name]");
    const count = pages.length;
    const L = SCENE_LENGTH;
    const FROM = L * 0.16;
    const STEP = (L * 0.7) / Math.max(1, count - 1);

    const place = (step: number) =>
      pages.forEach((page, i) => {
        const k = deckSlot(i, step, count);
        utils.set(page, { ...slot(k), zIndex: count - k });
      });
    place(0);

    // Each step throws the front page aside and sends it to the back while
    // the others move up one place.
    const shuffle = (tl: SceneTimeline, step: number, at: number) => {
      const span = STEP * 0.8;
      pages.forEach((page, i) => {
        const from = deckSlot(i, step - 1, count);
        const to = deckSlot(i, step, count);
        const leaving = from === 0;
        const target = slot(to);
        tl.add(
          page,
          {
            x: leaving
              ? [
                  { to: "-58%", duration: span * 0.45 },
                  { to: target.x, duration: span * 0.55 },
                ]
              : target.x,
            y: target.y,
            rotate: leaving
              ? [
                  { to: -14, duration: span * 0.45 },
                  { to: target.rotate, duration: span * 0.55 },
                ]
              : target.rotate,
            scale: target.scale,
            opacity: leaving
              ? [
                  { to: 1, duration: span * 0.45 },
                  { to: target.opacity, duration: span * 0.55 },
                ]
              : target.opacity,
            duration: span,
            ease: "inOutQuart",
          },
          at,
        ).add(
          page,
          { zIndex: count - to, duration: 1 },
          at + (leaving ? span * 0.45 : span * 0.2),
        );
        // The page that comes forward draws its sketch, if it has one.
        if (to === 0) {
          tl.add(
            page,
            { "--svc-draw": [0, 1], duration: span * 1.2, ease: "linear" },
            at + span * 0.3,
          );
        }
      });
      tl.add(
        names[step - 1] ?? [],
        { opacity: [1, 0], duration: span * 0.3 },
        at + span * 0.2,
      ).add(
        names[step] ?? [],
        { opacity: [0, 1], duration: span * 0.3 },
        at + span * 0.5,
      );
    };

    scrubbedScene(root, (tl) => {
      for (let step = 1; step < count; step++) {
        shuffle(tl, step, FROM + (step - 1) * STEP);
      }
    });
  });
</script>
