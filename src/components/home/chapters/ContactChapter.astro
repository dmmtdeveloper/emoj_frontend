---
/**
 * Chapter 08 · Contacto, "Te esperamos en terreno". Beside the invitation,
 * a hand-drawn plan of the streets around the office (./office-map.ts):
 * the avenues draw on with the scroll, then the streets and their names,
 * the map pin drops onto the office block with a bounce (its shadow
 * growing on the ground, a ring pulsing out), the address appears next to
 * it with the way there, and the three channels to reach us line up under
 * the map. Name placement and the pin's drop: src/lib/motion/survey.ts.
 *
 * The plan is decorative; the address and the channels are real content
 * (links), kept out of reach (`inert`) only while they are not shown yet.
 * At rest (no JavaScript, reduced motion) everything is in place.
 */
import { ArrowRight, ArrowUpRight, Mail, MapPin, Phone } from "@lucide/astro";
import { CONTACT } from "../../../lib/site";
import { labelAlong } from "../../../lib/motion/survey";
import { whatsappHref } from "../../../lib/whatsapp";
import WhatsAppIcon from "../../ui/WhatsAppIcon.astro";
import Chapter from "./Chapter.astro";
import { OFFICE_MAP, STREETS } from "./office-map";

const f = (n: number) => Math.round(n * 10) / 10;
const streets = STREETS.map((street) => {
  const name = labelAlong(
    street.from,
    street.to,
    street.label.share,
    street.label.offset,
  );
  return {
    ...street,
    d: `M${street.from.x} ${street.from.y}L${street.to.x} ${street.to.y}`,
    transform: `translate(${f(name.x)} ${f(name.y)}) rotate(${f(name.angle)})`,
  };
});
const phone = CONTACT.phones[0];
---

<Chapter
  id="conversemos"
  number="08"
  label="Contacto"
  navSection="/contacto"
  class="ch-contact"
>
  <Fragment slot="title">
    ¿Tienes un proyecto? <em>Conversemos.</em>
  </Fragment>

  <div class="loc" slot="scene" data-scene-contact>
    <div class="loc-map">
      <svg
        class="loc-plan"
        viewBox={OFFICE_MAP.viewBox}
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        {streets.map((street) => (
          <path
            class:list={["loc-street", `loc-street--${street.kind}`]}
            d={street.d}
            data-street={street.kind}
          />
        ))}
        {streets.map((street) => (
          <text
            class:list={[
              "loc-street-name",
              street.label.wide && "loc-street-name--wide",
            ]}
            transform={street.transform}
            text-anchor="middle"
            dominant-baseline="middle"
            data-street-name
          >
            {street.name}
          </text>
        ))}
      </svg>
      <span class="loc-ring" aria-hidden="true" data-ring></span>
      <span class="loc-shadow" aria-hidden="true" data-shadow></span>
      <span class="loc-pin" aria-hidden="true" data-pin>
        <MapPin size={44} stroke-width={1.5} />
      </span>
      <address class="loc-card" data-card>
        <span class="loc-card__place">
          {CONTACT.address.street}, {CONTACT.address.locality}
        </span>
        <a
          href={CONTACT.directionsHref}
          class="loc-card__link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Cómo llegar
          <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
      </address>
    </div>

    <ul class="loc-channels" aria-label="Canales de contacto" data-channels>
      <li>
        <a
          href={whatsappHref()}
          class="loc-channel"
          target="_blank"
          rel="noopener noreferrer"
          data-channel
        >
          <span class="loc-channel__icon loc-channel__icon--whatsapp">
            <WhatsAppIcon size={22} />
          </span>
          <ArrowRight
            class="loc-channel__arrow"
            size={18}
            stroke-width={1.75}
            aria-hidden="true"
          />
          <span class="loc-channel__name">WhatsApp</span>
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
      </li>
      <li>
        <a href={`mailto:${CONTACT.email}`} class="loc-channel" data-channel>
          <span class="loc-channel__icon">
            <Mail size={22} stroke-width={1.75} aria-hidden="true" />
          </span>
          <ArrowRight
            class="loc-channel__arrow"
            size={18}
            stroke-width={1.75}
            aria-hidden="true"
          />
          <span class="loc-channel__name">Correo</span>
        </a>
      </li>
      {phone && (
        <li>
          <a href={phone.href} class="loc-channel" data-channel>
            <span class="loc-channel__icon">
              <Phone size={22} stroke-width={1.75} aria-hidden="true" />
            </span>
            <ArrowRight
              class="loc-channel__arrow"
              size={18}
              stroke-width={1.75}
              aria-hidden="true"
            />
            <span class="loc-channel__name">Teléfono</span>
          </a>
        </li>
      )}
    </ul>
  </div>

  <p class="ch-text">
    <strong>Cuéntanos qué necesitas</strong> y te ayudamos a definir el alcance,
    los plazos y los entregables de tu proyecto.
  </p>
  <div class="ch-actions">
    <a href="/contacto" class="ch-button">
      Cotizar proyecto
      <ArrowRight size={18} stroke-width={1.75} aria-hidden="true" />
    </a>
    <a
      href={whatsappHref()}
      class="ch-more"
      target="_blank"
      rel="noopener noreferrer"
    >
      WhatsApp {CONTACT.whatsapp.display}
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </div>
  <a href={`mailto:${CONTACT.email}`} class="ch-more">
    {CONTACT.email}
  </a>
</Chapter>

<script>
  import { animate, stagger, svg, utils } from "animejs";
  import { pinDrop, pinShadow } from "../../../lib/motion/survey";
  import {
    eachScene,
    SCENE_LENGTH,
    scenesOn,
    scrubbedScene,
  } from "../../../scripts/chapters/scrub";

  const L = SCENE_LENGTH;
  /** When each kind of street starts drawing, and for how long (shares). */
  const STREETS: Record<string, { at: number; each: number; span: number }> = {
    avenue: { at: 0.04, each: 0, span: 0.14 },
    main: { at: 0.08, each: 0, span: 0.14 },
    street: { at: 0.16, each: 0.03, span: 0.1 },
    minor: { at: 0.32, each: 0.03, span: 0.08 },
  };
  /** The pin falls from this high (px) and bounces to these shares. */
  const FALL = 120;
  const BOUNCES = [0.2, 0.06];
  const DROP = [0.44, 0.6] as const;
  const CARD = 0.6;
  const CHANNELS = 0.68;

  eachScene("[data-scene-contact]", (root, $, $$) => {
    const channels = $$<HTMLAnchorElement>("[data-channel]");
    const list = $("[data-channels]");
    const card = $("[data-card]");

    // On hover or focus a channel's icon draws itself and the arrow nudges
    // (CSS). Not with reduced motion.
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    channels.forEach((channel) => {
      const shapes = [
        ...channel.querySelectorAll<SVGGeometryElement>(
          ".loc-channel__icon svg :is(path, rect, circle)",
        ),
      ];
      // Fully drawn at rest; a hover redraws it from nothing.
      const lines = svg.createDrawable(shapes, 0, 1);
      const filled = channel.querySelector(".loc-channel__icon--whatsapp path");
      const play = () => {
        if (still.matches) return;
        animate(lines, {
          draw: ["0 0", "0 1"],
          duration: 650,
          ease: "inOutSine",
        });
        if (filled) {
          animate(filled, {
            fillOpacity: [0, 1],
            duration: 300,
            delay: 450,
            ease: "linear",
          });
        }
      };
      channel.addEventListener("pointerenter", play);
      channel.addEventListener("focus", play);
    });

    if (!scenesOn()) return;
    const streets = $$<SVGPathElement>("[data-street]");
    const lines = svg.createDrawable(streets);
    const names = $$<SVGTextElement>("[data-street-name]");
    const ring = $("[data-ring]");
    const pin = $("[data-pin]");
    const shadow = $("[data-shadow]");
    const items = [...list.children] as HTMLElement[];
    const drop = pinDrop(FALL, BOUNCES);

    utils.set(lines, { draw: "0 0" });
    utils.set(names, { opacity: 0 });
    utils.set(ring, { opacity: 0, scale: 0.3 });
    utils.set(pin, { translateY: -FALL, opacity: 0 });
    utils.set(shadow, { scale: pinShadow(-FALL, FALL), opacity: 0 });
    utils.set(card, { opacity: 0, translateX: -10 });
    utils.set(items, { opacity: 0, translateY: 16 });

    const timeline = scrubbedScene(root, (tl) => {
      // 1. The streets draw on: the avenues first, then the streets, then
      //    the small ones; each name appears once its street is there.
      const seen: Record<string, number> = {};
      lines.forEach((line, i) => {
        const kind = streets[i]?.dataset["street"] ?? "";
        const plan = STREETS[kind] ?? { at: 0.3, each: 0, span: 0.1 };
        const k = (seen[kind] = (seen[kind] ?? -1) + 1);
        const start = (plan.at + k * plan.each) * L;
        const span = plan.span * L;
        tl.add(
          line,
          { draw: ["0 0", "0 1"], duration: span, ease: "inOutSine" },
          start,
        ).add(
          names[i] ?? [],
          { opacity: [0, 1], duration: span * 0.5, ease: "linear" },
          start + span * 0.6,
        );
      });

      // 2. The pin drops and bounces; its shadow grows on the ground.
      const span = (DROP[1] - DROP[0]) * L;
      tl.add(
        pin,
        {
          translateY: drop.map((frame) => ({
            to: frame.y,
            duration: frame.share * span,
            ease: frame.y === 0 ? "inQuad" : "outQuad",
          })),
          duration: span,
        },
        DROP[0] * L,
      )
        .add(
          pin,
          { opacity: [0, 1], duration: span * 0.1, ease: "linear" },
          DROP[0] * L,
        )
        .add(
          shadow,
          {
            scale: drop.map((frame) => ({
              to: frame.shadow,
              duration: frame.share * span,
              ease: frame.y === 0 ? "inQuad" : "outQuad",
            })),
            duration: span,
          },
          DROP[0] * L,
        )
        .add(
          shadow,
          { opacity: [0, 1], duration: span * 0.3, ease: "linear" },
          DROP[0] * L,
        );

      // A ring pulses out from where the pin lands.
      tl.add(
        ring,
        {
          scale: [0.3, 2.6],
          // From and back to nothing, so a scrub back past it hides it.
          opacity: [0, 0.7, 0],
          duration: L * 0.1,
          ease: "outQuad",
        },
        DROP[0] * L + span * 0.5,
      );

      // 3. The address, then the channels.
      tl.add(
        card,
        {
          opacity: [0, 1],
          translateX: [-10, 0],
          duration: L * 0.07,
          ease: "outQuad",
        },
        CARD * L,
      ).add(
        items,
        {
          opacity: [0, 1],
          translateY: [16, 0],
          duration: L * 0.07,
          delay: stagger(L * 0.025),
          ease: "outQuad",
        },
        CHANNELS * L,
      );
    });

    // Links still on their way in stay out of reach.
    const reach = (time: number) => {
      card.inert = time < CARD * L + L * 0.035;
      list.inert = time < CHANNELS * L + L * 0.035;
    };
    timeline.onUpdate = (self) => reach(self.currentTime);
    reach(timeline.currentTime);
  });
</script>
