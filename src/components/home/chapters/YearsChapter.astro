---
/**
 * Chapter 06 · Quiénes somos, "30 años". A cream sheet with a huge "30"
 * cut out of it: the team photo shows through the figure. The scroll dives
 * into the stroke of the "0" until the photo fills the screen, and then who
 * we are comes in over it: the years, the key facts (counting up with the
 * scroll), the mission and a link to the team.
 *
 * A full-bleed chapter: the same track and pinned stage as the others
 * (src/scripts/chapters/scrub.ts), with its own head instead of
 * Chapter.astro's grid. The cut-out sheet is an SVG mask; the script
 * measures where the "0" has ink (a canvas probe of the same text) and the
 * timeline zooms into that point. Only verifiable facts.
 *
 * On a phone (below 64rem) the landscape photo cannot fill a portrait
 * screen without cropping the team, so after the dive it shrinks, with the
 * scroll, into a full-width band under the header at its own ratio, and
 * the copy comes in below it on plum. The facts sit past the first screen
 * of the stage: they scroll in right after the pin ends.
 *
 * Without the scenes mark (no JavaScript, reduced motion) the chapter is
 * the finished state: the photo with the facts and the mission on it (on a
 * phone, the photo band with the copy below it).
 */
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import team from "../../../assets/photos/equipo-emoj.jpg";
import { CLIENTS, MISSION } from "../../../lib/site";

const FACTS = [
  { value: 7, label: "especialidades coordinadas por un mismo equipo" },
  { value: 2, label: "regiones: Valparaíso y Coquimbo" },
  { value: CLIENTS.length, label: "clientes de referencia" },
] as const;
---

<section
  class="ch-track years-scene"
  aria-labelledby="treinta-anos"
  data-track
  data-nav-section="/nosotros"
  data-scene-years
>
  <div class="years-stage" data-stage>
    <div class="years-photo">
      <Image
        src={team}
        alt="El equipo de EMOJ Consultora: nueve personas de pie, una junto a otra."
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        loading="lazy"
        class="years-photo__img"
      />
      <span class="years-photo__veil" aria-hidden="true"></span>
    </div>

    {/* The cream sheet with the figure cut out (decorative). */}
    <div class="years-cut" aria-hidden="true" data-years-cut>
      <svg class="years-cut__svg" data-years-svg>
        <defs>
          <mask id="years-mask" maskUnits="userSpaceOnUse">
            <rect class="years-cut__full" fill="white"></rect>
            <text
              class="years-cut__text"
              fill="black"
              text-anchor="middle"
              data-years-text
            >
              30
            </text>
          </mask>
        </defs>
        <g data-years-zoom>
          <rect class="years-cut__sheet" mask="url(#years-mask)"></rect>
          <text class="years-cut__outline" text-anchor="middle" data-years-text>
            30
          </text>
        </g>
      </svg>
    </div>
    <div class="years-around" aria-hidden="true">
      <span>Más de</span>
      <span>años acercando la ingeniería</span>
    </div>

    <div class="years-content container-site" data-years-content>
      <div class="years-content__lead">
        <p class="years-eyebrow">
          <span>06</span> Quiénes somos
        </p>
        <h2 id="treinta-anos" class="years-title">
          Más de 30 años acercando la <em>ingeniería</em>.
        </h2>
        <p class="years-text">
          Nacimos en Quilpué, en la Región de Valparaíso. Nuestra misión:{" "}
          {MISSION.charAt(0).toLowerCase() + MISSION.slice(1)}
        </p>
        <a href="/nosotros" class="years-link">
          Conoce al equipo
          <ArrowRight size={18} stroke-width={1.75} aria-hidden="true" />
        </a>
      </div>
      <dl class="years-facts">
        {FACTS.map(({ value, label }) => (
          <div class="years-fact">
            <dt>{label}</dt>
            <dd>
              <span aria-hidden="true" data-years-count={value}>
                {value}
              </span>
              <span class="sr-only">{value}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  import { utils } from "animejs";
  import {
    countShown,
    diveTarget,
    diveTransform,
    inkSpan,
    photoBand,
    zoomScale,
  } from "../../../lib/motion/chapters";
  import {
    eachScene,
    SCENE_LENGTH,
    scenesOn,
    scrubbedScene,
  } from "../../../scripts/chapters/scrub";

  const L = SCENE_LENGTH;
  const FIGURE = "30";
  const FONT_WEIGHT = 600;
  const FONT_FAMILY = '"Space Grotesk"';
  /** The dive, as shares of the pinned interval. */
  const ZOOM_FROM = 0.1;
  const ZOOM_TO = 0.6;
  /** The content comes in, and the facts count up, over these shares. */
  const CONTENT = [0.6, 0.8] as const;
  const COUNT = [0.66, 0.9] as const;
  /** On a phone the photo becomes a band, then the copy comes in below. */
  const BAND = [0.6, 0.76] as const;
  const LEAD = [0.74, 0.9] as const;
  const phone = window.matchMedia("(max-width: 63.99rem)");

  /** Where `time` is inside [from, to] (shares of L), eased out, 0..1. */
  const outCubicIn = (time: number, [from, to]: readonly [number, number]) => {
    const x = Math.min(1, Math.max(0, (time - from * L) / ((to - from) * L)));
    return 1 - Math.pow(1 - x, 3);
  };

  eachScene("[data-scene-years]", (track, $, $$) => {
    // At rest the chapter is its finished state: nothing to play.
    if (!scenesOn()) return;
    const stage = $("[data-stage]");
    const cut = $("[data-years-cut]");
    const svg = $<SVGSVGElement>("[data-years-svg]");
    const photo = $<HTMLImageElement>(".years-photo__img");
    const zoomGroup = $<SVGGElement>("[data-years-zoom]");
    const texts = $$<SVGTextElement>("[data-years-text]");
    const content = $("[data-years-content]");
    const counts = $$("[data-years-count]");
    const values = counts.map((el) => Number(el.dataset["yearsCount"]) || 0);

    let maxScale = 60;
    let origin = { x: 0, y: 0 };
    // The dive's and the band's own values (0..1), tweened by the timeline.
    const dive = { zoom: 0 };
    const band = { share: 0 };
    // The screen the photo shrinks in, and the header it settles under.
    let frame = {
      width: 0,
      height: 0,
      top: 0,
      natural: { width: 0, height: 0 },
    };

    const setPx = (name: string, value: number) =>
      stage.style.setProperty(name, `${Math.round(value * 100) / 100}px`);

    // The phone band: only the phone layout reads these properties.
    const drawBand = () => {
      if (!phone.matches || frame.width === 0) return;
      const box = photoBand(band.share, frame);
      setPx("--years-photo-top", box.top);
      setPx("--years-photo-h", box.height);
      stage.style.setProperty("--years-band", String(band.share));
    };

    const draw = () => {
      zoomGroup.setAttribute(
        "transform",
        diveTransform(origin, zoomScale(dive.zoom, maxScale)),
      );
      const state = dive.zoom >= 1 ? "through" : "sheet";
      if (stage.dataset["state"] !== state) stage.dataset["state"] = state;
      drawBand();
    };

    // Lays out the cut-out "30" to its screen (the whole stage, or its
    // first screen on a phone) and finds a point with ink inside the "0"
    // (the same text drawn on a canvas, one row of pixels).
    const layout = () => {
      const width = cut.clientWidth;
      const height = cut.clientHeight;
      if (width === 0 || height === 0) return;
      frame = {
        width,
        height,
        top:
          parseFloat(getComputedStyle(stage).getPropertyValue("--header-h")) ||
          0,
        natural: {
          width: Number(photo.getAttribute("width")) || photo.naturalWidth,
          height: Number(photo.getAttribute("height")) || photo.naturalHeight,
        },
      };
      setPx("--years-band-h", photoBand(1, frame).height);
      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
      for (const rect of svg.querySelectorAll("rect")) {
        rect.setAttribute("width", String(width));
        rect.setAttribute("height", String(height));
      }

      const size = Math.round(Math.min(width * 0.8, height * 0.8));
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext("2d", { willReadFrequently: true });
      if (!ctx) return;
      ctx.font = `${FONT_WEIGHT} ${size}px ${FONT_FAMILY}`;
      const metrics = ctx.measureText(FIGURE);
      const ascent = metrics.actualBoundingBoxAscent || size * 0.7;
      const baseline = Math.round(height / 2 + ascent / 2);
      for (const text of texts) {
        text.setAttribute("x", String(width / 2));
        text.setAttribute("y", String(baseline));
        text.setAttribute("font-size", String(size));
      }

      // Where the "0" sits, and one row of pixels across its middle.
      ctx.textAlign = "center";
      ctx.textBaseline = "alphabetic";
      ctx.fillText(FIGURE, width / 2, baseline);
      const zeroLeft =
        width / 2 - metrics.width / 2 + ctx.measureText("3").width;
      const row = Math.round(baseline - ascent / 2);
      const left = Math.max(0, Math.round(zeroLeft));
      const span = Math.max(
        1,
        Math.min(width - left, Math.round(ctx.measureText("0").width)),
      );
      const pixels = ctx.getImageData(left, row, span, 1).data;
      ({ origin, maxScale } = diveTarget({
        width,
        height,
        left,
        row,
        ink: inkSpan(pixels, span),
      }));
      draw();
    };
    layout();
    // The figure is measured with its own font; redo it once loaded.
    void document.fonts
      ?.load(`${FONT_WEIGHT} 100px ${FONT_FAMILY}`, FIGURE)
      .then(layout);
    let timer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(layout, 120);
    });

    utils.set(stage, {
      "--years-around": 1,
      "--years-outline": 1,
      "--years-photo": 1.22,
      "--years-veil": 0,
      "--years-content": 0,
      "--years-lead": 0,
    });

    const timeline = scrubbedScene(track, (tl) => {
      tl.add(
        stage,
        { "--years-around": [1, 0], duration: L * 0.12, ease: "linear" },
        L * 0.04,
      )
        // The outline that draws the figure goes as the dive starts.
        .add(
          stage,
          { "--years-outline": [1, 0], duration: L * 0.1, ease: "linear" },
          L * ZOOM_FROM,
        )
        .add(
          dive,
          {
            zoom: [0, 1],
            duration: L * (ZOOM_TO - ZOOM_FROM),
            ease: "inOutCubic",
          },
          L * ZOOM_FROM,
        )
        .add(
          stage,
          { "--years-photo": [1.22, 1], duration: L * 0.65, ease: "outCubic" },
          L * ZOOM_FROM,
        )
        .add(
          stage,
          { "--years-veil": [0, 1], duration: L * 0.22, ease: "linear" },
          L * 0.5,
        )
        .add(
          stage,
          {
            "--years-content": [0, 1],
            duration: L * (CONTENT[1] - CONTENT[0]),
            ease: "outCubic",
          },
          L * CONTENT[0],
        )
        // On a phone: the photo shrinks into its band, then the copy comes
        // in below it (the desktop layout ignores both).
        .add(
          band,
          {
            share: [0, 1],
            duration: L * (BAND[1] - BAND[0]),
            ease: "inOutCubic",
          },
          L * BAND[0],
        )
        .add(
          stage,
          {
            "--years-lead": [0, 1],
            duration: L * (LEAD[1] - LEAD[0]),
            ease: "outCubic",
          },
          L * LEAD[0],
        );
    });

    // The dive is an SVG transform, not a CSS one: Chrome repaints the mask
    // correctly when the attribute changes, also on a jump back. Figures
    // follow the timeline's time, so a scrub back counts down.
    const write = (time: number) => {
      draw();
      content.inert = outCubicIn(time, phone.matches ? LEAD : CONTENT) < 0.5;
      const counted = outCubicIn(time, COUNT);
      counts.forEach((el, i) => {
        const label = countShown(values[i] ?? 0, counted);
        if (el.textContent !== label) el.textContent = label;
      });
    };
    timeline.onUpdate = (self) => write(self.currentTime);
    write(timeline.currentTime);
  });
</script>
