---
/**
 * Chapter 03 · Cómo trabajamos, "Del primer trazo a la obra". A full-bleed
 * sage band (`accent`, plum text, the same in both themes) with the EMOJ
 * isotype across it: the stroke is the first line of every project. Its
 * faint, wide pen line runs behind; the six stages sit on it, at even
 * steps along the stroke (src/lib/motion/stroke-path.ts lays them out from
 * the official geometry).
 *
 * While the stage is pinned the scroll draws the stroke in plum from the
 * left dot, leg by leg (src/scripts/chapters/scrub.ts): the drawing stops
 * at each stage, its icon draws itself and, in the list under the stroke,
 * the stage's rule, name and line come in. "Obra" closes the line and the
 * end dot lands.
 *
 * The stroke and its icons are decorative; the list is the content. At
 * rest (no JavaScript, reduced motion) the stroke is complete and every
 * stage reads with its line.
 */
import {
  ArrowRight,
  FlaskConical,
  HardHat,
  MapPin,
  MessagesSquare,
  PencilRuler,
  Stamp,
} from "@lucide/astro";
import { WORK_STAGES } from "../../../lib/content/work-stages";
import {
  boxShare,
  parseCubicPath,
  pointAlong,
  samplePath,
} from "../../../lib/motion/stroke-path";
import { ISOTYPE } from "./isotype";
import { STATIONS } from "./work-stations";

const ICONS = [
  MessagesSquare,
  MapPin,
  FlaskConical,
  PencilRuler,
  Stamp,
  HardHat,
];
const pad = (n: number) => String(n).padStart(2, "0");
const percent = (share: number) => `${Math.round(share * 1000) / 10}%`;

// The stroke runs right to left: a station's share is read from the left.
const stroke = samplePath(parseCubicPath(ISOTYPE.stroke));
const stages = WORK_STAGES.map((stage, i) => {
  const at = boxShare(
    pointAlong(stroke, 1 - (STATIONS[i] ?? 0)),
    ISOTYPE.viewBox,
  );
  return {
    ...stage,
    Icon: ICONS[i] ?? MessagesSquare,
    x: percent(at.x),
    y: percent(at.y),
  };
});
---

<section
  class="ch-track flow-scene"
  aria-labelledby="como-trabajamos"
  data-track
  data-nav-section="/nosotros"
  data-scene-flow
>
  <div class="flow-stage container-wide" data-stage>
    <div class="flow-head">
      <div class="flow-heading">
        <p class="flow-eyebrow">
          <span>03</span> Cómo trabajamos
        </p>
        <h2 id="como-trabajamos" class="flow-title">
          Del primer trazo a la <em>obra</em>.
        </h2>
      </div>
      <div class="flow-intro">
        <p class="flow-lead">
          <strong>Un solo equipo, de principio a fin.</strong> Seis etapas
          coordinadas: te acompañamos desde la primera conversación hasta que lo
          diseñado está construido.
        </p>
        <a href="/contacto" class="flow-cta">
          Cotizar proyecto
          <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="flow-room">
      <div class="flow-band" data-band>
        <svg
          class="flow-svg"
          viewBox={ISOTYPE.viewBox}
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path class="flow-trace" d={ISOTYPE.stroke} />
          <path class="flow-line" d={ISOTYPE.stroke} data-line />
          <circle
            class="flow-dot"
            cx={ISOTYPE.start.x}
            cy={ISOTYPE.start.y}
            r={ISOTYPE.dot}
          />
          <circle
            class="flow-dot flow-dot--end"
            cx={ISOTYPE.end.x}
            cy={ISOTYPE.end.y}
            r={ISOTYPE.dot}
            data-end
          />
        </svg>
        {stages.map(({ Icon, x, y }) => (
          <span
            class="flow-node"
            aria-hidden="true"
            data-node
            data-x={x}
            data-y={y}
          >
            <Icon size={18} stroke-width={1.75} />
          </span>
        ))}
      </div>
    </div>

    <ol class="flow-steps" data-steps>
      {stages.map(({ name, line }, i) => (
        <li class="flow-step" data-step>
          <span class="flow-step__rule" aria-hidden="true" data-rule />
          <p class="flow-step__num" aria-hidden="true">
            {pad(i + 1)}
          </p>
          <h3 class="flow-step__name">{name}</h3>
          <p class="flow-step__line" data-says>
            {line}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { svg, stagger, utils } from "animejs";
  import { drawFromEnd, strokeSchedule } from "../../../lib/motion/stroke-path";
  import {
    eachScene,
    scenesOn,
    scrubbedScene,
  } from "../../../scripts/chapters/scrub";
  import { STATIONS } from "./work-stations";

  /** The drawing spans these shares of the pinned interval. */
  const FROM = 0.05;
  const TO = 0.9;
  /** Share of each stage's slot the drawing holds on it. */
  const HOLD = 0.45;
  /** How dim a stage waits before the drawing reaches it. */
  const WAIT = 0.35;

  eachScene("[data-scene-flow]", (track, $, $$) => {
    // The stages sit on the stroke (CSSOM: no inline styles in the markup);
    // also at rest, where the stroke is complete.
    const band = $("[data-band]");
    const nodes = $$("[data-node]");
    nodes.forEach((node) => {
      node.style.setProperty("left", node.dataset["x"] ?? "0%");
      node.style.setProperty("top", node.dataset["y"] ?? "0%");
    });
    band.setAttribute("data-placed", "");
    if (!scenesOn()) return;

    const line = svg.createDrawable($<SVGPathElement>("[data-line]"));
    const end = $<SVGCircleElement>("[data-end]");
    const steps = $$("[data-step]");
    const parts = steps.map((step, i) => {
      const node = nodes[i];
      const icon = node?.querySelector("svg");
      return {
        node,
        strokes: svg.createDrawable(
          icon
            ? [...icon.children].filter(
                (child): child is SVGGeometryElement =>
                  child instanceof SVGGeometryElement,
              )
            : [],
        ),
        rule: step.querySelector<HTMLElement>("[data-rule]"),
        head: [...step.querySelectorAll<HTMLElement>(".flow-step__num, h3")],
        says: step.querySelector<HTMLElement>("[data-says]"),
      };
    });
    // Phones and tablets show one stage's line at a time, in one place.
    const oneLine = window.matchMedia("(max-width: 63.99rem)").matches;
    const legs = strokeSchedule(STATIONS, FROM, TO, HOLD);

    utils.set(line, { draw: drawFromEnd(0) });
    utils.set(end, { scale: 0 });
    parts.forEach((part) => {
      if (part.node) utils.set(part.node, { opacity: WAIT, scale: 0.85 });
      utils.set(part.strokes, { draw: "0 0" });
      if (part.rule) utils.set(part.rule, { scaleX: 0 });
      utils.set(part.head, { opacity: WAIT });
      if (part.says) utils.set(part.says, { opacity: 0, translateY: 10 });
    });

    scrubbedScene(track, (tl) => {
      legs.forEach((leg, i) => {
        const part = parts[i];
        if (!part) return;
        const travel = leg.reach - leg.start;
        // The stroke draws to the stage, then holds there.
        tl.add(
          line,
          {
            draw: [drawFromEnd(leg.from), drawFromEnd(leg.to)],
            duration: travel,
            ease: "inOutSine",
          },
          leg.start,
        );
        // The stage lights as the drawing reaches it.
        const at = leg.reach - travel * 0.15;
        if (part.node) {
          tl.add(
            part.node,
            {
              opacity: [WAIT, 1],
              scale: [0.85, 1.2, 1],
              duration: travel * 0.6,
              ease: "outQuad",
            },
            at,
          );
        }
        tl.add(
          part.strokes,
          {
            draw: ["0 0", "0 1"],
            duration: travel * 0.6,
            delay: stagger(travel * 0.08),
            ease: "inOutSine",
          },
          at,
        );
        if (part.rule) {
          tl.add(
            part.rule,
            { scaleX: [0, 1], duration: travel * 0.5, ease: "inOutQuad" },
            at,
          );
        }
        tl.add(
          part.head,
          { opacity: [WAIT, 1], duration: travel * 0.3, ease: "linear" },
          at,
        );
        if (part.says) {
          tl.add(
            part.says,
            {
              opacity: [0, 1],
              translateY: [10, 0],
              duration: travel * 0.4,
              ease: "outQuad",
            },
            at + travel * 0.2,
          );
          // One line at a time on small screens: it gives way to the next.
          const next = legs[i + 1];
          if (oneLine && next) {
            tl.add(
              part.says,
              {
                opacity: [1, 0],
                translateY: [0, -10],
                duration: travel * 0.25,
                ease: "inQuad",
              },
              next.reach - travel * 0.3,
            );
          }
        }
      });
      // "Obra" closes the line: the end dot lands.
      const last = legs.at(-1);
      if (last) {
        tl.add(
          end,
          { scale: [0, 1.5, 1], duration: 400, ease: "outQuad" },
          last.reach,
        );
      }
    });
  });
</script>
