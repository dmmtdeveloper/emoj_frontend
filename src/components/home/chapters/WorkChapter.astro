---
/**
 * Chapter 03 · Cómo trabajamos. The loop of a project with EMOJ at its
 * centre (deivid.space's chapter 04 orbit, in EMOJ's identity): six stages
 * on a ring, each one an icon with its name outside, in its own colour.
 * While the chapter is pinned the orbit takes the screen and a pulse runs
 * one lap:
 * - it draws each stage's arc and lights its icon (a ping), and the stage's
 *   card opens beside it with what happens there;
 * - the conversation's messages and the studies' data are pulled into the
 *   centre, the approval card gets its stamp and, at the end, the project
 *   ships as built work;
 * - at the centre the EMOJ stroke draws itself as the lap goes on, beats at
 *   each stage, and the dotted ring keeps turning.
 *
 * The orbit is decorative; the cards are the six stages as an ordered list
 * (all listed under the orbit without motion).
 */
import {
  ArrowRight,
  FlaskConical,
  HardHat,
  MapPin,
  MessagesSquare,
  PencilRuler,
  Stamp,
} from "@lucide/astro";
import { WORK_STAGES } from "../../../lib/content/work-stages";
import { orbitPoint } from "../../../lib/motion/chapters";
import { ISOTYPE } from "./isotype";
import Chapter from "./Chapter.astro";

const ICONS = [
  MessagesSquare,
  MapPin,
  FlaskConical,
  PencilRuler,
  Stamp,
  HardHat,
];
const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(WORK_STAGES.length);

/** The orbit, in the SVG's units (viewBox 0 0 400 400). */
const C = { x: 200, y: 200 };
const R = 120;
const TILE = 26;
const step = 360 / WORK_STAGES.length;
const at = (angle: number, r = R) => orbitPoint(angle, r, C);
const f = (n: number) => Math.round(n * 10) / 10;

const stages = WORK_STAGES.map((stage, i) => {
  // Each stage owns a slice of the ring: its icon sits in the middle of the
  // slice, its name just outside.
  const mid = (i + 0.5) * step;
  const from = at(i * step + 2);
  const to = at((i + 1) * step - 2);
  const label = at(mid, R + 38);
  return {
    ...stage,
    Icon: ICONS[i] ?? MessagesSquare,
    tile: at(mid),
    label,
    anchor:
      label.x > C.x + 12 ? "start" : label.x < C.x - 12 ? "end" : "middle",
    arc: `M${f(from.x)} ${f(from.y)}A${R} ${R} 0 0 1 ${f(to.x)} ${f(to.y)}`,
  };
});
/** One lap, clockwise from the top, for the pulse to follow. */
const loop = `M${C.x} ${C.y - R}A${R} ${R} 0 1 1 ${C.x} ${C.y + R}A${R} ${R} 0 1 1 ${C.x} ${C.y - R}`;

/** What gets pulled into the centre: messages and data, from their stage. */
const pulled = (stage: number, count: number, size: [number, number]) =>
  Array.from({ length: count }, (_, i) => {
    const angle = (stage + 0.5) * step + (i % 3) * 9 - 9;
    const p = at(angle, R + 54 + Math.floor(i / 3) * 16);
    return {
      x: f(p.x - size[0] / 2),
      y: f(p.y - size[1] / 2),
      w: size[0],
      h: size[1],
      dx: f(C.x - p.x),
      dy: f(C.y - p.y),
    };
  });
const messages = pulled(0, 6, [14, 9]);
const data = pulled(2, 6, [10, 10]);
---

<Chapter
  id="como-trabajamos"
  number="03"
  label="Cómo trabajamos"
  navSection="/nosotros"
  tone="sunken"
  class="ch-work"
>
  <Fragment slot="title">
    Del primer trazo a la <em>obra</em>.
  </Fragment>

  <div class="orb" slot="scene" data-scene-orbit>
    <div class="orb-dial">
      <svg
        class="orb-svg"
        viewBox="0 0 400 400"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <circle class="orb-outer" cx={C.x} cy={C.y} r="182" data-outer />
        <circle class="orb-ring" cx={C.x} cy={C.y} r={R} />
        {stages.map((stage, i) => (
          <path
            class:list={["orb-arc", `orb-lane-${i}`]}
            d={stage.arc}
            data-arc
          />
        ))}
        <path class="orb-loop" d={loop} data-loop />

        {stages.map((stage, i) => (
          <text
            class:list={["orb-label", `orb-lane-${i}`]}
            x={f(stage.label.x)}
            y={f(stage.label.y)}
            text-anchor={stage.anchor}
            dominant-baseline="central"
            data-label
          >
            {stage.short}
          </text>
        ))}

        {messages.map((m) => (
          <rect
            class="orb-chip orb-chip--message"
            x={m.x}
            y={m.y}
            width={m.w}
            height={m.h}
            rx="3"
            data-message
            data-dx={m.dx}
            data-dy={m.dy}
          />
        ))}
        {data.map((d) => (
          <rect
            class="orb-chip orb-chip--data"
            x={d.x}
            y={d.y}
            width={d.w}
            height={d.h}
            rx="2"
            data-datum
            data-dx={d.dx}
            data-dy={d.dy}
          />
        ))}

        {stages.map((stage, i) => (
          <circle
            class:list={["orb-ping", `orb-lane-${i}`]}
            cx={f(stage.tile.x)}
            cy={f(stage.tile.y)}
            r={TILE / 2}
            data-ping
          />
        ))}
        {stages.map((stage, i) => (
          <g class:list={["orb-tile", `orb-lane-${i}`]} data-tile>
            <rect
              class="orb-tile__box"
              x={f(stage.tile.x - TILE / 2)}
              y={f(stage.tile.y - TILE / 2)}
              width={TILE}
              height={TILE}
              rx="7"
            />
            <rect
              class="orb-tile__glow"
              x={f(stage.tile.x - TILE / 2)}
              y={f(stage.tile.y - TILE / 2)}
              width={TILE}
              height={TILE}
              rx="7"
              data-glow
            />
            <stage.Icon
              class="orb-tile__icon"
              x={f(stage.tile.x - 7)}
              y={f(stage.tile.y - 7)}
              width={14}
              height={14}
              stroke-width={1.75}
            />
          </g>
        ))}

        <circle class="orb-pulse" r="6" data-pulse />

        <circle class="orb-halo" cx={C.x} cy={C.y} r="62" data-halo />
        <circle class="orb-dots" cx={C.x} cy={C.y} r="52" data-spin />
        <g class="orb-core" data-core>
          <circle class="orb-core__disc" cx={C.x} cy={C.y} r="42" />
          <svg
            class="orb-mark"
            x={C.x - 28}
            y={C.y - 18}
            width="56"
            height="22"
            viewBox={ISOTYPE.viewBox}
          >
            <path class="orb-mark__stroke" d={ISOTYPE.stroke} data-mark />
            <circle
              class="orb-mark__dot"
              cx={ISOTYPE.start.x}
              cy={ISOTYPE.start.y}
              r={ISOTYPE.dot * 1.6}
              data-dot
            />
            <circle
              class="orb-mark__dot"
              cx={ISOTYPE.end.x}
              cy={ISOTYPE.end.y}
              r={ISOTYPE.dot * 1.6}
              data-dot
            />
          </svg>
          <text
            class="orb-core__label"
            x={C.x}
            y={C.y + 18}
            text-anchor="middle"
          >
            Tu obra
          </text>
        </g>
      </svg>

      <span class="orb-ship" aria-hidden="true" data-ship>
        Proyecto → obra ✓
      </span>
    </div>

    <ol class="orb-cards">
      {WORK_STAGES.map((stage, i) => (
        <li
          class:list={["orb-card", `orb-card--${i}`, `orb-lane-${i}`]}
          data-card
        >
          <p class="orb-card__num">
            {pad(i + 1)} <span>/ {total}</span>
          </p>
          <h3 class="orb-card__title">{stage.title}</h3>
          <p class="orb-card__text">{stage.text}</p>
          {i === 4 && (
            <span class="orb-stamp" aria-hidden="true" data-stamp>
              Aprobado
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>

  <p class="ch-text">
    <strong>Un solo equipo, de principio a fin.</strong> Seis etapas
    coordinadas: te acompañamos desde la primera conversación hasta que lo
    diseñado está construido.
  </p>
  <p class="ch-tags">{WORK_STAGES.map((stage) => stage.short).join(" · ")}</p>
  <a href="/contacto" class="ch-more">
    Cotizar proyecto
    <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
  </a>
</Chapter>

<script>
  import { stagger, svg, utils } from "animejs";
  import { stageTimes } from "../../../lib/motion/chapters";
  import {
    eachScene,
    SCENE_LENGTH,
    scenesOn,
    scrubbedScene,
  } from "../../../scripts/chapters/scrub";

  const L = SCENE_LENGTH;
  const FROM = 0.14;
  const TO = 0.86;
  const offset = (axis: "dx" | "dy") => (target: unknown) =>
    Number((target as SVGElement).dataset[axis] ?? 0);

  eachScene("[data-scene-orbit]", (root, $, $$) => {
    const arcs = svg.createDrawable($$<SVGPathElement>("[data-arc]"));
    const mark = svg.createDrawable($<SVGPathElement>("[data-mark]"));
    const dots = $$<SVGCircleElement>("[data-dot]");
    const labels = $$<SVGTextElement>("[data-label]");
    const tiles = $$<SVGGElement>("[data-tile]");
    const glows = $$<SVGRectElement>("[data-glow]");
    const pings = $$<SVGCircleElement>("[data-ping]");
    const cards = $$("[data-card]");
    const messages = $$<SVGRectElement>("[data-message]");
    const data = $$<SVGRectElement>("[data-datum]");
    const loop = $<SVGPathElement>("[data-loop]");
    const pulse = $<SVGCircleElement>("[data-pulse]");
    const spin = $<SVGCircleElement>("[data-spin]");
    const outer = $<SVGCircleElement>("[data-outer]");
    const halo = $<SVGCircleElement>("[data-halo]");
    const core = $<SVGGElement>("[data-core]");
    const stamp = $("[data-stamp]");
    const ship = $("[data-ship]");
    const playing = scenesOn();

    // The script starts the lap from nothing; at rest it reads complete.
    if (playing) {
      utils.set(arcs, { draw: "0 0" });
      utils.set(mark, { draw: "0 0" });
      utils.set(dots, { scale: 0 });
      utils.set(labels, { opacity: 0.45 });
      utils.set([...glows, ...pings, ...messages, ...data, pulse], {
        opacity: 0,
      });
      utils.set(cards, { opacity: 0, scale: 0.92 });
      utils.set([stamp, ship], { opacity: 0 });
      utils.set(halo, { opacity: 0.3 });
    }

    const starts = stageTimes(arcs.length, FROM, TO);
    const Q = ((TO - FROM) * L) / arcs.length;
    const lap = (TO - FROM) * L;

    scrubbedScene(root, (tl) => {
      // The centre: the dotted ring turns, the outer dots drift, the EMOJ
      // stroke draws itself over the lap and the glow grows with it.
      tl.add(spin, { rotate: [0, 300], duration: L, ease: "linear" }, 0)
        .add(outer, { rotate: [0, -60], duration: L, ease: "linear" }, 0)
        .add(
          dots[0] ?? [],
          { scale: [0, 1], duration: L * 0.03, ease: "outBack" },
          L * FROM,
        )
        .add(
          mark,
          { draw: ["0 0", "0 1"], duration: lap, ease: "linear" },
          L * FROM,
        )
        .add(
          dots[1] ?? [],
          { scale: [0, 1], duration: L * 0.03, ease: "outBack" },
          L * TO,
        )
        .add(
          halo,
          { opacity: [0.3, 1], duration: lap, ease: "linear" },
          L * FROM,
        );

      // One lap of the pulse.
      tl.add(
        pulse,
        {
          ...svg.createMotionPath(loop),
          opacity: [
            { to: 1, duration: L * 0.02 },
            { to: 1, duration: lap - L * 0.04 },
            { to: 0, duration: L * 0.02 },
          ],
          duration: lap,
          ease: "linear",
        },
        L * FROM,
      );

      arcs.forEach((arc, k) => {
        const start = starts[k] ?? 0;
        const reach = start + Q * 0.35;
        const last = k === arcs.length - 1;
        tl.add(
          arc,
          { draw: ["0 0", "0 1"], duration: Q, ease: "linear" },
          start,
        )
          .add(
            labels[k] ?? [],
            { opacity: [0.45, 1], duration: Q * 0.2 },
            reach,
          )
          // The icon lights with a ping, then stays tinted.
          .add(
            tiles[k] ?? [],
            {
              scale: [
                { to: 1.3, duration: Q * 0.15, ease: "outBack" },
                { to: 1.3, duration: Q * 0.5 },
                { to: 1, duration: Q * 0.2 },
              ],
            },
            reach,
          )
          .add(
            glows[k] ?? [],
            {
              opacity: [
                { to: 1, duration: Q * 0.15 },
                { to: 1, duration: Q * 0.5 },
                { to: 0.4, duration: Q * 0.2 },
              ],
            },
            reach,
          )
          .add(
            pings[k] ?? [],
            {
              scale: [1, 2.8],
              opacity: [0.8, 0],
              duration: Q * 0.45,
              ease: "outQuad",
            },
            reach,
          )
          // The centre beats as each stage is reached.
          .add(
            core,
            {
              scale: [
                { to: 1.08, duration: Q * 0.08, ease: "outQuad" },
                { to: 1, duration: Q * 0.2, ease: "inOutQuad" },
              ],
            },
            reach,
          )
          // The stage's card opens beside it, then gives way to the next.
          .add(
            playing ? (cards[k] ?? []) : [],
            {
              // The last one stays until the orbit goes back to its place.
              opacity: [
                { to: 1, duration: Q * 0.15 },
                { to: 1, duration: last ? Q * 0.85 + L * 0.02 : Q * 0.65 },
                { to: 0, duration: Q * 0.15 },
              ],
              scale: last
                ? [{ to: 1, duration: Q * 0.2, ease: "outBack" }]
                : [
                    { to: 1, duration: Q * 0.2, ease: "outBack" },
                    { to: 1, duration: Q * 0.6 },
                    { to: 0.96, duration: Q * 0.15 },
                  ],
            },
            reach,
          );
      });

      // Conversación and Estudios: messages and data pulled to the centre.
      const pull = (targets: SVGElement[], stage: number) =>
        tl.add(
          targets,
          {
            opacity: [
              { to: 1, duration: Q * 0.12 },
              { to: 1, duration: Q * 0.45 },
              { to: 0, duration: Q * 0.12 },
            ],
            translateX: [
              { to: 0, duration: Q * 0.2 },
              { to: offset("dx"), duration: Q * 0.5, ease: "inQuad" },
            ],
            translateY: [
              { to: 0, duration: Q * 0.2 },
              { to: offset("dy"), duration: Q * 0.5, ease: "inQuad" },
            ],
            delay: stagger(Q * 0.04),
          },
          (starts[stage] ?? 0) + Q * 0.3,
        );
      pull(messages, 0);
      pull(data, 2);

      // Aprobación: the stamp lands on its card.
      tl.add(
        stamp,
        {
          opacity: [0, 1],
          scale: [2.2, 1],
          duration: Q * 0.18,
          ease: "outBack",
        },
        (starts[4] ?? 0) + Q * 0.65,
      );
      // Obra: the project leaves the centre as built work.
      tl.add(
        ship,
        {
          opacity: [0, 1],
          translateY: ["-140%", "0%"],
          scale: [0.6, 1],
          duration: Q * 0.4,
          ease: "outCubic",
        },
        (starts[5] ?? 0) + Q * 0.6,
      );
    });
  });
</script>
