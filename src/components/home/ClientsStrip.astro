---
/**
 * Reference clients as monochrome logos in an endless marquee (CSS only,
 * motion.css `.marquee*`). Each logo (public/logos/clientes/*.svg, the
 * brand's own artwork) is used as a CSS mask over `currentColor`, so every
 * brand reads in the same muted tone in both themes and darkens to `ink` on
 * hover. Heights are balanced by eye per logo (wide wordmarks shorter).
 * A client without a logo file falls back to its name as a wordmark.
 *
 * Per-logo values (file, aspect ratio, height) live in src/styles/global.css
 * as `.client-logo--<file>` classes (src/lib/clients.ts names the files),
 * never in a `style` attribute: production sends the CSP `style-src
 * 'self'`, which blocks inline style attributes.
 *
 * The second copy of the list is hidden from assistive tech. It pauses on
 * hover (with a mouse), on focus and with the pause toggle (a checkbox, so it works without
 * JavaScript; WCAG 2.2.2). Under reduced motion it is a static, wrapping
 * list.
 *
 * `tone="accent"` sits at the foot of the home's sage facts band ("EMOJ en
 * cifras"), next to the client count: plum logos on sage, under a plum
 * rule like the facts (same tones in both themes).
 */
import { Pause, Play } from "@lucide/astro";
import { CLIENT_LOGOS } from "../../lib/clients";
import { CLIENTS } from "../../lib/site";

interface Props {
  tone?: "surface" | "accent";
}

const { tone = "surface" } = Astro.props;

const TONES = {
  surface: {
    section:
      "border-b border-border bg-surface [--marquee-fade:var(--surface)]",
    container: "gap-5 py-10 md:py-12",
    heading: "eyebrow",
    control:
      "rounded-md text-ink-muted hover:bg-surface-sunken hover:text-ink has-focus-visible:outline-focus-ring",
    item: "text-ink-muted hover:text-ink",
  },
  accent: {
    section: "text-on-accent [--marquee-fade:var(--accent)]",
    // The rule spans the content width, like the facts rows above it.
    container:
      "gap-5 py-8 before:absolute before:inset-x-4 before:top-0 before:h-0.5 before:bg-plum-950 md:py-10 md:before:inset-x-6",
    heading:
      "font-data text-[13px] leading-4 font-medium tracking-[0.1em] uppercase",
    control:
      "rounded-full border border-plum-950/30 text-plum-950 hover:bg-plum-950/10 has-focus-visible:outline-plum-950",
    item: "text-plum-950/80 hover:text-plum-950",
  },
} as const;
const t = TONES[tone];

const item = `flex items-center transition-colors duration-200 ${t.item}`;
const wordmark =
  "text-[22px] leading-8 font-semibold tracking-[0.01em] whitespace-nowrap md:text-[26px]";
---

<section aria-labelledby="clientes" class:list={["marquee-wrap", t.section]}>
  <div
    class:list={[
      "container-site relative z-[2] flex flex-col lg:flex-row lg:items-center lg:gap-12",
      t.container,
    ]}
  >
    <div class="flex items-center justify-between gap-4 lg:shrink-0">
      <h2 id="clientes" class={t.heading}>
        Han confiado en nosotros
      </h2>
      <label
        class:list={[
          "marquee__control inline-flex size-11 cursor-pointer items-center justify-center transition-colors has-focus-visible:outline-2 has-focus-visible:outline-offset-2 lg:order-first",
          t.control,
        ]}
      >
        <input type="checkbox" class="marquee__toggle peer sr-only" />
        <Pause
          size={20}
          stroke-width={1.75}
          aria-hidden="true"
          class="peer-checked:hidden"
        />
        <Play
          size={20}
          stroke-width={1.75}
          aria-hidden="true"
          class="hidden peer-checked:block"
        />
        <span class="sr-only">
          Pausar el movimiento de la lista de clientes
        </span>
      </label>
    </div>
    <div class="marquee min-w-0 flex-1">
      <div class="marquee__track">
        <ul class="flex shrink-0 items-center gap-12 pr-12 md:gap-20 md:pr-20">
          {CLIENTS.map((client) => {
            const logo = CLIENT_LOGOS[client];
            return (
              <li class={item}>
                {logo ? (
                  <span
                    role="img"
                    aria-label={client}
                    class={`client-logo client-logo--${logo}`}
                  />
                ) : (
                  <span class={wordmark}>{client}</span>
                )}
              </li>
            );
          })}
        </ul>
        <ul
          class="marquee__clone flex shrink-0 items-center gap-12 pr-12 md:gap-20 md:pr-20"
          aria-hidden="true"
        >
          {CLIENTS.map((client) => {
            const logo = CLIENT_LOGOS[client];
            return (
              <li class={item}>
                {logo ? (
                  <span
                    role="img"
                    aria-label={client}
                    class={`client-logo client-logo--${logo}`}
                  />
                ) : (
                  <span class={wordmark}>{client}</span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>
