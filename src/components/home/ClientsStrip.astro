---
/**
 * Reference clients as monochrome logos in an endless marquee (CSS only,
 * motion.css `.marquee*`). Each logo (public/logos/clientes/*.svg, the
 * brand's own artwork) is used as a CSS mask over `currentColor`, so every
 * brand reads in the same muted tone in both themes and darkens to `ink` on
 * hover. Heights are balanced by eye per logo (wide wordmarks shorter).
 * A client without a logo file falls back to its name as a wordmark.
 *
 * Per-logo values (file, aspect ratio, height) live in the <style> block as
 * classes, never in a `style` attribute: production sends the CSP
 * `style-src 'self'`, which blocks inline style attributes.
 *
 * The second copy of the list is hidden from assistive tech. It pauses on
 * hover, on focus and with the pause toggle (a checkbox, so it works without
 * JavaScript; WCAG 2.2.2). Under reduced motion it is a static, wrapping
 * list.
 */
import { Pause, Play } from "@lucide/astro";
import { CLIENTS } from "../../lib/site";

/**
 * Logo file per client (public/logos/clientes/<file>.svg). Its aspect ratio
 * and display height are set by the matching `.client-logo--<file>` class.
 */
const LOGOS: Partial<Record<(typeof CLIENTS)[number], string>> = {
  ESVAL: "esval",
  "Aguas del Valle": "aguas-del-valle",
  SAAM: "saam",
  "AES Andes": "aes-andes",
  CODELCO: "codelco",
};

const item =
  "flex items-center text-ink-muted transition-colors duration-200 hover:text-ink";
const wordmark =
  "text-[22px] leading-8 font-semibold tracking-[0.01em] whitespace-nowrap md:text-[26px]";
---

<section
  aria-labelledby="clientes"
  class="marquee-wrap border-b border-border bg-surface"
>
  <div class="container-site relative z-[2] flex flex-col gap-5 py-10 md:py-12 lg:flex-row lg:items-center lg:gap-12">
    <div class="flex items-center justify-between gap-4 lg:shrink-0">
      <h2 id="clientes" class="eyebrow">
        Han confiado en nosotros
      </h2>
      <label class="marquee__control inline-flex size-11 cursor-pointer items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-surface-sunken hover:text-ink has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus-ring lg:order-first">
        <input type="checkbox" class="marquee__toggle peer sr-only" />
        <Pause
          size={20}
          stroke-width={1.75}
          aria-hidden="true"
          class="peer-checked:hidden"
        />
        <Play
          size={20}
          stroke-width={1.75}
          aria-hidden="true"
          class="hidden peer-checked:block"
        />
        <span class="sr-only">
          Pausar el movimiento de la lista de clientes
        </span>
      </label>
    </div>
    <div class="marquee min-w-0 flex-1">
      <div class="marquee__track">
        <ul class="flex shrink-0 items-center gap-12 pr-12 md:gap-20 md:pr-20">
          {CLIENTS.map((client) => {
            const logo = LOGOS[client];
            return (
              <li class={item}>
                {logo ? (
                  <span
                    role="img"
                    aria-label={client}
                    class={`client-logo client-logo--${logo}`}
                  />
                ) : (
                  <span class={wordmark}>{client}</span>
                )}
              </li>
            );
          })}
        </ul>
        <ul
          class="marquee__clone flex shrink-0 items-center gap-12 pr-12 md:gap-20 md:pr-20"
          aria-hidden="true"
        >
          {CLIENTS.map((client) => {
            const logo = LOGOS[client];
            return (
              <li class={item}>
                {logo ? (
                  <span
                    role="img"
                    aria-label={client}
                    class={`client-logo client-logo--${logo}`}
                  />
                ) : (
                  <span class={wordmark}>{client}</span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .client-logo {
    display: block;
    height: calc(var(--h) * 0.8);
    aspect-ratio: var(--ratio);
    background-color: currentColor;
    mask: var(--logo) center / contain no-repeat;
  }

  @media (min-width: 48rem) {
    .client-logo {
      height: var(--h);
    }
  }

  /* Aspect ratio (width / height) and display height, balanced by eye. */
  .client-logo--esval {
    --logo: url("/logos/clientes/esval.svg");
    --ratio: 2.732;
    --h: 40px;
  }

  .client-logo--aguas-del-valle {
    --logo: url("/logos/clientes/aguas-del-valle.svg");
    --ratio: 3.876;
    --h: 44px;
  }

  .client-logo--saam {
    --logo: url("/logos/clientes/saam.svg");
    --ratio: 6.152;
    --h: 26px;
  }

  .client-logo--aes-andes {
    --logo: url("/logos/clientes/aes-andes.svg");
    --ratio: 5.196;
    --h: 28px;
  }

  .client-logo--codelco {
    --logo: url("/logos/clientes/codelco.svg");
    --ratio: 4.565;
    --h: 32px;
  }
</style>
