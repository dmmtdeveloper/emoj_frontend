---
import { BadgeCheck, CalendarCheck, Handshake, Users } from "@lucide/astro";
import { Image } from "astro:assets";
import aerial from "../../assets/photos/vista-aerea-industrial.jpg";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  /** Section background, to keep the page's surface rhythm. */
  background?: "surface" | "surface-sunken";
}

const { background = "surface" } = Astro.props;

const DIFFERENTIATORS = [
  {
    icon: CalendarCheck,
    title: "Cumplimiento de plazos",
    text: "Acordamos contigo un calendario de entregas desde el inicio y te mantenemos al tanto del avance en cada etapa.",
  },
  {
    icon: BadgeCheck,
    title: "Calidad garantizada",
    text: "Diseñamos según la normativa chilena vigente y revisamos cada memoria y cada plano antes de entregártelo.",
  },
  {
    icon: Users,
    title: "Trabajo colaborativo",
    text: "Ingenieros civiles y dibujantes proyectistas trabajan en un mismo equipo, coordinando las especialidades desde el primer día.",
  },
  {
    icon: Handshake,
    title: "Confianza y respaldo",
    text: "Más de 30 años trabajando con empresas como ESVAL, Aguas del Valle y SAAM respaldan cada proyecto que firmamos.",
  },
] as const;
---

<section
  aria-labelledby="por-que-emoj"
  class:list={[background === "surface" ? "bg-surface" : "bg-surface-sunken"]}
>
  <div class="container-site relative z-[2] grid gap-10 py-16 md:py-28 lg:grid-cols-[5fr_7fr] lg:gap-16 lg:py-32">
    <div class="flex flex-col gap-8">
      <SectionHeading
        id="por-que-emoj"
        eyebrow="Por qué EMOJ"
        title="Ingeniería precisa, trato cercano"
        lead="Humanizar la ingeniería es explicarte cada decisión técnica con claridad, cumplir lo que acordamos y estar disponibles cuando nos necesitas."
      />
      <Image
        src={aerial}
        alt="Vista aérea de un complejo industrial costero con una chimenea alta."
        widths={[480, 720, 960]}
        sizes="(min-width: 1200px) 440px, (min-width: 1024px) 38vw, 100vw"
        loading="lazy"
        data-reveal="wipe"
        class="hidden aspect-[4/3] w-full rounded-lg object-cover lg:block"
      />
    </div>

    <!-- Phones: a horizontal, snap-scrolling row (no autoplay) to keep the
         page short; from sm up, a 2x2 grid. -->
    <ul
      aria-label="Diferenciadores"
      class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 lg:self-center"
      data-reveal-stagger
    >
      {DIFFERENTIATORS.map(({ icon: Icon, title, text }, index) => (
        <li
          class:list={[
            "group radius-signature flex w-[82%] shrink-0 snap-start flex-col gap-4 p-6 pl-8 transition-[translate,box-shadow] duration-300 ease-(--ease-out) hover:-translate-y-1 hover:shadow-(--shadow-md) sm:w-auto md:p-8 md:pl-10",
            background === "surface"
              ? "bg-surface-sunken"
              : "bg-surface-raised",
          ]}
        >
          <div class="flex items-center justify-between">
            <span class="icon-draw text-brand">
              <Icon size={24} stroke-width={1.75} aria-hidden="true" />
            </span>
            <span
              class="text-[13px] leading-4 font-semibold tracking-[0.14em] text-ink-muted"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
          <h3 class="text-h3">{title}</h3>
          <p class="text-ink-muted">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
