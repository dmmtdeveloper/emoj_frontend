---
/**
 * Home services as an asymmetric bento: the first service as a large photo
 * tile, the other six as compact tiles and a closing "not sure?" tile
 * with a few real team faces, so the question is answered by people.
 * Phones get a dense two-column grid (titles only) to keep the page short.
 * Hovering a compact tile reveals a photo of a real project of that service
 * (the newest published one with a cover), or the service's own photo.
 */
import { ArrowRight } from "@lucide/astro";
import { contentSource } from "../../lib/content";
import { mediaPath } from "../../lib/content/media";
import { coversByService } from "../../lib/content/service-covers";
import { getServices } from "../../lib/get-services";
import ServiceCard from "../services/ServiceCard.astro";
import ArrowLink from "../ui/ArrowLink.astro";
import ButtonLink from "../ui/ButtonLink.astro";
import DotField from "../ui/DotField.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SectionTrace from "../ui/SectionTrace.astro";
import TeamAvatars from "../ui/TeamAvatars.astro";

const [first, ...rest] = await getServices();
const covers = coversByService(
  rest.map((s) => s.data.slug),
  await contentSource().getProjects(),
);
const photoFor = (service: (typeof rest)[number]) => {
  const found = covers.get(service.data.slug);
  if (found)
    return {
      src: mediaPath("proyectos", found.slug, found.cover),
      width: found.cover.width,
      height: found.cover.height,
    };
  return service.data.image ? { src: service.data.image } : undefined;
};
---

<section
  aria-labelledby="servicios"
  class="relative isolate overflow-clip bg-surface-sunken"
>
  <DotField />
  <SectionTrace corner="top-right" />
  <div class="container-site relative z-[2] flex flex-col gap-10 py-16 md:gap-14 md:py-28 lg:py-32">
    <SectionHeading
      id="servicios"
      eyebrow="Servicios"
      title="Siete especialidades, un mismo equipo"
      lead="Desde el agua potable hasta las fundaciones: coordinamos todas las especialidades de tu proyecto para que avance sin interfaces perdidas."
    >
      <ArrowLink slot="action" href="/servicios">
        Ver todos los servicios
      </ArrowLink>
    </SectionHeading>

    <ul
      class="grid grid-cols-2 gap-3 md:gap-5 lg:grid-cols-4 lg:auto-rows-[minmax(232px,auto)]"
      data-reveal-stagger
    >
      {first && (
        <li class="col-span-2 lg:row-span-2">
          <ServiceCard service={first} variant="featured" index={1} />
        </li>
      )}
      {rest.map((service, i) => (
        <li>
          <ServiceCard
            service={service}
            variant="compact"
            index={i + 2}
            photo={photoFor(service)}
          />
        </li>
      ))}
      <li class="col-span-2">
        <div class="radius-signature group flex h-full flex-col justify-between gap-8 bg-accent p-6 pl-8 text-on-accent md:p-8 md:pl-10">
          <div class="flex flex-col gap-3">
            <p class="max-w-[18ch] text-[24px] leading-[30px] font-semibold tracking-[-0.01em] md:text-[34px] md:leading-[40px]">
              ¿No sabes qué especialidad necesitas?
            </p>
            <p class="max-w-[40ch]">
              Cuéntanos tu proyecto y te orientamos sin compromiso.
            </p>
          </div>
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <TeamAvatars limit={3} />
              <p class="text-sm leading-5 font-medium whitespace-nowrap">
                Ingenieros y proyectistas
                <br />
                en Quilpué
              </p>
            </div>
            <ButtonLink
              href="/contacto"
              class="shrink-0 self-start sm:self-auto"
            >
              Escríbenos
              <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
            </ButtonLink>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>
