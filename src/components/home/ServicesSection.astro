---
/**
 * Home services as a bento of quiet blocks: the first service as a large
 * photo tile, the other six as compact blocks and a closing sage block that
 * invites the visitor to ask ("¿No sabes cuál necesitas?"). Phones get a
 * dense two-column grid (titles only) to keep the page short. Hovering a
 * compact block reveals a photo of a real project of that service (the
 * newest published one with a cover), or the service's own photo.
 */
import { ArrowRight } from "@lucide/astro";
import { contentSource } from "../../lib/content";
import { mediaPath } from "../../lib/content/media";
import { coversByService } from "../../lib/content/service-covers";
import { getServices } from "../../lib/get-services";
import ServiceCard from "../services/ServiceCard.astro";
import ArrowLink from "../ui/ArrowLink.astro";
import ButtonLink from "../ui/ButtonLink.astro";
import DisplayHeading from "../ui/DisplayHeading.astro";

const services = await getServices();
const [first, ...rest] = services;
const count = String(services.length).padStart(2, "0");
const covers = coversByService(
  rest.map((s) => s.data.slug),
  await contentSource().getProjects(),
);
const photoFor = (service: (typeof rest)[number]) => {
  const found = covers.get(service.data.slug);
  if (found)
    return {
      src: mediaPath("proyectos", found.slug, found.cover),
      width: found.cover.width,
      height: found.cover.height,
    };
  return service.data.image ? { src: service.data.image } : undefined;
};
---

<section aria-labelledby="servicios" class="bg-surface">
  <div class="container-site flex flex-col gap-10 py-16 md:gap-14 md:py-28 lg:py-32">
    <DisplayHeading
      id="servicios"
      eyebrow={`Servicios · ${count}`}
      title="Siete especialidades. Un solo equipo."
      emphasis="equipo"
      lead="Coordinamos todas las especialidades de tu proyecto para que avance sin interfaces perdidas."
    >
      <ArrowLink slot="action" href="/servicios">
        Ver todos los servicios
      </ArrowLink>
    </DisplayHeading>

    <ul
      class="grid grid-cols-2 gap-3 md:gap-4 lg:grid-cols-4 lg:auto-rows-[minmax(208px,auto)]"
      data-reveal-stagger
    >
      {first && (
        <li class="col-span-2 lg:row-span-2">
          <ServiceCard service={first} variant="featured" />
        </li>
      )}
      {rest.map((service) => (
        <li>
          <ServiceCard
            service={service}
            variant="compact"
            photo={photoFor(service)}
          />
        </li>
      ))}
      <li class="col-span-2">
        <div class="flex h-full flex-col justify-between gap-6 rounded-lg bg-accent p-6 text-on-accent sm:flex-row sm:items-center md:p-8">
          <p class="max-w-[16ch] text-[26px] leading-[30px] font-semibold tracking-[-0.025em] md:text-[32px] md:leading-[36px]">
            ¿No sabes cuál necesitas?
          </p>
          <ButtonLink
            href="/contacto"
            variant="on-accent"
            pill
            class="min-h-12 shrink-0 self-start px-6 text-base sm:self-auto"
          >
            Cuéntanos tu proyecto
            <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
          </ButtonLink>
        </div>
      </li>
    </ul>
  </div>
</section>
