---
/**
 * Chapter 8 · "El último trazo". The home closes on plum: the invitation
 * to talk and, across the stage, the isotype stroke drawn once more by the
 * scroll. Its end dot swells and opens into the quote button: the stroke
 * that started the page ends in the next project.
 *
 * The button is a real link at all times (its pill opens leftwards from
 * the dot); WhatsApp and email sit under the text. Scene:
 * src/scripts/scenes/closing.ts. Without JavaScript or with reduced motion
 * the stroke is drawn and the button open.
 */
import { ArrowRight, Mail } from "@lucide/astro";
import { CONTACT, TAGLINE } from "../../../lib/site";
import { whatsappHref } from "../../../lib/whatsapp";
import WhatsAppIcon from "../../ui/WhatsAppIcon.astro";
import { ISOTYPE } from "./isotype";
---

<section
  class="close-scene"
  data-scene="closing"
  aria-labelledby="conversemos"
  data-nav-section="/contacto"
>
  <div class="scene-stage close-stage" data-close-stage>
    <div class="close-copy container-site">
      <p class="close-eyebrow">
        <span>08</span> Contacto
      </p>
      <h2 id="conversemos" class="close-title">
        ¿Tienes un proyecto? <em>Conversemos.</em>
      </h2>
      <p class="close-text">
        Cuéntanos qué necesitas y te ayudamos a definir el alcance, los plazos y
        los entregables de tu proyecto.
      </p>
      <ul class="close-links">
        <li>
          <a href={whatsappHref()} target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon />
            WhatsApp {CONTACT.whatsapp.display}
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${CONTACT.email}`}>
            <Mail size={20} stroke-width={1.75} aria-hidden="true" />
            {CONTACT.email}
          </a>
        </li>
      </ul>
    </div>

    <div class="close-drawing">
      <svg
        class="close-stroke"
        viewBox={ISOTYPE.viewBox}
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path class="close-stroke__path" d={ISOTYPE.stroke} pathLength="1" />
        <circle
          class="close-stroke__start"
          cx={ISOTYPE.start.x}
          cy={ISOTYPE.start.y}
          r={ISOTYPE.dot}
        />
      </svg>
      <a href="/contacto" class="close-cta" data-close-cta>
        <span class="close-cta__label">Cotizar proyecto</span>
        <span class="close-cta__dot" aria-hidden="true">
          <ArrowRight size={26} stroke-width={1.75} />
        </span>
      </a>
    </div>
    <p class="close-tagline" aria-hidden="true">
      {TAGLINE}
    </p>
  </div>
</section>
