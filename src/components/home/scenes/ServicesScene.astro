---
/**
 * Chapter 2 · Services, "lista y mazo" (deivid.space's projects rhythm).
 * At rest: the chapter title and the seven services as a list on the left,
 * and on the right a fanned deck of "pages", one per service: a photo of a
 * real project of that service (or, without one, its technical sketch on a
 * drawing sheet) under a bar with the service's address. Scrolling on, the
 * deck moves to the centre and grows while the text steps back, and the
 * scroll shuffles it: one service per card, named on the label below. Then
 * it goes back beside the list.
 *
 * The list holds the links; the deck is decorative. Scene:
 * src/scripts/scenes/services.ts. Without JavaScript or with reduced
 * motion the chapter is the list beside the deck at rest.
 */
import { ArrowUpRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { contentSource } from "../../../lib/content";
import { mediaPath } from "../../../lib/content/media";
import { coversByService } from "../../../lib/content/service-covers";
import { getServices } from "../../../lib/get-services";
import Croquis from "./Croquis.astro";

const services = await getServices();
const covers = coversByService(
  services.map((s) => s.data.slug),
  await contentSource().getProjects(),
);

type Photo =
  | { src: ImageMetadata; alt: string }
  | { src: string; alt: string; width: number; height: number };

const photoFor = (service: (typeof services)[number]): Photo | null => {
  const found = covers.get(service.data.slug);
  if (found)
    return {
      src: mediaPath("proyectos", found.slug, found.cover),
      alt: found.cover.alt,
      width: found.cover.width,
      height: found.cover.height,
    };
  return service.data.image
    ? { src: service.data.image, alt: service.data.imageAlt ?? "" }
    : null;
};

const pages = services.map((service, i) => ({
  service,
  number: String(i + 1).padStart(2, "0"),
  photo: photoFor(service),
}));
const total = String(services.length).padStart(2, "0");
---

<section
  class="svc-scene"
  data-scene="services"
  aria-labelledby="servicios"
  data-nav-section="/servicios"
>
  <div class="scene-stage svc-stage" data-svc-stage>
    <div class="svc-layout container-site">
      <div class="svc-text">
        <p class="svc-eyebrow">
          <span>02</span> Servicios
        </p>
        <div class="svc-fade">
          <h2 id="servicios" class="svc-title">
            Siete especialidades. Un solo <em>equipo</em>.
          </h2>
          <p class="svc-lead">
            Coordinamos todas las especialidades de tu proyecto, del primer
            croquis a la obra terminada.
          </p>
          <ol class="svc-list">
            {pages.map(({ service, number }) => (
              <li class="svc-item" data-svc-item>
                <a href={`/servicios/${service.data.slug}`}>
                  <span class="svc-item__num" aria-hidden="true">
                    {number}
                  </span>
                  <span class="svc-item__body">
                    <span class="svc-item__title">{service.data.title}</span>
                    <span class="svc-item__summary">
                      {service.data.summary}
                    </span>
                  </span>
                  <ArrowUpRight
                    size={18}
                    stroke-width={1.75}
                    aria-hidden="true"
                    class="svc-item__go"
                  />
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
      {/* Where the deck rests (measured, never shown). */}
      <span class="svc-slot" data-svc-slot aria-hidden="true"></span>
    </div>

    <div class="svc-deck-area" aria-hidden="true">
      <div class="svc-deck" data-svc-deck>
        <div class="svc-deck__cards">
          {pages.map(({ service, photo }, i) => (
            <div class="svc-page" data-svc-page>
              <div class="svc-page__bar">
                <span class="svc-page__dots">
                  <i />
                  <i />
                  <i />
                </span>
                <span class="svc-page__url">
                  emoj.cl/servicios/{service.data.slug}
                </span>
              </div>
              <div class="svc-page__view">
                {photo ? (
                  "width" in photo ? (
                    <Image
                      src={photo.src}
                      alt=""
                      width={photo.width}
                      height={photo.height}
                      widths={[480, 800, 1200, 1600]}
                      sizes="(min-width: 1024px) 66vw, 92vw"
                      loading={i < 2 ? "eager" : "lazy"}
                      class="svc-page__photo"
                    />
                  ) : (
                    <Image
                      src={photo.src}
                      alt=""
                      widths={[480, 800, 1200, 1600]}
                      sizes="(min-width: 1024px) 66vw, 92vw"
                      loading={i < 2 ? "eager" : "lazy"}
                      class="svc-page__photo"
                    />
                  )
                ) : (
                  <div class="svc-page__sheet blueprint">
                    <Croquis
                      slug={service.data.slug}
                      class="svc-page__croquis"
                    />
                  </div>
                )}
                <span class="svc-page__title">{service.data.title}</span>
              </div>
            </div>
          ))}
        </div>
        <p class="svc-deck__label">
          <span class="svc-deck__dot"></span>
          <span data-svc-label>{pages[0]?.service.data.title}</span>
          <span class="svc-deck__count">
            <span data-svc-count>01</span> / {total}
          </span>
        </p>
      </div>
    </div>
  </div>
</section>
