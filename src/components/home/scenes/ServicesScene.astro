---
/**
 * Chapter 2 · Services, "del croquis a la obra". The stage pins and the
 * seven services pass one per stretch of scroll. Each one is a drawing
 * sheet: its technical sketch (Croquis.astro) draws itself line by line,
 * then a real photo of a project of that service slides in under the pen,
 * with the sketch carrying on over it in cream (the same trick as the hero
 * lens: two copies of the sketch, one on each side of the reveal). Services
 * without a photo get a plum "inked" sheet instead. The next service enters
 * as a new sheet sliding over the last one.
 *
 * On wide screens the list of services on the left follows along (each
 * entry jumps to its service). Every sheet's caption holds the real link;
 * sheets that are not on screen are `inert`.
 *
 * Scene: src/scripts/scenes/services.ts. Without JavaScript or with reduced
 * motion the chapter is a grid of finished sheets (sketch over photo).
 */
import { ArrowRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { contentSource } from "../../../lib/content";
import { mediaPath } from "../../../lib/content/media";
import { coversByService } from "../../../lib/content/service-covers";
import { getServices } from "../../../lib/get-services";
import Croquis from "./Croquis.astro";

const services = await getServices();
const covers = coversByService(
  services.map((s) => s.data.slug),
  await contentSource().getProjects(),
);

type Photo =
  | { src: ImageMetadata; alt: string }
  | { src: string; alt: string; width: number; height: number };

const photoFor = (service: (typeof services)[number]): Photo | null => {
  const found = covers.get(service.data.slug);
  if (found)
    return {
      src: mediaPath("proyectos", found.slug, found.cover),
      alt: found.cover.alt,
      width: found.cover.width,
      height: found.cover.height,
    };
  return service.data.image
    ? { src: service.data.image, alt: service.data.imageAlt ?? "" }
    : null;
};

const sheets = services.map((service, i) => ({
  service,
  number: String(i + 1).padStart(2, "0"),
  photo: photoFor(service),
}));
const total = String(services.length).padStart(2, "0");
---

<section
  class="svc-scene"
  data-scene="services"
  aria-labelledby="servicios"
  data-nav-section="/servicios"
>
  <div class="scene-stage svc-stage">
    <div class="svc-layout container-site">
      <div class="svc-intro">
        <p class="svc-eyebrow">
          <span>02</span> Servicios · {total}
        </p>
        <h2 id="servicios" class="svc-title">
          Siete especialidades. Un solo <em>equipo</em>.
        </h2>
        <p class="svc-lead">
          Del primer croquis a la obra terminada, coordinamos todas las
          especialidades de tu proyecto.
        </p>
        <ol class="svc-nav" aria-label="Ir a un servicio">
          {sheets.map(({ service, number }, i) => (
            <li>
              <button type="button" class="svc-nav__item" data-svc-jump={i}>
                <span class="svc-nav__num">{number}</span>
                <span class="svc-nav__label">{service.data.title}</span>
                <span class="svc-nav__bar" aria-hidden="true">
                  <span data-svc-bar />
                </span>
              </button>
            </li>
          ))}
        </ol>
        <a href="/servicios" class="svc-all">
          Ver todos los servicios
          <ArrowRight size={18} stroke-width={1.75} aria-hidden="true" />
        </a>
      </div>

      <ol class="svc-sheets">
        {sheets.map(({ service, number, photo }) => (
          <li class="svc-sheet" data-svc-sheet>
            <div class="svc-sheet__visual" aria-hidden="true">
              <div class="svc-sheet__paper blueprint" />
              <Croquis slug={service.data.slug} class="svc-sheet__croquis" />
              <span class="svc-sheet__stamp">
                Lámina {number} / {total}
              </span>
              <div
                class:list={[
                  "svc-sheet__ink",
                  photo ? "svc-sheet__ink--photo" : "svc-sheet__ink--plain",
                ]}
              >
                {photo &&
                  ("width" in photo ? (
                    <Image
                      src={photo.src}
                      alt=""
                      width={photo.width}
                      height={photo.height}
                      widths={[480, 720, 960, 1280]}
                      sizes="(min-width: 1024px) 640px, 100vw"
                      loading="lazy"
                      class="svc-sheet__photo"
                    />
                  ) : (
                    <Image
                      src={photo.src}
                      alt=""
                      widths={[480, 720, 960, 1280]}
                      sizes="(min-width: 1024px) 640px, 100vw"
                      loading="lazy"
                      class="svc-sheet__photo"
                    />
                  ))}
                <Croquis
                  slug={service.data.slug}
                  class="svc-sheet__croquis svc-sheet__croquis--ink"
                />
              </div>
            </div>
            <div class="svc-sheet__caption">
              <span class="svc-sheet__num" aria-hidden="true">
                {number}
              </span>
              <div class="svc-sheet__text">
                <h3 class="svc-sheet__title">
                  <a href={`/servicios/${service.data.slug}`}>
                    {service.data.title}
                  </a>
                </h3>
                <p class="svc-sheet__summary">{service.data.summary}</p>
              </div>
              <span class="svc-sheet__go" aria-hidden="true">
                <ArrowRight size={20} stroke-width={1.75} />
              </span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
