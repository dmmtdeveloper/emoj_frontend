---
/**
 * Chapter 3 · Cómo trabajamos, "del primer trazo a la obra". One
 * engineering section builds up with the scroll, a layer per stage of an
 * EMOJ project (ObraDrawing.astro): the scope, the terrain, the studies,
 * the design and the approval stamp; at the sixth stage the photo of a
 * built work slides in under the pen, with the drawing carrying on over it
 * in cream (a second copy of the drawing).
 *
 * Every stage has two beats. First the drawing takes the whole screen while
 * the stage's layer draws, with only its number and name (the caption).
 * Scrolling on, the drawing steps aside (into the slot, `data-obra-slot`)
 * and the stage's detail comes in beside it: what it involves and two
 * facts. The next stage takes the screen again. A column of numbers on the
 * right jumps to any stage.
 *
 * Scene: src/scripts/scenes/obra.ts (beats from phaseBeats()). Without
 * JavaScript or with reduced motion the chapter is the finished drawing
 * over the photo and the six stages as a list.
 */
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import works from "../../../assets/photos/puente-llollito-excavacion.jpg";
import { WORK_STAGES } from "../../../lib/content/work-stages";
import ObraDrawing from "./ObraDrawing.astro";

const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(WORK_STAGES.length);
const last = WORK_STAGES.length - 1;
---

<section
  class="obra-scene"
  data-scene="obra"
  aria-labelledby="como-trabajamos"
  data-nav-section="/nosotros"
>
  <div class="scene-stage obra-stage" data-obra-stage>
    <div class="obra-visual" aria-hidden="true">
      <div class="obra-visual__paper blueprint"></div>
      {/* Where the drawing sits beside the detail (measured, never shown). */}
      <span class="obra-visual__slot" data-obra-slot></span>
      <ObraDrawing class="obra-visual__drawing" />
      <div class="obra-visual__ink" data-obra-ink>
        <Image
          src={works}
          alt=""
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="100vw"
          loading="lazy"
          class="obra-visual__photo"
        />
        <ObraDrawing class="obra-visual__drawing obra-visual__drawing--ink" />
        <span class="obra-visual__built">Ya es obra</span>
      </div>
    </div>

    {/* While a stage holds the screen: its number and name, large. */}
    <ol class="obra-captions container-site" aria-hidden="true">
      {WORK_STAGES.map((stage, i) => (
        <li class="obra-caption" data-obra-caption>
          <span class="obra-caption__num">{pad(i + 1)}</span>
          <span class="obra-caption__title">{stage.title}</span>
        </li>
      ))}
    </ol>

    <div class="obra-head container-site" data-obra-head>
      <p class="obra-eyebrow">
        <span>03</span> Cómo trabajamos
      </p>
      <h2 id="como-trabajamos" class="obra-title">
        Del primer trazo a la <em>obra</em>.
      </h2>
    </div>

    <ol class="obra-cards">
      {WORK_STAGES.map((stage, i) => (
        <li class="obra-card" data-obra-card>
          <p class="obra-card__step" aria-hidden="true">
            <span>{pad(i + 1)}</span> / {total}
          </p>
          <h3 class="obra-card__title">{stage.title}</h3>
          <p class="obra-card__text">{stage.text}</p>
          <dl class="obra-card__facts">
            {stage.facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
          {i === last && (
            <a href="/contacto" class="obra-card__cta">
              Cotizar proyecto
              <ArrowRight size={18} stroke-width={1.75} aria-hidden="true" />
            </a>
          )}
        </li>
      ))}
    </ol>

    <ol class="obra-nav" aria-label="Ir a una etapa">
      {WORK_STAGES.map((stage, i) => (
        <li>
          <button type="button" class="obra-nav__item" data-obra-jump={i}>
            <span class="obra-nav__num" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span class="obra-nav__bar" aria-hidden="true">
              <span data-obra-bar />
            </span>
            <span class="sr-only">{stage.title}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>
</section>
