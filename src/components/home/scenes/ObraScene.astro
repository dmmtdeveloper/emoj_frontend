---
/**
 * Chapter 3 · Cómo trabajamos, "la órbita". On plum: the chapter title and
 * a short text on the left, and on the right an orbit with EMOJ at its
 * centre and the six stages of a project on the ring, each one an icon
 * with its name outside. The scroll draws an arc around the orbit: a
 * satellite dot travels from stage to stage, the stage it reaches lights
 * up and its detail shows on the left.
 *
 * The stages are the chapter's content (the ordered list on the left); the
 * orbit is decorative. Scene: src/scripts/scenes/obra.ts. Without
 * JavaScript or with reduced motion the chapter shows the whole orbit lit
 * and the six stages listed.
 */
import {
  ArrowRight,
  FlaskConical,
  HardHat,
  MapPin,
  MessagesSquare,
  PencilRuler,
  Stamp,
} from "@lucide/astro";
import { orbitPoint } from "../../../lib/motion/scenes";
import { WORK_STAGES } from "../../../lib/content/work-stages";
import { ISOTYPE } from "./isotype";

const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(WORK_STAGES.length);
const ICONS = [
  MessagesSquare,
  MapPin,
  FlaskConical,
  PencilRuler,
  Stamp,
  HardHat,
];

/** The orbit, in the SVG's units (centre 300, 300; room for the labels). */
const CENTER = { x: 300, y: 300 };
const RING = 175;
const step = 360 / WORK_STAGES.length;
const stages = WORK_STAGES.map((stage, i) => {
  // Each stage owns a slice of the ring: its icon sits on the ring in the
  // middle of the slice, its name just outside.
  const angle = (i + 0.5) * step;
  const tile = orbitPoint(angle, RING, CENTER);
  const label = orbitPoint(angle, RING + 52, CENTER);
  const anchor =
    label.x > CENTER.x + 12
      ? "start"
      : label.x < CENTER.x - 12
        ? "end"
        : "middle";
  return {
    ...stage,
    Icon: ICONS[i] ?? MessagesSquare,
    label,
    tile,
    anchor,
    // Labels at the top and bottom sit a little away from the ring.
    dy: label.y < CENTER.y - 100 ? -4 : label.y > CENTER.y + 100 ? 12 : 4,
  };
});
const TILE = 46;
---

<section
  class="obra-scene"
  data-scene="obra"
  aria-labelledby="como-trabajamos"
  data-nav-section="/nosotros"
>
  <div class="scene-stage obra-stage" data-obra-stage>
    <div class="obra-layout container-site">
      <div class="obra-text">
        <p class="obra-eyebrow">
          <span>03</span> Cómo trabajamos
        </p>
        <h2 id="como-trabajamos" class="obra-title">
          Del primer trazo a la obra.
        </h2>
        <p class="obra-lead">
          <strong>Un solo equipo, de principio a fin.</strong> Seis etapas
          coordinadas: te acompañamos desde la primera conversación hasta que lo
          diseñado está construido.
        </p>

        <ol class="obra-stages">
          {WORK_STAGES.map((stage, i) => (
            <li class="obra-stage-item" data-obra-item>
              <p class="obra-stage-item__num">
                {pad(i + 1)} <span>/ {total}</span>
              </p>
              <h3 class="obra-stage-item__title">{stage.title}</h3>
              <p class="obra-stage-item__text">{stage.text}</p>
            </li>
          ))}
        </ol>

        <a href="/contacto" class="obra-cta">
          Cotizar proyecto
          <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
        </a>
      </div>

      <div class="obra-orbit" aria-hidden="true">
        <svg
          class="obra-orbit__svg"
          viewBox="-60 -20 720 640"
          fill="none"
          focusable="false"
        >
          <circle
            class="obra-orbit__outer"
            cx={CENTER.x}
            cy={CENTER.y}
            r="262"
          />
          <circle
            class="obra-orbit__ring"
            cx={CENTER.x}
            cy={CENTER.y}
            r={RING}
          />
          <circle
            class="obra-orbit__arc"
            cx={CENTER.x}
            cy={CENTER.y}
            r={RING}
            pathLength="1"
          />
          <g class="obra-orbit__sat">
            <circle cx={CENTER.x} cy={CENTER.y - RING} r="7" />
          </g>

          {stages.map((stage) => (
            <text
              class="obra-orbit__label"
              x={stage.label.x}
              y={stage.label.y + stage.dy}
              text-anchor={stage.anchor}
              data-obra-label
            >
              {stage.short}
            </text>
          ))}

          {stages.map((stage) => (
            <g class="obra-tile" data-obra-tile>
              <rect
                class="obra-tile__box"
                x={stage.tile.x - TILE / 2}
                y={stage.tile.y - TILE / 2}
                width={TILE}
                height={TILE}
                rx="13"
              />
              <stage.Icon
                class="obra-tile__icon"
                x={stage.tile.x - 11}
                y={stage.tile.y - 11}
                width={22}
                height={22}
                stroke-width={1.6}
              />
            </g>
          ))}

          <circle class="obra-orbit__dots" cx={CENTER.x} cy={CENTER.y} r="70" />
          <circle class="obra-orbit__core" cx={CENTER.x} cy={CENTER.y} r="58" />
          <svg
            class="obra-orbit__mark"
            x={CENTER.x - 38}
            y={CENTER.y - 26}
            width="76"
            height="30"
            viewBox={ISOTYPE.viewBox}
          >
            <path d={ISOTYPE.stroke} />
          </svg>
          <text
            class="obra-orbit__core-label"
            x={CENTER.x}
            y={CENTER.y + 24}
            text-anchor="middle"
          >
            Tu obra
          </text>
        </svg>
      </div>
    </div>
  </div>
</section>
