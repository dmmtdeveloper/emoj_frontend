---
/**
 * "La obra se arma": one engineering section (a corte, 960×600) that gains
 * a layer per stage of an EMOJ project, in pen lines:
 *
 * 0. Conversamos: the site limits, the agreed scope and what we agree on.
 * 1. Vamos a terreno: the terrain profile, survey points and two boreholes.
 * 2. Estudiamos: the soil strata, the water table and the blow counts.
 * 3. Diseñamos: a water tank on piles, its pipes and dimensions.
 * 4. Aprobamos: the title block signed and the APROBADO stamp.
 *
 * (The sixth stage, the built work, is the photo under the drawing; see
 * ObraScene.astro.) Purely decorative (`aria-hidden`).
 *
 * Motion (src/styles/scenes.css `.obra`): each layer is a `<g>` whose
 * `--obra-draw` (0..1) the scene sets; inside it every line has
 * `pathLength=1` and a draw order `k-0`…`k-8`. Labels (`k-t`) fade in at
 * the end of their layer, washes (`k-f`) with it.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/** A dashed line as short drawn segments (dash arrays are taken by the draw). */
function dashed(
  from: [number, number],
  to: [number, number],
  dash = 14,
  gap = 9,
): string {
  const [x1, y1] = from;
  const [x2, y2] = to;
  const length = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / length;
  const uy = (y2 - y1) / length;
  const parts: string[] = [];
  for (let at = 0; at < length; at += dash + gap) {
    const end = Math.min(length, at + dash);
    parts.push(
      `M${(x1 + ux * at).toFixed(1)} ${(y1 + uy * at).toFixed(1)}L${(x1 + ux * end).toFixed(1)} ${(y1 + uy * end).toFixed(1)}`,
    );
  }
  return parts.join("");
}

/** Dimension tick (short slanted mark, drafting style). */
const tick = (x: number, y: number) => `M${x - 6} ${y + 6}l12 -12`;

const GROUND = "M40 300C180 282 290 318 420 300S650 270 920 292";
const STRATA_1 = "M40 380C220 370 420 396 920 372";
const STRATA_2 = "M40 462C260 474 520 450 920 466";
---

<svg
  viewBox="0 0 960 600"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class:list={["obra", className]}
>
  {/* 0 · Conversamos: limits and scope. */}
  <g class="obra-layer" data-obra-layer>
    <path class="k k-0" pathLength="1" d={dashed([150, 70], [150, 560])} />
    <path class="k k-0" pathLength="1" d={dashed([810, 70], [810, 560])} />
    <path
      class="k k-1 k-thin"
      pathLength="1"
      d={`M150 46H810${tick(150, 46)}${tick(810, 46)}`}
    />
    <text class="k-t" x="480" y="34" text-anchor="middle">
      Alcance acordado · 120 m
    </text>
    <text class="k-t" x="798" y="92" text-anchor="end">
      Predio
    </text>
    {/* What we agree on, ticked one by one. */}
    <path
      class="k k-2 k-thin"
      pathLength="1"
      d="M180 84H194V98H180ZM180 110H194V124H180ZM180 136H194V150H180Z"
    />
    <path
      class="k k-3"
      pathLength="1"
      d="M183 91L186 95L192 86M183 117L186 121L192 112M183 143L186 147L192 138"
    />
    <text class="k-t" x="204" y="96">
      Alcance
    </text>
    <text class="k-t" x="204" y="122">
      Plazos
    </text>
