    <path class="k k-0 k-bold" pathLength="1" d={GROUND} />
    <path class="k k-1" pathLength="1" d="M222 300L230 284L238 300Z" />
    <path class="k k-2" pathLength="1" d="M872 296L880 280L888 296Z" />
    <path class="k k-3" pathLength="1" d="M712 288L720 272L728 288Z" />
    <path class="k k-4" pathLength="1" d="M296 308H308V520H296Z" />
    <path class="k k-5" pathLength="1" d="M646 290H658V520H646Z" />
    <text class="k-t" x="230" y="270" text-anchor="middle">
      +102,4
    </text>
    <text class="k-t" x="880" y="266" text-anchor="middle">
      +102,9
    </text>
    <text class="k-t" x="720" y="258" text-anchor="middle">
