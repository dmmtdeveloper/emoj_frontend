  </g>

  {/* 4 · Aprobamos: the title block signed, then the stamp. */}
  <g class="obra-layer" data-obra-layer>
    <path class="k k-0 k-thin" pathLength="1" d="M700 522H920V586H700Z" />
    <path class="k k-1 k-thin" pathLength="1" d="M700 544H920M780 522V586" />
    <path
      class="k k-2"
      pathLength="1"
      d="M796 566L806 576L826 554M856 566L866 576L886 554"
    />
    <text class="k-t k-t--small" x="708" y="538">
      Proyecto
    </text>
    <text class="k-t k-t--small" x="708" y="568">
      Revisó
    </text>
    <text class="k-t k-t--small" x="788" y="538">
