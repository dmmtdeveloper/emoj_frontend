      pathLength="1"
      d={dashed([40, 420], [920, 420], 10, 8)}
    />
    <path class="k k-3" pathLength="1" d="M852 404H868L860 414Z" />
    <path
      class="k k-4 k-thin"
      pathLength="1"
      d="M280 362H296M280 440H296M668 350H684M668 500H684"
    />
    <text class="k-t" x="56" y="350">
      Relleno
