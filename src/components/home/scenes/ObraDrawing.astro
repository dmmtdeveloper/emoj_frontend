    />
    <path
      class="k k-7 k-thin"
      pathLength="1"
      d={`M640 160V330${tick(640, 160)}${tick(640, 330)}`}
    />
    <path
      class="k k-8 k-thin"
      pathLength="1"
      d={`M370 96H590${tick(370, 96)}${tick(590, 96)}`}
    />
    <text class="k-t" x="480" y="270" text-anchor="middle">
      Estanque 500 m³
    </text>
    <text class="k-t" x="650" y="214">
      H = 6,0 m
    </text>
    <text class="k-t" x="480" y="84" text-anchor="middle">
