---
/**
 * Chapter 4 · "El plano". A CAD screen in EMOJ plum: a grid, the
 * crosshair, the command line and the status bar, and a site plan
 * (cad-plan.ts) drawn layer by layer as the commands are typed: topography,
 * road, sewer, buildings, dimensions and the EMOJ title block. The first
 * layers draw themselves when the chapter comes into view; the scroll draws
 * the rest. Then a "zoom window" is dragged over the pump station, the
 * photo of a built pump station appears inside it and the zoom takes it to
 * the full screen: from the plan to the built work, right before the
 * projects.
 *
 * Scene: src/scripts/scenes/plano.ts (progress from src/scripts/scenes.ts).
 * Without JavaScript or with reduced motion the chapter is the finished
 * state: the photo with the copy on top, no CAD screen and no pinning.
 */
import { ArrowRight } from "@lucide/astro";
import { Picture } from "astro:assets";
import pumping from "../../../assets/photos/estacion-bombeo-tuberias.jpg";
import { PLAN } from "./cad-plan";
import { ISOTYPE } from "./isotype";

const year = new Date().getFullYear();

/**
 * The plan's layers, drawn in this order, each with the command typed for
 * it (`weight`: its share of the drawing time).
 */
const STEPS = [
  {
    layer: "Topografía",
    command: "SPLINE",
    detail: "Curvas de nivel c/ 1 m",
    weight: 1,
  },
  {
    layer: "Vialidad",
    command: "POLILINEA",
    detail: "Eje de calzada · DESFASE 3.50",
    weight: 1.3,
  },
  {
    layer: "Sanitario",
    command: "CIRCULO",
    detail: "Cámaras C-1 a C-6 · Colector Ø400",
    weight: 1.2,
  },
  {
    layer: "Edificación",
    command: "RECTANG",
    detail: "Planta elevadora PE-1 · Lotes",
    weight: 1,
  },
  {
    layer: "Cotas",
    command: "ACOTAR",
    detail: "Alineada 45.00 · Ancho 7.00",
    weight: 0.8,
  },
  {
    layer: "Rótulo",
    command: "INSERTAR",
    detail: "Rótulo EMOJ · Lámina 01",
    weight: 0.9,
  },
] as const;

const station = PLAN.station;
const win = PLAN.window;
---

<section
  class="plano-scene"
  data-scene="plano"
  data-nav-section="/proyectos"
  aria-labelledby="plano-title"
>
  <div class="scene-stage plano-stage" data-plano-stage>
    {/* The photo: inside the zoom window first, then the whole screen. */}
    <div class="plano-photo" data-plano-photo aria-hidden="true">
      <Picture
        src={pumping}
        alt=""
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        class="plano-photo__img"
        pictureAttributes={{ class: "contents" }}
      />
      <div class="plano-photo__veil"></div>
    </div>

    {/* The CAD screen: model space (grid and plan) and its chrome. */}
    <div class="plano-cad" aria-hidden="true">
      <div class="plano-world" data-plano-world>
        <div class="plano-grid"></div>
        <svg
          class="plano-plan"
          viewBox="0 0 1000 700"
          fill="none"
          focusable="false"
          data-plano-plan
        >
          <g
            class="cad-step cad-topo"
            data-cad-step
            data-layer={STEPS[0].layer}
            data-command={`${STEPS[0].command}  ${STEPS[0].detail}`}
            data-weight={STEPS[0].weight}
          >
            {PLAN.topo.map((c) => (
              <>
                <path class="cad-line" d={c.d} pathLength="1" />
                <text
                  class="cad-label"
                  x={c.label.x}
                  y={c.label.y}
                  transform={`rotate(${c.label.angle} ${c.label.x} ${c.label.y})`}
                >
                  {c.label.text}
                </text>
              </>
            ))}
          </g>

          <g
            class="cad-step cad-road"
            data-cad-step
            data-layer={STEPS[1].layer}
            data-command={`${STEPS[1].command}  ${STEPS[1].detail}`}
            data-weight={STEPS[1].weight}
          >
            {PLAN.curbs.map((d) => (
              <path class="cad-line" d={d} pathLength="1" />
            ))}
            <path class="cad-line cad-axis" d={PLAN.axis} pathLength="1" />
            {PLAN.side.curbs.map((d) => (
              <path class="cad-line" d={d} pathLength="1" />
            ))}
            <path class="cad-line cad-axis" d={PLAN.side.axis} pathLength="1" />
            {PLAN.props.map((d) => (
              <path class="cad-line cad-prop" d={d} pathLength="1" />
            ))}
            {PLAN.stations.map((st) => (
              <>
                <path class="cad-line" d={st.d} pathLength="1" />
                <text
                  class="cad-label"
                  x={st.label.x}
                  y={st.label.y}
                  transform={`rotate(${st.label.angle} ${st.label.x} ${st.label.y})`}
                >
                  {st.label.text}
                </text>
              </>
            ))}
          </g>

          <g
            class="cad-step cad-sewer"
            data-cad-step
            data-layer={STEPS[2].layer}
            data-command={`${STEPS[2].command}  ${STEPS[2].detail}`}
            data-weight={STEPS[2].weight}
          >
            <path class="cad-line" d={PLAN.collector} pathLength="1" />
            <text
              class="cad-label"
              x={PLAN.pipe.x}
              y={PLAN.pipe.y}
              transform={`rotate(${PLAN.pipe.angle} ${PLAN.pipe.x} ${PLAN.pipe.y})`}
            >
              {PLAN.pipe.text}
            </text>
            {PLAN.manholes.map((m) => (
              <>
                <circle
                  class="cad-line"
                  cx={m.x}
                  cy={m.y}
                  r="6"
                  pathLength="1"
                />
                <text class="cad-label" x={m.label.x} y={m.label.y}>
                  {m.label.text}
                </text>
              </>
            ))}
            <path class="cad-line" d={PLAN.forceMain} pathLength="1" />
          </g>

          <g
            class="cad-step cad-build"
            data-cad-step
            data-layer={STEPS[3].layer}
            data-command={`${STEPS[3].command}  ${STEPS[3].detail}`}
            data-weight={STEPS[3].weight}
          >
            {PLAN.lots.map((d) => (
              <path class="cad-line cad-lot" d={d} pathLength="1" />
            ))}
            {PLAN.houses.map((d) => (
              <path class="cad-line cad-lot" d={d} pathLength="1" />
            ))}
            <g
              transform={`translate(${station.x} ${station.y}) rotate(${station.angle})`}
            >
              <rect
                class="cad-line"
                x={-station.w / 2}
                y={-station.h / 2}
                width={station.w}
                height={station.h}
                pathLength="1"
              />
              <circle class="cad-line" cx="-30" cy="0" r="16" pathLength="1" />
              <path class="cad-line" d="M-6 -35V35M-6 0H60" pathLength="1" />
              <path
                class="cad-line cad-prop"
                d={station.fence}
                pathLength="1"
              />
              <text class="cad-label" x="-78" y="68">
                {station.text}
              </text>
            </g>
          </g>

          <g
            class="cad-step cad-dims"
            data-cad-step
            data-layer={STEPS[4].layer}
            data-command={`${STEPS[4].command}  ${STEPS[4].detail}`}
            data-weight={STEPS[4].weight}
          >
            {PLAN.dims.map((dim) => (
              <>
                {dim.lines.map((d) => (
                  <path class="cad-line" d={d} pathLength="1" />
                ))}
                <text
                  class="cad-label cad-label--mid"
                  x={dim.text.x}
                  y={dim.text.y}
                  transform={`rotate(${dim.text.angle} ${dim.text.x} ${dim.text.y})`}
                >
                  {dim.text.text}
                </text>
              </>
            ))}
          </g>

          <g
            class="cad-step cad-block"
            data-cad-step
            data-layer={STEPS[5].layer}
            data-command={`${STEPS[5].command}  ${STEPS[5].detail}`}
            data-weight={STEPS[5].weight}
          >
            {/* North arrow. */}
            <circle class="cad-line" cx="948" cy="62" r="20" pathLength="1" />
            <path
              class="cad-line"
              d="M948 34L958 72L948 64L938 72Z"
              pathLength="1"
            />
            <text class="cad-label cad-label--mid" x="948" y="28">
              N
            </text>
            {/* Title block, with the isotype. */}
            <rect class="cad-sheet" x="702" y="606" width="290" height="86" />
            <path class="cad-line" d="M702 606H992V692H702Z" pathLength="1" />
            <path
              class="cad-line"
              d="M782 606V692M782 636H992M782 664H992"
              pathLength="1"
            />
            <svg
              x="708"
              y="626"
              width="68"
              height="40"
              viewBox={ISOTYPE.viewBox}
              class="cad-isotype"
            >
              <path class="cad-line" d={ISOTYPE.stroke} pathLength="1" />
            </svg>
            <text class="cad-label cad-label--strong" x="792" y="627">
              EMOJ Consultora
            </text>
            <text class="cad-label" x="792" y="655">
              Planta general · Alcantarillado
            </text>
            <text class="cad-label" x="792" y="683">
              Esc. 1:500 · Lám. 01 · {year}
            </text>
          </g>

          {/* The zoom window, dragged from its top-left corner. */}
          <rect
            class="plano-window"
            x={win.x}
            y={win.y}
            width={win.w}
            height={win.h}
            data-plano-window
          />
        </svg>
      </div>

      <span class="plano-cad__veil"></span>

      {/* Crosshair cursor with its pickbox. */}
      <span class="plano-cursor" data-plano-cursor>
        <span class="plano-cursor__box"></span>
      </span>

      {/* UCS icon. */}
      <svg class="plano-ucs" viewBox="0 0 48 48" focusable="false">
        <path class="plano-ucs__x" d="M6 42H40M34 38L40 42L34 46" />
        <path class="plano-ucs__y" d="M6 42V8M2 14L6 8L10 14" />
        <text x="42" y="40">
          X
        </text>
        <text x="10" y="8">
          Y
        </text>
      </svg>

      {/* Command line and status bar. */}
      <div class="plano-cmd" data-plano-cmd>
        <p class="plano-cmd__history" data-plano-history></p>
        <p class="plano-cmd__line">
          <span class="plano-cmd__prompt">Comando:</span>
          <span data-plano-typed></span>
          <span class="plano-cmd__caret"></span>
          <span class="plano-cmd__hint" data-plano-hint hidden>
            Desliza para seguir dibujando
          </span>
        </p>
      </div>
      <div class="plano-status">
        <span class="plano-status__xy" data-plano-xy>
          X 4200.00 Y 6150.00
        </span>
        <span class="plano-status__layer">
          <span class="plano-status__swatch" data-plano-swatch></span>
          Capa: <span data-plano-layer>0</span>
        </span>
        <span class="plano-status__toggles">
          <span>Rejilla</span>
          <span>Orto</span>
          <span>Polar</span>
          <span>Refent</span>
        </span>
      </div>
    </div>

    <div class="plano-copy container-site">
      <div class="plano-copy__inner">
        <p class="plano-copy__eyebrow">
          <span>04</span> Ingeniería
        </p>
        <h2 id="plano-title" class="plano-copy__title">
          Cada obra empieza en <em>un plano.</em>
        </h2>
        <p class="plano-copy__lead">
          Topografía, vialidad, redes sanitarias y estructuras en un mismo
          proyecto, coordinadas desde la primera línea hasta la obra construida.
        </p>
        <a class="plano-copy__link" href="/proyectos">
          Ver proyectos
          <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
        </a>
      </div>
    </div>

    <p class="plano-caption container-site" aria-hidden="true">
      Planta elevadora · ya construida
    </p>
  </div>
</section>
