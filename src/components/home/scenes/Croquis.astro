---
/**
 * A technical sketch ("croquis") per service, drawn as pen lines in a
 * 480×360 sheet: a pipe network, a road in perspective, a loaded beam, an
 * intersection, a building elevation, a soil profile with a borehole and a
 * street section under rain. Purely decorative (`aria-hidden`).
 *
 * Motion (src/styles/scenes.css `.croquis`): every line has `pathLength=1`
 * and a draw order `k-0`…`k-9`; the scene sets `--svc-draw` (0..1) and the
 * lines draw in that order. `k-t` labels fade in at the end, `k-f` washes
 * only show in the inked layer (over the photo).
 */
import type { ServiceSlug } from "../../../lib/api/client";

interface Props {
  slug: ServiceSlug;
  class?: string;
}

const { slug, class: className } = Astro.props;

/** A circle as a path (so it can be drawn with pathLength like a line). */
const ring = (cx: number, cy: number, r: number) =>
  `M${cx - r},${cy}a${r},${r} 0 1,0 ${2 * r},0a${r},${r} 0 1,0 ${-2 * r},0`;
/** Dimension tick (short slanted mark, drafting style). */
const tick = (x: number, y: number) => `M${x - 5},${y + 5}l10,-10`;
