---
/**
 * Sticky site header: a floating capsule, centred and inset from the top,
 * with the isotype (+ "EMOJ" wordmark on the home page), the primary
 * navigation as pill links and a compact quote CTA.
 *
 * - The capsule is frosted `surface` with a hairline border and a soft
 *   shadow, on every page and at every scroll position.
 * - `overlay`: the page starts with a full-bleed photo hero. Over it the
 *   capsule is dark glass with cream text, and it turns into the frosted
 *   surface once the page scrolls (CSS scroll timeline, with an
 *   IntersectionObserver fallback in src/scripts/motion.ts). Without either
 *   it stays solid.
 * - Below `lg` the navigation moves into a full-screen modal <dialog>
 *   (native focus containment, Escape to close, focus returns to the toggle).
 */
import { Menu, X } from "@lucide/astro";
import { CONTACT, NAV, isCurrent } from "../../lib/site";
import IsotipoMark from "../IsotipoMark.astro";
import Wordmark from "../Wordmark.astro";
import ButtonLink from "../ui/ButtonLink.astro";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname;
// The mark draws itself on the home page, where the story starts.
const drawMark = pathname === "/";
---

<header
  data-site-header
  data-overlay={overlay ? "" : undefined}
  class="site-header pointer-events-none sticky top-0 z-40 flex h-(--header-h) items-center px-3 md:px-6"
>
  <div class="site-header__bar pointer-events-auto relative isolate mx-auto flex h-14 w-full max-w-[960px] items-center justify-between gap-4 rounded-full pr-2 pl-5 md:pl-6">
    <div
      class="site-header__backdrop absolute inset-0 -z-10 rounded-full"
      aria-hidden="true"
    ></div>
    <div
      class="site-header__glass absolute inset-0 -z-10 rounded-full"
      aria-hidden="true"
    ></div>
    <a
      href="/"
      class="mark-link relative -m-2 inline-flex shrink-0 items-center p-2 text-current no-underline hover:text-current"
    >
      <IsotipoMark
        label="EMOJ Consultora — Inicio"
        draw={drawMark}
        width="72"
        height="26"
        class="h-6 w-auto lg:h-[26px]"
      />
      {/* Home only: the name is written after the mark, then erased. It is
          out of the flow, so the header layout is the mark alone. */}
      {drawMark && (
        <Wordmark
          draw
          class="pointer-events-none absolute top-1/2 left-full ml-0.5 h-[19px] w-auto -translate-y-1/2 lg:h-5"
        />
      )}
    </a>

    <nav aria-label="Principal" class="hidden lg:block" data-nav-spy>
      <ul class="relative flex items-center gap-0.5">
        {/* Sliding highlight, positioned by src/scripts/nav-spy.ts. */}
        <span
          class="nav-indicator pointer-events-none absolute inset-0 rounded-full bg-current/10"
          aria-hidden="true"
          data-nav-indicator
        ></span>
        {NAV.map(({ label, href }) => {
          const current = isCurrent(href, pathname);
          return (
            <li>
              <a
                href={href}
                aria-current={current ? "page" : undefined}
                data-nav-link={href}
                data-active={current ? "" : undefined}
                class="nav-link relative inline-flex h-9 items-center rounded-full px-3.5 text-[15px] leading-5 font-medium text-current no-underline transition-colors duration-200 hover:bg-current/5 hover:text-current"
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <div class="hidden sm:block">
        <ButtonLink href="/contacto" pill>
          Cotizar proyecto
        </ButtonLink>
      </div>
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-full text-current transition-colors hover:bg-current/10 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-open
      >
        <Menu size={22} stroke-width={1.75} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<dialog
  id="menu-movil"
  aria-label="Menú"
  class="menu-overlay m-0 h-dvh max-h-none w-full max-w-none bg-surface-inverse p-0 text-ink-inverse lg:hidden"
  data-menu
>
  <div class="container-site flex h-full flex-col">
    <div class="flex h-(--header-h) shrink-0 items-center justify-between">
      <span class="eyebrow eyebrow-inverse">Menú</span>
      <button
        type="button"
        class="inline-flex min-h-10 items-center gap-2 rounded-full px-3.5 text-[15px] leading-5 font-medium text-ink-inverse hover:bg-ink-inverse/10"
        data-menu-close
      >
        <X size={20} stroke-width={1.75} aria-hidden="true" />
        Cerrar
      </button>
    </div>
    <nav aria-label="Principal móvil" class="flex-1 overflow-y-auto py-4">
      <ul class="menu-links flex flex-col">
        {NAV.map(({ label, href }, index) => {
          const current = isCurrent(href, pathname);
          return (
            <li>
              <a
                href={href}
                aria-current={current ? "page" : undefined}
                class:list={[
                  "flex min-h-14 items-baseline gap-4 py-1 text-[clamp(2rem,9vw,2.75rem)] leading-[1.15] font-semibold tracking-[-0.03em] text-ink-inverse no-underline hover:text-ink-inverse",
                  current
                    ? "underline decoration-2 underline-offset-[0.18em]"
                    : "hover:underline hover:decoration-2 hover:underline-offset-[0.18em]",
                ]}
              >
                <span
                  aria-hidden="true"
                  class="w-7 shrink-0 text-sm leading-5 font-medium tracking-normal tabular-nums opacity-75"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="flex shrink-0 flex-col gap-4 pt-4 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
      <IsotipoMark
        tone="mono"
        draw
        width="160"
        height="58"
        class="menu-mark h-auto w-40 self-end opacity-80"
      />
      <ButtonLink href="/contacto" variant="on-inverse" class="w-full">
        Cotizar proyecto
      </ButtonLink>
      <a
        href={CONTACT.whatsapp.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center justify-center font-semibold text-ink-inverse underline-offset-4 hover:text-ink-inverse hover:underline"
      >
        WhatsApp {CONTACT.whatsapp.display}
      </a>
    </div>
  </div>
</dialog>

<script>
  import "../../scripts/nav-spy";

  const dialog = document.querySelector<HTMLDialogElement>("[data-menu]");
  const openButton =
    document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton =
    document.querySelector<HTMLButtonElement>("[data-menu-close]");

  if (dialog && openButton && closeButton) {
    openButton.addEventListener("click", () => {
      dialog.showModal();
      openButton.setAttribute("aria-expanded", "true");
    });
    closeButton.addEventListener("click", () => dialog.close());
    // Fires for the close button, Escape and navigation alike.
    dialog.addEventListener("close", () => {
      openButton.setAttribute("aria-expanded", "false");
      openButton.focus();
    });
    // Leaving the mobile layout with the menu open closes it.
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
</script>

<style>
  /*
   * The highlighted link: a filled pill on the link itself without the
   * script; with it (`data-spy-ready`) one shared pill slides between links
   * as the page scrolls through their sections (clip-path, see nav-spy.ts).
   */
  .nav-indicator {
    display: none;
  }

  .nav-link[data-active] {
    background-color: color-mix(in oklab, currentColor 10%, transparent);
  }

  [data-spy-ready] .nav-link[data-active] {
    background-color: transparent;
  }

  [data-spy-ready] .nav-indicator {
    display: block;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  [data-spy-ready] .nav-indicator[data-visible] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-spy-ready] .nav-indicator[data-moved] {
      transition:
        clip-path 450ms var(--ease-out),
        opacity 200ms ease;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-overlay[open] {
      animation: fade-in 260ms var(--ease-out) both;
    }

    .menu-overlay[open] .menu-links > li {
      animation: rise 520ms var(--ease-out) both;
    }

    .menu-overlay[open] .menu-links > li:nth-child(1) {
      animation-delay: 120ms;
    }
    .menu-overlay[open] .menu-links > li:nth-child(2) {
      animation-delay: 170ms;
    }
    .menu-overlay[open] .menu-links > li:nth-child(3) {
      animation-delay: 220ms;
    }
    .menu-overlay[open] .menu-links > li:nth-child(4) {
      animation-delay: 270ms;
    }
    .menu-overlay[open] .menu-links > li:nth-child(5) {
      animation-delay: 320ms;
    }
    .menu-overlay[open] .menu-links > li:nth-child(6) {
      animation-delay: 370ms;
    }
  }
</style>
