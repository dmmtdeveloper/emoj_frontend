---
/**
 * Site footer on `surface-inverse` (the second inverse section of a page).
 *
 * - Top: logo, a short description of the firm and the email as the main
 *   way to start a conversation.
 * - Columns: every service (internal links that also help SEO), company
 *   pages, direct contact and social profiles with their names.
 * - Bottom bar: legal line, location, the Ley 21.719 notice with links to
 *   the privacy policy and to exercising rights, "back to top" and the
 *   credit to the studio that built the site (deivid.space).
 *
 * Only inverse tokens (with opacity) are used, so it works in both themes;
 * `brand` on plum is a forbidden pair. A faint isotype stroke signs the
 * corner. The bottom bar leaves room for the floating WhatsApp button on
 * mobile.
 */
import { ArrowUp, ArrowUpRight, ShieldCheck } from "@lucide/astro";
import { getServices } from "../../lib/get-services";
import {
  CONTACT,
  LEGAL_NAME,
  RUT,
  SITE_NAME,
  SOCIAL,
  TAGLINE,
} from "../../lib/site";
import LogoLockup from "../LogoLockup.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import StrokeLine from "../ui/StrokeLine.astro";

const year = new Date().getFullYear();
const legalLink =
  "inline-flex min-h-11 items-center self-start font-medium text-ink-inverse/80 underline-offset-4 hover:text-ink-inverse hover:underline sm:self-auto md:min-h-9";
const legalLine = `© ${year} ${LEGAL_NAME} · RUT ${RUT} · Quilpué, Región de Valparaíso, Chile`;
const services = await getServices();

const COMPANY = [
  { label: "Nosotros", href: "/nosotros" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Noticias", href: "/noticias" },
  { label: "Contacto", href: "/contacto" },
] as const;

const heading = "eyebrow eyebrow-inverse text-ink-inverse/70";
const link =
  "text-ink-inverse/80 underline-offset-4 transition-colors duration-200 hover:text-ink-inverse hover:underline";
---

<footer class="relative isolate overflow-clip bg-surface-inverse text-ink-inverse">
  <StrokeLine class="absolute -right-40 -bottom-24 -z-10 w-[720px] text-ink-inverse opacity-[0.07] md:-right-24 md:w-[980px]" />

  <div class="container-site">
    {/* Brand and main contact */}
    <div class="grid gap-10 py-16 md:pt-20 md:pb-16 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="flex flex-col gap-6 lg:col-span-6">
        <LogoLockup
          draw="view"
          label={SITE_NAME}
          width="200"
          height="101"
          class="h-auto w-[200px]"
        />
        <p class="max-w-[46ch] text-base leading-7 text-ink-inverse/80">
          Consultora de ingeniería civil con base en Quilpué. Diseñamos agua
          potable, caminos, estructuras y fundaciones para las regiones de
          Valparaíso y Coquimbo. {TAGLINE}.
        </p>
      </div>
      <div class="flex flex-col gap-3 lg:col-span-6 lg:items-end lg:text-right">
        <p class="text-sm leading-5 font-medium text-ink-inverse/70">
          ¿Tienes un proyecto en mente? Escríbenos
        </p>
        <a
          href={`mailto:${CONTACT.email}`}
          class="group inline-flex items-center gap-3 text-[clamp(1.5rem,1.1rem+1.6vw,2.25rem)] leading-tight font-semibold tracking-[-0.01em] text-ink-inverse no-underline hover:text-ink-inverse"
        >
          <span class="bg-linear-to-r from-current to-current bg-[length:0%_2px] bg-left-bottom bg-no-repeat pb-1 transition-[background-size] duration-300 group-hover:bg-[length:100%_2px] group-focus-visible:bg-[length:100%_2px]">
            {CONTACT.email}
          </span>
          <ArrowUpRight
            size={28}
            stroke-width={1.75}
            aria-hidden="true"
            class="shrink-0 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
          />
        </a>
      </div>
    </div>

    {/* Link columns */}
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 border-t border-ink-inverse/15 py-12 md:gap-y-12 md:py-16 lg:grid-cols-12 lg:gap-x-8">
      <nav
        aria-labelledby="footer-servicios"
        class="flex flex-col gap-4 md:gap-5 lg:col-span-4"
      >
        <h2 id="footer-servicios" class={heading}>
          Servicios
        </h2>
        <ul class="flex flex-col">
          {services.map(({ data }) => (
            <li>
              <a
                class={`${link} inline-flex min-h-11 items-center py-1 leading-5 md:min-h-9`}
                href={`/servicios/${data.slug}`}
              >
                {data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav
        aria-labelledby="footer-empresa"
        class="flex flex-col gap-4 md:gap-5 lg:col-span-2"
      >
        <h2 id="footer-empresa" class={heading}>
          Empresa
        </h2>
        <ul class="flex flex-col">
          {COMPANY.map(({ label, href }) => (
            <li>
              <a
                class={`${link} inline-flex min-h-11 items-center py-1 leading-5 md:min-h-9`}
                href={href}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="order-first col-span-2 flex flex-col gap-4 md:gap-5 lg:order-none lg:col-span-3">
        <h2 class={heading}>Contacto</h2>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-4 text-base leading-6 lg:flex lg:flex-col">
          <div class="flex flex-col gap-1">
            <dt class="text-sm leading-5 text-ink-inverse/60">Teléfonos</dt>
            {CONTACT.phones.map((phone) => (
              <dd>
                <a class={link} href={phone.href}>
                  {phone.display}
                </a>
              </dd>
            ))}
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-sm leading-5 text-ink-inverse/60">WhatsApp</dt>
            <dd>
              <a
                class={link}
                href={CONTACT.whatsapp.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {CONTACT.whatsapp.display}
              </a>
            </dd>
          </div>
          <div class="col-span-2 flex flex-col gap-1">
            <dt class="text-sm leading-5 text-ink-inverse/60">Oficina</dt>
            <dd>
              <a
                class={link}
                href={CONTACT.mapsHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                <address class="not-italic">
                  {CONTACT.address.street}
                  <br />
                  {CONTACT.address.locality}, {CONTACT.address.region}
                </address>
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="col-span-2 flex flex-col gap-4 md:gap-5 lg:col-span-3">
        <h2 class={heading}>Síguenos</h2>
        <ul class="flex gap-3 lg:flex-col lg:gap-1">
          {SOCIAL.map(({ name, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={`${link} group inline-flex min-h-11 items-center gap-3 md:min-h-9`}
              >
                <span class="inline-flex size-11 items-center justify-center rounded-full border border-ink-inverse/25 transition-colors duration-200 group-hover:border-ink-inverse group-hover:bg-ink-inverse group-hover:text-surface-inverse lg:size-9">
                  <SocialIcon name={name} size={20} />
                </span>
                <span class="sr-only lg:not-sr-only">{name}</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  {/* Legal bar */}
  <div class="border-t border-ink-inverse/15">
    <div class="container-site flex flex-col gap-4 py-6 pb-28 text-sm leading-5 text-ink-inverse/70 sm:flex-row sm:items-center sm:justify-between sm:gap-3 lg:pb-6 lg:max-[1319px]:pr-24">
      <div class="flex flex-col gap-2">
        <p>{legalLine}</p>
        {/* Ley 21.719 (in force from 2026-12-01): the policy and the rights. */}
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-4">
          <p class="flex items-start gap-2">
            <ShieldCheck
              size={16}
              stroke-width={1.75}
              aria-hidden="true"
              class="mt-0.5 shrink-0"
            />
            Tratamos tus datos personales conforme a la Ley&nbsp;21.719.
          </p>
          <div class="flex flex-wrap gap-x-5">
            <a href="/privacidad" class={legalLink}>
              Política de privacidad
            </a>
            <a href="/privacidad#derechos" class={legalLink}>
              Ejercer tus derechos
            </a>
          </div>
        </div>
      </div>
      {/* Phones: credit on the left, "back to top" on the right. */}
      <div class="flex flex-row-reverse items-center justify-between gap-4 border-t border-ink-inverse/10 pt-2 sm:flex-col sm:items-end sm:gap-1 sm:border-0 sm:pt-0">
        <a
          href="#top"
          class="group inline-flex min-h-11 items-center gap-2 font-medium text-ink-inverse/80 no-underline hover:text-ink-inverse md:min-h-9"
        >
          Volver arriba
          <ArrowUp
            size={16}
            stroke-width={2}
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:-translate-y-0.5"
          />
        </a>
        {/* Credit to the studio that built the site. */}
        <p>
          Realizado por{" "}
          <a
            href="https://deivid.space"
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 items-center font-medium text-ink-inverse/80 underline-offset-4 hover:text-ink-inverse hover:underline md:min-h-9"
          >
            deivid.space
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
