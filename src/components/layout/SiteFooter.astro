---
/**
 * Site footer, laid out like deivid.space's: on the sunken surface with a
 * hairline on top, the same width as the home (`container-wide`).
 *
 * - Signature band: the official lockup (fine stroke), drawn once when it
 *   comes into view, beside the tagline "Acercamos la ingeniería" in large
 *   type with a short description of the firm.
 * - Columns: the services (internal links that also help SEO), the company pages,
 *   legal (privacy policy and rights under Ley 21.719), social profiles
 *   and direct contact.
 * - Bottom bar: the isotype, the legal line (name, RUT, place) and the
 *   credit to the studio that built the site, "back to top" and the social
 *   icons. It leaves room for the floating WhatsApp button on phones.
 *
 * Semantic tokens only, so it works in both themes.
 */
import {
  ArrowUp,
  ArrowUpRight,
  Mail,
  MapPin,
  Phone,
  ShieldCheck,
} from "@lucide/astro";
import { getServices } from "../../lib/get-services";
import {
  CONTACT,
  LEGAL_NAME,
  RUT,
  SITE_NAME,
  SOCIAL,
  TAGLINE,
} from "../../lib/site";
import IsotipoMark from "../IsotipoMark.astro";
import LogoLockup from "../LogoLockup.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import StrokeLine from "../ui/StrokeLine.astro";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";

const year = new Date().getFullYear();
const services = await getServices();

const COMPANY = [
  { label: "Nosotros", href: "/nosotros" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Noticias", href: "/noticias" },
  { label: "Contacto", href: "/contacto" },
] as const;

const LEGAL = [
  { label: "Política de privacidad", href: "/privacidad" },
  { label: "Ejercer tus derechos", href: "/privacidad#derechos" },
] as const;

const heading =
  "font-data text-[11px] leading-4 font-semibold tracking-[0.16em] text-ink uppercase";
const list = "mt-4 grid gap-2.5";
const link =
  "text-sm leading-5 text-ink-muted no-underline transition-colors duration-200 hover:text-ink";
const meta =
  "font-data text-[11px] leading-4 tracking-[0.1em] text-ink-muted uppercase";
---

<footer
  class="relative border-t border-border bg-surface-sunken text-ink"
  aria-label="Pie de página"
>
  <div class="container-wide pt-12 pb-5 md:pt-16">
    {/* The signature band: the lockup drawn again when it comes into
        view (the old footer's animation), next to the brand's tagline. */}
    <div
      class="footer-sign relative isolate grid gap-10 border-b border-border pb-12 md:pb-14 lg:grid-cols-12 lg:items-end lg:gap-8"
      data-draw-on-view
    >
      <StrokeLine class="footer-sign__wave absolute -top-6 right-0 -z-10 hidden w-[min(52rem,62%)] text-brand opacity-[0.14] lg:block" />
      <a
        href="/"
        class="inline-flex self-start text-brand no-underline lg:col-span-4"
        aria-label={`${SITE_NAME} — Inicio`}
      >
        <LogoLockup
          label=""
          width="240"
          height="121"
          class="h-auto w-48 md:w-60"
        />
      </a>
      <div class="lg:col-span-8">
        <p class="footer-sign__tagline" lang="es">
          {TAGLINE.split(" ").map((word, i, words) => (
            <span class="footer-sign__word">
              {i === words.length - 1 ? <em>{word}</em> : word}
            </span>
          ))}
          <span class="footer-sign__dot" aria-hidden="true"></span>
        </p>
        <p class="footer-sign__text mt-5 max-w-[52ch] text-base leading-7 text-ink-muted">
          Consultora de ingeniería civil con base en Quilpué. Diseñamos agua
          potable, caminos, estructuras y fundaciones para las regiones de
          Valparaíso y Coquimbo.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 border-b border-border py-10 sm:gap-10 md:py-12 lg:grid-cols-5 lg:gap-8 xl:grid-cols-[minmax(11rem,1fr)_repeat(3,minmax(7rem,0.6fr))_minmax(14rem,1fr)] xl:gap-10">
      <nav aria-labelledby="footer-servicios">
        <h2 id="footer-servicios" class={heading}>
          Servicios
        </h2>
        <ul class={list}>
          {services.map(({ data }) => (
            <li>
              <a class={link} href={`/servicios/${data.slug}`}>
                {data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-empresa">
        <h2 id="footer-empresa" class={heading}>
          Empresa
        </h2>
        <ul class={list}>
          {COMPANY.map(({ label, href }) => (
            <li>
              <a class={link} href={href}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-legal">
        <h2 id="footer-legal" class={heading}>
          Legal
        </h2>
        <ul class={list}>
          {LEGAL.map(({ label, href }) => (
            <li>
              <a class={link} href={href}>
                {label}
              </a>
            </li>
          ))}
        </ul>
        {/* Ley 21.719 (in force from 2026-12-01). */}
        <p class="mt-4 flex max-w-[22ch] items-start gap-2 text-xs leading-5 text-ink-muted">
          <ShieldCheck
            size={14}
            stroke-width={1.75}
            aria-hidden="true"
            class="mt-0.5 shrink-0"
          />
          Tratamos tus datos personales conforme a la Ley 21.719.
        </p>
      </nav>

      <div>
        <h2 class={heading}>Redes</h2>
        <ul class={list}>
          {SOCIAL.map(({ name, href }) => (
            <li>
              <a
                class={`${link} group inline-flex items-center gap-2`}
                href={href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {name}
                <ArrowUpRight
                  size={14}
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <address class="col-span-2 not-italic sm:col-span-1 lg:col-span-1">
        <h2 class={heading}>Contacto</h2>
        <ul class="mt-4 grid gap-3">
          {CONTACT.phones.map((phone) => (
            <li>
              <a
                class={`${link} inline-flex items-start gap-2.5`}
                href={phone.href}
              >
                <Phone size={15} aria-hidden="true" class="mt-0.5 shrink-0" />
                {phone.display}
              </a>
            </li>
          ))}
          <li>
            <a
              class={`${link} footer-wa inline-flex items-start gap-2.5`}
              href={CONTACT.whatsapp.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <WhatsAppIcon />
              {CONTACT.whatsapp.display}
              <span class="sr-only">
                (WhatsApp, se abre en una pestaña nueva)
              </span>
            </a>
          </li>
          <li>
            <a
              class={`${link} inline-flex min-w-0 items-start gap-2.5`}
              href={`mailto:${CONTACT.email}`}
            >
              <Mail size={15} aria-hidden="true" class="mt-0.5 shrink-0" />
              <span class="min-w-0 break-all">{CONTACT.email}</span>
            </a>
          </li>
          <li>
            <a
              class={`${link} inline-flex items-start gap-2.5`}
              href={CONTACT.mapsHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              <MapPin size={15} aria-hidden="true" class="mt-0.5 shrink-0" />
              <span>
                {CONTACT.address.street}
                <br />
                {CONTACT.address.locality}, {CONTACT.address.region}
              </span>
            </a>
          </li>
        </ul>
      </address>
    </div>

    <div class="flex flex-col gap-5 pt-5 pb-24 sm:flex-row sm:items-center sm:justify-between lg:pb-0 lg:max-[1640px]:pr-20">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <a
          href="/"
          class="inline-flex no-underline motion-safe:transition-transform motion-safe:duration-200 motion-safe:hover:-translate-y-0.5"
          aria-label={`${SITE_NAME} — Inicio`}
        >
          <IsotipoMark width="52" height="20" class="h-5 w-auto" />
        </a>
        <span
          class="hidden h-4 w-px bg-border sm:block"
          aria-hidden="true"
        ></span>
        <p class={meta}>
          © {year} {LEGAL_NAME} · RUT {RUT}
        </p>
        <p class={meta}>Quilpué, Chile</p>
        <p class={meta}>
          Realizado por{" "}
          <a
            href="https://deivid.space"
            target="_blank"
            rel="noopener"
            class="text-ink-muted underline-offset-4 hover:text-ink hover:underline"
          >
            deivid.space
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="#top"
          class="group mr-2 inline-flex min-h-10 items-center gap-1.5 text-sm text-ink-muted no-underline hover:text-ink"
        >
          Volver arriba
          <ArrowUp
            size={15}
            stroke-width={2}
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:-translate-y-0.5"
          />
        </a>
        <ul class="flex items-center gap-1" aria-label="Redes sociales">
          {SOCIAL.map(({ name, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-10 items-center justify-center rounded-full border border-transparent text-ink no-underline transition-colors duration-200 hover:border-border hover:text-ink"
              >
                <SocialIcon name={name} size={20} />
                <span class="sr-only">
                  {name} (se abre en una pestaña nueva)
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <span
    class="footer-glint pointer-events-none absolute inset-x-0 bottom-0 h-px opacity-60"
    aria-hidden="true"
  ></span>
</footer>
