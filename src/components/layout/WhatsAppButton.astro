---
/**
 * Floating WhatsApp button (56px, bottom right, safe-area aware): the
 * official green glyph on a raised surface. Pages reserve bottom space in
 * the footer so it never covers content. `href` carries the page's
 * message (src/lib/whatsapp.ts).
 */
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";
import { CONTACT } from "../../lib/site";

interface Props {
  href?: string;
}

const { href = CONTACT.whatsapp.href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="whatsapp-fab fixed right-[max(1rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 inline-flex size-14 items-center justify-center rounded-full border border-border bg-surface-raised text-whatsapp shadow-(--shadow-md) transition-transform duration-200 hover:scale-105 hover:text-whatsapp"
>
  <WhatsAppIcon size={28} />
</a>

<style>
  /* Stays put during cross-document view transitions. */
  .whatsapp-fab {
    view-transition-name: whatsapp;
  }
</style>
