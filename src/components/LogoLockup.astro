    fill="currentColor"
    d="M5.952 112.334c3.287 0 5.952-2.537 5.952-5.667s-2.665-5.668-5.952-5.668S0 103.536 0 106.667c0 3.13 2.665 5.667 5.952 5.667"
  ></path>
  <path
