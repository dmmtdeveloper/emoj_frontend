---
/**
 * Full EMOJ lockup (isotype + "Emoj Consultora") as inline SVG with one
 * class per part, so it can be drawn with CSS. Paths copied from
 * `src/assets/brand/emoj-logo-currentcolor.svg` (keep in sync); the two dots
 * are split into separate paths.
 *
 * Paints in `currentColor`. With `draw="view"` it is drawn once when it
 * enters the viewport (src/lib/motion/draw-on-view.ts sets
 * `data-draw-state`; motion.css `.logo-lockup*`): the left dot pops, the
 * stroke draws from its left end, the right dot pops, then the words wipe
 * in. Reduced motion or no JavaScript shows the finished logo.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"svg">, "viewBox" | "role"> {
  /** Accessible name. Empty string hides the logo from AT. */
  label?: string;
  draw?: "view";
}

const {
  label = "EMOJ Consultora",
  draw,
  class: className,
  ...rest
} = Astro.props;

const a11y =
  label === ""
    ? { "aria-hidden": "true" as const }
    : { role: "img" as const, "aria-label": label };
---

<svg
  viewBox="0 0 470 231"
  fill="none"
  focusable="false"
  class:list={["logo-lockup", className]}
  data-draw-on-view={draw === "view" ? "" : undefined}
  {...a11y}
  {...rest}
>
  <path
    class="logo-lockup__stroke"
    pathLength="1"
    stroke="currentColor"
    stroke-miterlimit="10"
    stroke-width="10.19"
    d="M443.892 73.276c-51.511 17.446-64.706-25.5-91.869 18.332-25.174 40.616-32.522 78.166-64.594 73.585-63.498-9.07 21.954-144.469-27.778-158.67-69.72-19.918-117.291 176.694-192.108 157.569C5.306 148.183 97.941-11.744 129.202 14.078 152.5 33.325 84.634 85.626 25.707 101.949"
  ></path>
