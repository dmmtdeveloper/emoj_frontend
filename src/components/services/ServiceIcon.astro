---
/**
 * The line icon of a service (Lucide). Each icon carries
 * `svc-icon--<name>`, so on a card it plays its own gesture on hover, focus
 * or, on touch screens, once when the card comes into view (motion.css
 * "Service icon gestures", src/scripts/service-icons.ts).
 */
import {
  Bridge,
  CloudRain,
  DraftingCompass,
  Droplets,
  Layers,
  Route,
  TrafficCone,
} from "@lucide/astro";
import type { ServiceIconName } from "../../lib/services";

interface Props {
  name: ServiceIconName;
  size?: 20 | 24;
  class?: string;
}

const ICONS = {
  droplets: Droplets,
  route: Route,
  bridge: Bridge,
  "traffic-cone": TrafficCone,
  "drafting-compass": DraftingCompass,
  layers: Layers,
  "cloud-rain": CloudRain,
} as const satisfies Record<ServiceIconName, unknown>;

const { name, size = 24, class: className = "" } = Astro.props;
const Icon = ICONS[name];
---

<Icon
  size={size}
  stroke-width={1.75}
  aria-hidden="true"
  class:list={["svc-icon", `svc-icon--${name}`, className]}
/>
