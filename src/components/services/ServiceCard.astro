---
/**
 * Clickable service tile. The whole tile is one link (the title, stretched
 * with ::after), so there is a single tab stop.
 *
 * Variants:
 * - `default`: EMOJ signature shape; icon, title, summary, "Ver servicio"
 *   (the /servicios list).
 * - `compact`: a quiet block (radius-lg, sunken fill) for the home bento:
 *   line icon, an arrow in a circle, the title, and the summary from `md`.
 * - `featured`: large photo tile for the home bento (needs `service.image`).
 *
 * Hover/focus: the tile lifts, the icon redraws its strokes and the arrow
 * moves (motion.css `.icon-draw`; none under reduced motion).
 *
 * `photo` (compact and default tiles): a project photo that fades in behind
 * the content on hover or keyboard focus, under a plum overlay; the text
 * switches to light colors so it keeps its contrast. Decorative (`alt=""`):
 * the link names the service. Touch screens never show it (no hover).
 */
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Service } from "../../lib/get-services";
import { fitWidth } from "../../lib/content/format";
import ServiceIcon from "./ServiceIcon.astro";

interface Props {
  service: Service;
  headingLevel?: "h2" | "h3";
  variant?: "default" | "compact" | "featured";
  /** Position shown as an editorial index ("01"). */
  index?: number;
  /** Photo revealed on hover (see above). Remote URLs need their size. */
  photo?:
    | { src: string; width: number; height: number }
    | { src: ImageMetadata }
    | undefined;
}

const {
  service,
  headingLevel = "h3",
  variant = "default",
  index,
  photo,
} = Astro.props;
const { title, summary, icon, slug, image } = service.data;
const Heading = headingLevel;
const number = index === undefined ? "" : String(index).padStart(2, "0");
const featured = variant === "featured" && image !== undefined;
const link =
  "no-underline after:absolute after:inset-0 after:z-10 after:rounded-[inherit] focus-visible:outline-none";
// Light text while the photo shows (written out in full for Tailwind).
const onPhoto = {
  title: "group-hover:text-sand-50 group-has-[a:focus-visible]:text-sand-50",
  muted: "group-hover:text-sand-100 group-has-[a:focus-visible]:text-sand-100",
  link: "group-hover:text-sand-50 group-has-[a:focus-visible]:text-sand-50",
};
const photoImage =
  "h-full w-full scale-105 object-cover transition-[scale] duration-700 ease-(--ease-out) group-hover:scale-100 group-has-[a:focus-visible]:scale-100";
const photoLayer =
  "pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-500 ease-(--ease-out) group-hover:opacity-100 group-has-[a:focus-visible]:opacity-100";
const shell =
  "group relative isolate flex h-full flex-col overflow-hidden transition-[translate,box-shadow,border-color] duration-300 ease-(--ease-out) hover:-translate-y-1 has-[a:focus-visible]:-translate-y-1 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-focus-ring";
---

{featured ? (
  <article
    class:list={[
      shell,
      "min-h-[340px] justify-end gap-4 rounded-lg bg-plum-950 p-6 text-sand-50 md:p-8 lg:min-h-full",
    ]}
  >
    <Image
      src={image}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(min-width: 1200px) 584px, (min-width: 1024px) 48vw, 100vw"
      loading="lazy"
      class="absolute inset-0 -z-20 h-full w-full object-cover transition-[scale] duration-700 ease-(--ease-out) group-hover:scale-105"
    />
    <div
      class="absolute inset-0 -z-10 bg-linear-to-t from-plum-950/90 via-plum-950/65 to-plum-950/25"
      aria-hidden="true"
    />
    <span class="inline-flex min-h-8 items-center self-start rounded-full border border-sand-50/30 bg-sand-50/15 px-3.5 font-data text-[12px] leading-4 font-medium tracking-[0.08em] uppercase">
      Especialidad principal
    </span>
    <Heading class="text-h2 mt-auto max-w-[14ch] pt-10">
      <a
        href={`/servicios/${slug}`}
        class:list={[link, "text-sand-50 hover:text-sand-50"]}
      >
        {title}
      </a>
    </Heading>
    <p class="max-w-[44ch] text-sand-100">{summary}</p>
    <span
      class="inline-flex size-14 items-center justify-center self-end rounded-full bg-sand-50 text-plum-950 transition-transform duration-300 ease-(--ease-out) group-hover:-translate-y-0.5 group-hover:translate-x-0.5 md:-mt-14"
      aria-hidden="true"
    >
      <ArrowUpRight size={24} stroke-width={2} />
    </span>
  </article>
) : variant === "compact" ? (
  <article
    class:list={[
      shell,
      "justify-between gap-4 rounded-lg bg-surface-sunken p-5 hover:shadow-(--shadow-md) has-[a:focus-visible]:shadow-(--shadow-md) md:p-6",
    ]}
  >
    {photo && (
      <div class={photoLayer} aria-hidden="true">
        {"width" in photo ? (
          <Image
            src={photo.src}
            alt=""
            {...fitWidth(photo, 640)}
            sizes="(min-width: 1024px) 300px, 50vw"
            loading="lazy"
            class={photoImage}
          />
        ) : (
          <Image
            src={photo.src}
            alt=""
            widths={[400, 640]}
            sizes="(min-width: 1024px) 300px, 50vw"
            loading="lazy"
            class={photoImage}
          />
        )}
        <div class="absolute inset-0 bg-linear-to-t from-plum-950/85 via-plum-950/70 to-plum-950/60" />
      </div>
    )}
    <div class="flex items-start justify-between gap-3">
      <span
        class:list={[
          "icon-draw inline-flex text-ink transition-colors duration-300",
          onPhoto.title,
        ]}
      >
        <ServiceIcon name={icon} />
      </span>
      <span
        class:list={[
          "inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-border-strong text-ink transition-[color,border-color,translate] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:border-sand-50/60",
          onPhoto.title,
        ]}
        aria-hidden="true"
      >
        <ArrowUpRight size={16} stroke-width={2} />
      </span>
    </div>
    <div class="flex flex-col gap-1.5">
      <Heading
        class:list={[
          "text-[18px] leading-6 font-semibold tracking-[-0.01em] text-ink hyphens-auto transition-colors duration-300 md:text-[22px] md:leading-7",
          onPhoto.title,
        ]}
      >
        <a
          href={`/servicios/${slug}`}
          class:list={[
            link,
            "text-ink hover:text-ink",
            photo && "group-hover:text-sand-50 hover:text-sand-50",
          ]}
        >
          {title}
        </a>
      </Heading>
      <p
        class:list={[
          "hidden text-ink-muted transition-colors duration-300 md:block md:text-base md:leading-6",
          onPhoto.muted,
        ]}
      >
        {summary}
      </p>
    </div>
  </article>
) : (
  <article
    class:list={[
      shell,
      "radius-signature gap-4 border border-border bg-surface-raised p-6 pl-8 shadow-(--shadow-sm) hover:border-brand hover:shadow-(--shadow-md) has-[a:focus-visible]:shadow-(--shadow-md) md:p-8 md:pl-10",
    ]}
  >
    {photo && (
      <div class={photoLayer} aria-hidden="true">
        {"width" in photo ? (
          <Image
            src={photo.src}
            alt=""
            {...fitWidth(photo, 640)}
            sizes="(min-width: 1024px) 300px, 50vw"
            loading="lazy"
            class={photoImage}
          />
        ) : (
          <Image
            src={photo.src}
            alt=""
            widths={[400, 640]}
            sizes="(min-width: 1024px) 300px, 50vw"
            loading="lazy"
            class={photoImage}
          />
        )}
        <div class="absolute inset-0 bg-linear-to-t from-plum-950/85 via-plum-950/70 to-plum-950/60" />
      </div>
    )}
    <div class="flex items-start justify-between gap-3">
      <span
        class:list={[
          "icon-draw inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-surface-sunken text-brand transition-colors duration-300 group-hover:bg-brand group-hover:text-on-brand",
        ]}
      >
        <ServiceIcon name={icon} />
      </span>
      {number && (
        <span
          class:list={[
            "text-[13px] leading-4 font-medium tracking-[0.14em] text-ink-muted transition-colors duration-300",
            onPhoto.muted,
          ]}
          aria-hidden="true"
        >
          {number}
        </span>
      )}
    </div>
    <Heading
      class:list={[
        "font-semibold text-ink hyphens-auto transition-colors duration-300",
        onPhoto.title,
        "text-[22px] leading-7",
      ]}
    >
      <a
        href={`/servicios/${slug}`}
        class:list={[
          link,
          "text-ink hover:text-ink",
          photo && "group-hover:text-sand-50 hover:text-sand-50",
        ]}
      >
        {title}
      </a>
    </Heading>
    <p
      class:list={[
        "text-ink-muted transition-colors duration-300",
        onPhoto.muted,
      ]}
    >
      {summary}
    </p>
    <span
      class:list={[
        "mt-auto items-center gap-2 pt-1 text-base leading-5 font-medium text-brand transition-colors duration-300",
        onPhoto.link,
        "inline-flex",
      ]}
      aria-hidden="true"
    >
      Ver servicio
      <ArrowRight
        size={20}
        stroke-width={1.75}
        class="transition-transform duration-300 ease-(--ease-out) group-hover:translate-x-1.5"
      />
    </span>
  </article>
)}
