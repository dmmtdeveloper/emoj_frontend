---
/**
 * The "emoj" wordmark as inline SVG outlines, so it can be written with the
 * same pen as the isotype: with `draw`, each letter's contours are traced
 * (stroke dash, `pathLength="1"`) left to right right after the isotype
 * stroke ends, then fill in, and the name stays. With reduced motion, or
 * without `draw`, it is plain filled.
 *
 * The outlines are Urbanist 600 glyphs (e, m, o, j) extracted from
 * `@fontsource/urbanist` at font-size 100, baseline at y=0, so the drawing
 * does not depend on SVG text support or on the web font having loaded
 * (Safari animates outlines reliably, text glyphs not). The viewBox is the
 * box of one line of `leading-none` text: baseline 85 units from the top.
 * Decorative: the link around it carries the accessible name. Motion lives
 * in `src/styles/motion.css` (`.wordmark*`); the letter index comes from
 * `:nth-child` there, not a `style` attribute, which the CSP blocks.
 */
interface Props {
  /** Write the letters when the page loads (after the isotype stroke). */
  draw?: boolean;
  class?: string;
}

const { draw = false, class: className } = Astro.props;

