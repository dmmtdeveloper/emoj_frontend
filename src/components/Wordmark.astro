---

<svg
  viewBox="0 -85 226 100"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class:list={["wordmark", draw && "wordmark--draw", className]}
>
  {LETTERS.map(({ contours }) => (
    <g class="wordmark__letter">
      {/* One shape for the fill, so counters stay open (e, o, j). */}
      <path class="wordmark__fill" d={contours.join("")} />
      {/* One line per contour for the pen (pathLength per contour). */}
      {contours.map((d) => (
        <path class="wordmark__stroke" pathLength="1" d={d} />
      ))}
    </g>
  ))}
</svg>
