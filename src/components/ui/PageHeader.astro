---
/**
 * Page intro for inner pages: optional eyebrow label, the page's single H1
 * and a lead paragraph, on the shared type scale (global.css). Breadcrumbs
 * go in the `breadcrumb` slot. The decorative line draws itself on load.
 */
import StrokeLine from "./StrokeLine.astro";

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
}

const { title, lead, eyebrow } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border bg-surface">
  <StrokeLine
    draw="load-back"
    class="absolute -top-6 -right-24 hidden w-[520px] text-border-strong opacity-50 md:block"
  />
  <div class="container-site relative flex flex-col gap-6 py-16 md:py-24">
    <slot name="breadcrumb" />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="text-h1 max-w-[20ch] text-ink">{title}</h1>
    {lead && <p class="text-lead max-w-[56ch] text-ink-muted">{lead}</p>}
    <slot />
  </div>
</section>
