---
/**
 * Closing call to action: quote button plus WhatsApp and email.
 * Sits on `surface-sunken`/`surface-raised` with the signature shape (not
 * `surface-inverse`, which is reserved for the facts band and the footer).
 *
 * `emphasis`: a word or phrase of the title set in Urbanist italic, in
 * `brand` (the redesign's emphasis). Ignored when the title does not
 * contain it.
 */
import { ArrowRight, Mail } from "@lucide/astro";
import { splitEmphasis } from "../../lib/emphasis";
import { CONTACT } from "../../lib/site";
import { whatsappHref, type WhatsAppContext } from "../../lib/whatsapp";
import ButtonLink from "./ButtonLink.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";

interface Props {
  title?: string;
  emphasis?: string;
  text?: string;
  href?: string;
  label?: string;
  /** Background of the surrounding section, to keep the page rhythm. */
  background?: "surface" | "surface-sunken";
  /** What the page is about, for the WhatsApp message (src/lib/whatsapp.ts). */
  whatsapp?: WhatsAppContext;
}

const {
  title = "¿Tienes un proyecto? Conversemos.",
  emphasis = "Conversemos",
  text = "Cuéntanos qué necesitas y te ayudamos a definir el alcance, los plazos y los entregables de tu proyecto.",
  href = "/contacto",
  label = "Cotizar proyecto",
  background = "surface",
  whatsapp,
} = Astro.props;

const parts = splitEmphasis(title, emphasis);

const contactLink =
  "group/contact inline-flex min-h-11 items-center gap-3 font-medium text-ink no-underline hover:text-brand";
---

<section
  class:list={[
    "relative",
    background === "surface" ? "bg-surface" : "bg-surface-sunken",
  ]}
>
  <div class="container-site relative z-[2] py-16 md:py-28 lg:py-32">
    <div
      class:list={[
        "radius-signature relative isolate grid gap-10 overflow-clip p-8 pl-10 md:grid-cols-[1.4fr_1fr] md:items-end md:gap-12 md:p-14 md:pl-16 lg:p-16 lg:pl-20",
        background === "surface" ? "bg-surface-sunken" : "bg-surface-raised",
      ]}
      data-reveal
    >
      <div class="flex flex-col gap-5">
        <h2 class="max-w-[18ch] text-[clamp(2rem,1.5rem+2vw,3.25rem)] leading-[1.02] font-semibold tracking-[-0.04em] text-balance text-ink">
          {parts ? (
            <>
              {parts.before}
              <em class="font-medium text-brand">{parts.word}</em>
              {parts.after}
            </>
          ) : (
            title
          )}
        </h2>
        <p class="text-lead max-w-[46ch] text-ink-muted">{text}</p>
      </div>
      <div class="flex flex-col gap-4">
        <ButtonLink href={href} class="w-full sm:w-auto sm:self-start">
          {label}
          <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
        </ButtonLink>
        <ul class="flex flex-col">
          <li>
            <a
              href={whatsappHref(whatsapp)}
              target="_blank"
              rel="noopener noreferrer"
              class={contactLink}
            >
              <WhatsAppIcon size={20} class="text-brand" />
              <span class="underline-offset-4 group-hover/contact:underline">
                WhatsApp {CONTACT.whatsapp.display}
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`} class={contactLink}>
              <Mail
                size={20}
                stroke-width={1.75}
                aria-hidden="true"
                class="text-brand"
              />
              <span class="underline-offset-4 group-hover/contact:underline">
                {CONTACT.email}
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
