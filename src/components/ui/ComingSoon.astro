---
/**
 * Temporary body for sections that ship in a later slice (Proyectos,
 * Nosotros, Noticias). Keeps the navigation from hitting a 404.
 */
import { ArrowRight } from "@lucide/astro";
import { CONTACT } from "../../lib/site";
import ButtonLink from "./ButtonLink.astro";

interface Props {
  message: string;
}

const { message } = Astro.props;
---

<section class="bg-surface-sunken">
  <div class="mx-auto max-w-[1200px] px-4 py-16 md:py-24">
    <div class="radius-signature flex max-w-[65ch] flex-col gap-6 bg-surface-raised p-8 shadow-(--shadow-sm) md:p-12">
      <p class="text-[13px] leading-4 font-semibold tracking-[0.08em] text-ink-muted uppercase">
        Próximamente
      </p>
      <p>{message}</p>
      <p>
        Mientras tanto, escríbenos a
        <a class="font-semibold" href={`mailto:${CONTACT.email}`}>
          {CONTACT.email}
        </a>
        o revisa nuestros servicios.
      </p>
      <div class="flex flex-wrap gap-3">
        <ButtonLink href="/servicios">
          Ver servicios
          <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
        </ButtonLink>
        <ButtonLink href="/contacto" variant="secondary">
          Cotizar proyecto
        </ButtonLink>
      </div>
    </div>
  </div>
</section>
