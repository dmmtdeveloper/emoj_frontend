---
/**
 * Empty state for API-driven listings that have no published items yet.
 * The slot holds the actions (links).
 */
interface Props {
  message: string;
  label?: string;
}

const { message, label = "Próximamente" } = Astro.props;
---

<div class="radius-signature flex max-w-[65ch] flex-col gap-6 bg-surface-raised p-8 shadow-(--shadow-sm) md:p-12">
  <p class="text-[13px] leading-4 font-semibold tracking-[0.08em] text-ink-muted uppercase">
    {label}
  </p>
  <p>{message}</p>
  <div class="flex flex-wrap gap-3">
    <slot />
  </div>
</div>
