---
/**
 * Decorative hand-drawn line taken from the EMOJ isotype stroke.
 * Use sparingly (one per section at most). Always hidden from assistive tech.
 * Color comes from `currentColor` (use `text-brand` or `text-border-strong`).
 *
 * `draw` animates the stroke from its left end (the path starts on the
 * right): "load-back" on page load, "view-back" while it scrolls into view
 * (motion.css). Reduced motion shows the finished line.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"svg">, "viewBox"> {
  draw?: "load-back" | "view-back";
}

const { draw, class: className, ...rest } = Astro.props;
---

<svg
  viewBox="0 0 470 171"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
  data-draw={draw}
  class:list={["pointer-events-none overflow-visible", className]}
  {...rest}
>
  <path
    pathLength="1"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    d="M443.892 73.276c-51.511 17.446-64.706-25.5-91.869 18.332-25.174 40.616-32.522 78.166-64.594 73.585-63.498-9.07 21.954-144.469-27.778-158.67-69.72-19.918-117.291 176.694-192.108 157.569C5.306 148.183 97.941-11.744 129.202 14.078 152.5 33.325 84.634 85.626 25.707 101.949"
  ></path>
</svg>
