---
/**
 * Link styled as a button: compact (40px tall, 15px medium label, radius-md).
 *
 * - `primary`: brand fill. Use on `surface`, `surface-sunken`, `surface-raised`.
 * - `secondary`: outlined in `ink`. Use on light surfaces.
 * - `on-photo`: outlined cream, only over a photo with the plum overlay.
 * - `on-photo-solid`: cream fill, the main action over that photo (home hero).
 * - `on-inverse`: cream fill, only on `surface-inverse` (brand is forbidden there).
 * - `on-accent`: plum fill, on an `accent` (sage) block; same in both themes.
 * - `sage`: sage fill with plum text, the main action on a dark plum section.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?:
    | "primary"
    | "secondary"
    | "on-photo"
    | "on-photo-solid"
    | "on-inverse"
    | "on-accent"
    | "sage";
  /** Fully rounded ends, for buttons inside a rounded container (header). */
  pill?: boolean;
}

const {
  variant = "primary",
  pill = false,
  class: className,
  ...rest
} = Astro.props;

// Micro-interactions: trailing arrow nudges on hover, the button presses in
// on :active (transform only, no layout change).
const base =
  "inline-flex min-h-10 items-center justify-center gap-2 px-5 py-2.5 text-[15px] leading-5 font-medium no-underline transition-[color,background-color,border-color,scale] duration-200 ease-(--ease-out) active:scale-[0.97] [&>svg:last-child]:transition-transform [&>svg:last-child]:duration-300 [&>svg:last-child]:ease-(--ease-out) hover:[&>svg:last-child]:translate-x-1";

const variants = {
  primary: "bg-brand text-on-brand hover:bg-brand-hover hover:text-on-brand",
  secondary:
    "border border-ink bg-transparent text-ink hover:bg-ink hover:text-surface",
  "on-photo":
    "border border-sand-50 bg-transparent text-sand-50 hover:bg-sand-50 hover:text-plum-950",
  // Main action over a dark photo (home hero): `brand` on plum is a
  // forbidden pair, so the fill is cream in both themes.
  "on-photo-solid":
    "bg-sand-50 text-plum-950 hover:bg-sand-100 hover:text-plum-950",
  "on-inverse":
    "bg-ink-inverse text-surface-inverse hover:bg-surface-sunken hover:text-ink",
  "on-accent": "bg-plum-950 text-sand-50 hover:bg-plum-900 hover:text-sand-50",
  sage: "bg-sage-300 text-plum-950 hover:bg-sage-200 hover:text-plum-950",
} as const;
---

<a
  class:list={[
    base,
    pill ? "rounded-full" : "rounded-md",
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
