---
/**
 * The EMOJ isotype (stroke + dots) drawn behind a section as it scrolls
 * into view: one per section, in a different corner each time so the page
 * keeps a rhythm without repeating itself.
 *
 * The section must be `relative isolate overflow-clip` (clip, not hidden:
 * `hidden` would make it a scroll container and freeze the view timeline)
 * and keep its content above the trace (`relative z-[2]`). Decorative and
 * hidden from assistive tech; reduced motion shows the finished mark.
 */
import StrokeLine from "./StrokeLine.astro";

interface Props {
  corner: "top-left" | "top-right" | "bottom-left" | "bottom-right";
  /** "inverse" on `surface-inverse` (brand on plum is a forbidden pair). */
  tone?: "brand" | "inverse";
  /**
   * Also show it below 1024px. Off by default: in one column there is no
   * free space and the mark would run under the text.
   */
  mobile?: boolean;
}

const { corner, tone = "brand", mobile = false } = Astro.props;

// Inside the section, so the whole mark (both dots) stays visible.
const CORNERS = {
  "top-left": "top-6 -left-4 md:top-10 md:left-[2%]",
  "top-right": "top-6 -right-4 md:top-10 md:right-[2%]",
  "bottom-left": "bottom-6 -left-4 md:bottom-10 md:left-[2%]",
  "bottom-right": "bottom-6 -right-4 md:bottom-10 md:right-[2%]",
} as const;
---

<StrokeLine
  draw="view-back"
  dots
  class:list={[
    "section-trace absolute -z-10",
    !mobile && "hidden lg:block",
    "w-[min(92vw,420px)] md:w-[640px] lg:w-[760px]",
    CORNERS[corner],
    tone === "inverse"
      ? "text-ink-inverse opacity-25"
      : "text-brand opacity-20 dark:opacity-30",
  ]}
/>
