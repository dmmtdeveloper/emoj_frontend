---
/**
 * Text link with a trailing arrow that slides on hover and a drawn
 * underline (scaleX from the left). 44px target.
 */
import { ArrowRight } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { class: className, ...rest } = Astro.props;
---

<a
  class:list={[
    "group/arrow relative inline-flex min-h-11 items-center gap-2 font-semibold no-underline",
    "after:absolute after:inset-x-0 after:bottom-2 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-current after:transition-transform after:duration-300 after:ease-(--ease-out) hover:after:scale-x-100 focus-visible:after:scale-x-100",
    className,
  ]}
  {...rest}
>
  <slot />
  <ArrowRight
    size={20}
    stroke-width={1.75}
    aria-hidden="true"
    class="transition-transform duration-300 ease-(--ease-out) group-hover/arrow:translate-x-1"
  />
</a>
