---
/**
 * Progressive filter for /proyectos, as rounded chips with their counts. The chips take their space from the
 * first paint (invisible, so revealing them causes no layout shift); without
 * JavaScript /noscript.css removes them, every project stays visible and no
 * dead controls are shown. The script
 * (bundled as a same-origin module, CSP-safe) reveals the chips, hides
 * non-matching cards (`li[data-project]`) and keeps `?servicio=&region=`
 * in the URL so filtered views can be linked.
 */
import type { Facet } from "../../lib/content/format";

interface Props {
  services: Facet<string>[];
  regions: Facet<string>[];
  serviceTitles: Record<string, string>;
  total: number;
}

const { services, regions, serviceTitles, total } = Astro.props;
const showServices = services.length > 1;
const showRegions = regions.length > 1;
const chip =
  "inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-border bg-surface-raised px-4 py-2 text-sm leading-5 font-medium text-ink transition-[color,background-color,border-color,scale] duration-200 hover:border-border-strong active:scale-[0.97] aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-surface";
const count = "font-data text-[12px] leading-4 font-medium opacity-70";
const legend =
  "mb-3 font-data text-[12px] leading-4 font-medium tracking-[0.1em] text-ink-muted uppercase";
---

{(showServices || showRegions) && (
  <div
    data-project-filters
    data-services={JSON.stringify(services.map((s) => s.value))}
    data-regions={JSON.stringify(regions.map((r) => r.value))}
    data-total={total}
    class="invisible flex flex-col gap-6 border-b border-border pb-8 lg:flex-row lg:flex-wrap lg:items-end lg:gap-x-12"
  >
    {showServices && (
      <fieldset>
        <legend class={legend}>Servicio</legend>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            class={chip}
            data-filter="service"
            data-value=""
            aria-pressed="true"
          >
            Todos
          </button>
          {services.map((s) => (
            <button
              type="button"
              class={chip}
              data-filter="service"
              data-value={s.value}
              aria-pressed="false"
            >
              {serviceTitles[s.value] ?? s.value}
              <span class={count}>{s.count}</span>
            </button>
          ))}
        </div>
      </fieldset>
    )}
    {showRegions && (
      <fieldset>
        <legend class={legend}>Región</legend>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            class={chip}
            data-filter="region"
            data-value=""
            aria-pressed="true"
          >
            Todas
          </button>
          {regions.map((r) => (
            <button
              type="button"
              class={chip}
              data-filter="region"
              data-value={r.value}
              aria-pressed="false"
            >
              {r.value}
              <span class={count}>{r.count}</span>
            </button>
          ))}
        </div>
      </fieldset>
    )}
    <p
      data-filter-status
      role="status"
      class="font-data text-sm leading-5 font-medium text-ink-muted lg:ml-auto lg:pb-3"
    >
      {total === 1 ? "1 proyecto." : `${total} proyectos.`}
    </p>
  </div>
)}

<noscript>
  <link rel="stylesheet" href="/noscript.css" />
</noscript>

<script>
  import { initProjectFilters } from "../../scripts/project-filter";
  initProjectFilters();
</script>
