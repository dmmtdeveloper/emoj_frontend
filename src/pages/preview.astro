---
/**
 * Preview of a project or article, drafts included, from the token the
 * panel creates (POST /v1/admin/preview-tokens, 15 minutes). The draft is
 * handed to its own page through `Astro.locals.preview`, so the preview
 * looks exactly like the public page; that page then skips the cache and
 * search engines and shows a "Vista previa" bar.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import NotFound from "../components/NotFound.astro";
import { createApiClient } from "../lib/api/client";
import { loadPreview, setPreviewHeaders } from "../lib/content/preview";
import { API_URL } from "../lib/env";

export const prerender = false;

const client = createApiClient({ baseUrl: API_URL });
const result = await loadPreview(Astro.url.searchParams.get("token"), (t) =>
  client.getPreview(t),
);
setPreviewHeaders(Astro.response.headers);

if (result.kind === "project") {
  Astro.locals.preview = result;
  return Astro.rewrite(`/proyectos/${result.project.slug}`);
}
if (result.kind === "news") {
  Astro.locals.preview = result;
  return Astro.rewrite(`/noticias/${result.news.slug}`);
}
Astro.response.status =
  result.kind === "not-found" ? 404 : result.kind === "expired" ? 401 : 503;
const expired = result.kind === "expired";
---

{result.kind === "not-found" ? (
  <NotFound />
) : (
  <BaseLayout
    title="Vista previa"
    description="Vista previa de un contenido del sitio."
    noindex
  >
    <section class="container-site flex flex-col gap-6 py-16 md:py-24">
      <p class="eyebrow">Vista previa</p>
      <h1 class="text-h1 max-w-[24ch]">
        {expired
          ? "Este enlace de vista previa ya no sirve"
          : "No pudimos cargar la vista previa"}
      </h1>
      <p class="max-w-[65ch] text-ink-muted">
        {expired
          ? "Los enlaces de vista previa duran 15 minutos. Vuelve al editor y pulsa «Vista previa» otra vez."
          : "Intenta de nuevo en unos minutos."}
      </p>
      <p>
        <a href="/admin" class="font-medium">
          Volver al panel
        </a>
      </p>
    </section>
  </BaseLayout>
)}
