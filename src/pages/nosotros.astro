import PageHeader from "../components/ui/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { MISSION } from "../lib/site";
---

<BaseLayout
  title="Nosotros"
  description="EMOJ Consultora SpA: más de 30 años de ingeniería civil multidisciplinaria desde Quilpué, Región de Valparaíso."
>
