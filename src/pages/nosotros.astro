---
/**
 * About, in the home's voice:
 * - A photo-led header with the team photo under the transparent header.
 * - "Trayectoria": the positioning text with real figures and, right
 *   beside it, the logos of the clients it names.
 * - Mission and vision as a statement on plum, with the fine-stroke
 *   isotype as a supergraphic.
 * - The team: the head of the company in a large tile next to the intro,
 *   then each department in a four-column grid (one full row each).
 * - The closing call to action.
 */
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import teamPhoto from "../assets/photos/equipo-emoj.jpg";
import ClientLogos from "../components/about/ClientLogos.astro";
import TeamCard from "../components/about/TeamCard.astro";
import IsotipoMark from "../components/IsotipoMark.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import CtaBlock from "../components/ui/CtaBlock.astro";
import DisplayHeading from "../components/ui/DisplayHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getServices } from "../lib/get-services";
import { MISSION } from "../lib/site";
import { organizationJsonLd } from "../lib/structured-data";
import {
  ABOUT_INTRO,
  ABOUT_POSITIONING,
  TEAM,
  teamSize,
  VISION,
} from "../lib/team";

const organization = {
  ...organizationJsonLd(Astro.site),
  employee: TEAM.flatMap((department) =>
    department.members.map((member) => ({
      "@type": "Person",
      name: member.name,
      jobTitle: member.role,
    })),
  ),
};

const people = teamSize(TEAM);
const services = await getServices();
const figures = [
  { value: "30+", label: "años de experiencia" },
  { value: String(people), label: "personas en el equipo" },
  { value: String(services.length), label: "especialidades" },
  { value: "2", label: "regiones: Valparaíso y Coquimbo" },
];
const [leadership, ...departments] = TEAM;
const head = leadership?.members[0];
const [lead, ...rest] = ABOUT_POSITIONING;
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout
  title="Nosotros"
  description="EMOJ Consultora SpA: más de 30 años de ingeniería civil multidisciplinaria desde Quilpué. Conoce nuestra misión, visión y al equipo detrás de cada proyecto."
  jsonLd={[organization]}
  headerOverlay
>
  <section
    aria-labelledby="nosotros-titulo"
    class="relative isolate -mt-(--header-h) overflow-hidden bg-plum-950 text-sand-50"
  >
    {/*
      The photo fills the top of the section and the text sits below it on
      plum, so no line ever covers a face (the people are the point here).
    */}
    <div class="hero__parallax absolute inset-x-0 top-0 -z-10 h-[56%] overflow-hidden md:h-[62%]">
      <Image
        src={teamPhoto}
        alt="Integrantes del equipo de EMOJ Consultora posando juntos, de pie, en una oficina."
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="photo-zoom h-full w-full object-cover object-[50%_28%]"
      />
    </div>
    <div
      class="absolute inset-0 -z-10 bg-linear-to-t from-plum-950 from-44% via-plum-950/30 via-60% to-plum-950/35 md:from-38% md:via-56%"
      aria-hidden="true"
    ></div>

    <div class="hero__content container-site flex min-h-[max(680px,100svh)] md:min-h-[max(760px,100svh)] flex-col justify-end gap-6 pt-[calc(var(--header-h)+40px)] pb-12 md:gap-7 md:pb-16">
      <div class="hidden md:block">
        <Breadcrumb
          inverse
          items={[
            { label: "Inicio", href: "/" },
            { label: "Nosotros", href: "/nosotros" },
          ]}
        />
      </div>
      <p class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sage-300 uppercase">
        Nosotros
      </p>
      <h1
        id="nosotros-titulo"
        class="max-w-[18ch] text-[clamp(2.5rem,1.6rem+3vw,4.5rem)] lg:max-w-[24ch] leading-[0.98] font-semibold tracking-[-0.045em] text-balance"
      >
        Más de 30&nbsp;años de ingeniería civil desde{" "}
        <em class="font-medium text-sage-300">Quilpué</em>.
      </h1>
      <p class="text-lead max-w-[52ch] text-sand-100 lg:max-w-[64ch]">
        {ABOUT_INTRO}
      </p>
      <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center sm:gap-7">
        <ButtonLink
          href="#equipo"
          variant="on-photo-solid"
          class="min-h-12 px-6 text-base"
        >
          Conoce al equipo
        </ButtonLink>
        <a
          href="/proyectos"
          class="group inline-flex min-h-12 items-center gap-2 self-start text-base font-semibold text-sand-50 no-underline hover:text-sand-50 sm:self-auto"
        >
          Ver proyectos
          <ArrowRight
            size={20}
            stroke-width={1.75}
            aria-hidden="true"
            class="transition-transform duration-300 ease-(--ease-out) group-hover:translate-x-1"
          />
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="trayectoria" class="bg-surface">
    <div class="container-site grid gap-10 py-16 md:py-24 lg:grid-cols-[5fr_7fr] lg:gap-16 lg:py-28">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <DisplayHeading
          id="trayectoria"
          eyebrow="Trayectoria"
          title="Proyectos complejos, plazos cumplidos."
          emphasis="plazos cumplidos"
          size="md"
        />
      </div>
      <div class="flex flex-col gap-10 md:gap-12">
        <div class="flex max-w-[60ch] flex-col gap-5" data-reveal>
          {lead && (
            <p class="text-[22px] leading-8 tracking-[-0.01em] text-ink md:text-[26px] md:leading-9">
              {lead}
            </p>
          )}
          {rest.map((text) => (
            <p class="text-ink-muted">{text}</p>
          ))}
        </div>
        <dl
          class="grid grid-cols-2 border-t border-border md:grid-cols-4"
          data-reveal
        >
          {figures.map((figure) => (
            <div class="flex flex-col gap-1.5 border-border py-5 pr-4 even:border-l even:pl-4 md:border-l md:px-5 md:first:border-l-0 md:first:pl-0">
              <dt class="order-2 text-sm leading-5 text-ink-muted">
                {figure.label}
              </dt>
              <dd class="order-1 font-data text-[clamp(2rem,1.6rem+1.4vw,2.75rem)] leading-none font-semibold tracking-[-0.04em] text-ink tabular-nums">
                {figure.value}
              </dd>
            </div>
          ))}
        </dl>
        <div class="flex flex-col gap-5 border-t border-border pt-8">
          <p class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-ink-muted uppercase">
            Han confiado en nosotros
          </p>
          <ClientLogos />
        </div>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="mision"
    class="relative isolate overflow-hidden bg-plum-950 text-sand-50"
  >
    <IsotipoMark
      weight="fine"
      tone="mono"
      class="pointer-events-none absolute top-1/2 -right-[12%] -z-10 hidden w-[62%] -translate-y-1/2 text-sand-50 opacity-[0.07] lg:block"
    />
    <div class="container-site flex flex-col gap-12 py-16 md:gap-16 md:py-24 lg:py-32">
      <div class="flex max-w-[52rem] flex-col gap-6" data-reveal>
        <h2
          id="mision"
          class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sage-300 uppercase"
        >
          Misión
        </h2>
        <p class="text-[clamp(1.625rem,1.2rem+1.7vw,2.75rem)] leading-[1.15] font-medium tracking-[-0.03em] text-balance">
          {MISSION}
        </p>
      </div>
      <div
        class="flex max-w-[40rem] flex-col gap-4 border-t border-sand-50/20 pt-8"
        data-reveal
      >
        <h2 class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sage-300 uppercase">
          Visión
        </h2>
        <p class="text-[20px] leading-8 text-sand-100 md:text-[24px] md:leading-9">
          {VISION}
        </p>
      </div>
    </div>
  </section>

  <section
    id="equipo"
    aria-labelledby="equipo-titulo"
    class="scroll-mt-(--header-h) bg-surface-sunken"
  >
    <div class="container-site flex flex-col gap-14 py-16 md:gap-20 md:py-24 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-16">
        <DisplayHeading
          id="equipo-titulo"
          eyebrow={`Equipo · ${pad(people)}`}
          title="Las personas detrás de cada proyecto."
          emphasis="personas"
          lead="Ingenieros civiles, dibujantes proyectistas y un equipo de administración que coordinan cada especialidad desde Quilpué."
          size="md"
        />
        {head && leadership && (
          <div class="flex flex-col gap-4" data-reveal>
            <p class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-ink-muted uppercase">
              {leadership.name}
            </p>
            <TeamCard member={head} size="lg" headingLevel="h3" />
          </div>
        )}
      </div>

      {departments.map((department) => (
        <div class="flex flex-col gap-6">
          <h3 class="flex items-baseline justify-between gap-4 border-b border-border pb-3 text-lg leading-6 font-semibold text-ink md:text-xl">
            {department.name}
            <span
              class="font-data text-sm leading-5 font-medium text-ink-muted"
              aria-hidden="true"
            >
              {pad(department.members.length)}
            </span>
          </h3>
          <ul
            class="grid grid-cols-2 gap-x-4 gap-y-8 md:gap-x-6 lg:grid-cols-4"
            data-reveal-stagger
          >
            {department.members.map((member) => (
              <li>
                <TeamCard member={member} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <CtaBlock
    title="¿Quieres trabajar con nuestro equipo?"
    emphasis="nuestro equipo"
    text="Cuéntanos qué proyecto tienes en mente y te ayudamos a definir el alcance, los plazos y los entregables."
  />
</BaseLayout>
