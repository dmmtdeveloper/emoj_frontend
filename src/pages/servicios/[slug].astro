---
import { ArrowRight, CircleCheck, MapPin } from "@lucide/astro";
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import ServiceIcon from "../../components/services/ServiceIcon.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import ButtonLink from "../../components/ui/ButtonLink.astro";
import CtaBlock from "../../components/ui/CtaBlock.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getServices, type Service } from "../../lib/get-services";

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: { service, others: services.filter((s) => s.id !== service.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
  others: Service[];
}

const { service, others } = Astro.props;
const {
  title,
  summary,
  icon,
  slug,
  deliverables,
  examples,
  image,
  imageAlt,
  seo,
  cta,
} = service.data;
const { Content } = await render(service);
const ctaLabel = cta ?? `Cotiza tu proyecto de ${title.toLowerCase()}`;
const ctaHref = `/contacto?servicio=${slug}`;
const whatsapp = { kind: "service", title } as const;
const hasExamples = examples.length > 0;
const labelClass =
  "text-[13px] leading-4 font-medium tracking-[0.08em] text-ink-muted uppercase";
---

<BaseLayout
  whatsapp={whatsapp}
  title={seo.title}
  description={seo.description}
  {...(image ? { image: image.src, imageAlt: imageAlt ?? title } : {})}
>
  <PageHeader eyebrow="Servicio" title={title} lead={summary}>
    <Breadcrumb
      slot="breadcrumb"
      items={[
        { label: "Inicio", href: "/" },
        { label: "Servicios", href: "/servicios" },
        { label: title, href: `/servicios/${slug}` },
      ]}
    />
    <div class="flex flex-wrap gap-3 pt-2">
      <ButtonLink href={ctaHref}>{ctaLabel}</ButtonLink>
    </div>
  </PageHeader>

  <section class="bg-surface-sunken">
    <div class="container-site grid gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-16">
      <div class="flex max-w-[65ch] flex-col gap-4 text-ink [&_h2]:mt-8 [&_h2]:text-[26px] [&_h2]:leading-8 [&_h2]:font-semibold [&_h2]:tracking-[-0.01em] md:[&_h2]:text-[34px] md:[&_h2]:leading-10 [&_li]:relative [&_li]:pl-6 [&_li]:before:absolute [&_li]:before:top-[11px] [&_li]:before:left-0 [&_li]:before:size-2 [&_li]:before:rounded-full [&_li]:before:bg-brand [&_p:first-child]:text-xl [&_p:first-child]:leading-[30px] [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-3">
        <Content />
      </div>

      <aside
        aria-labelledby="entregables"
        class="radius-signature h-fit border border-border bg-surface-raised p-8 pl-10 shadow-(--shadow-sm) lg:sticky lg:top-24"
      >
        <span class="mb-6 inline-flex size-12 items-center justify-center rounded-full bg-surface-sunken text-brand">
          <ServiceIcon name={icon} />
        </span>
        <h2 id="entregables" class="text-[22px] leading-7 font-semibold">
          Qué te entregamos
        </h2>
        <p class="mt-2 text-sm leading-5 font-medium text-ink-muted">
          Entregables habituales; el alcance final se define contigo.
        </p>
        <ul class="mt-6 flex flex-col gap-3">
          {deliverables.map((item) => (
            <li class="flex gap-3">
              <CircleCheck
                size={20}
                stroke-width={1.75}
                aria-hidden="true"
                class="mt-[3px] shrink-0 text-brand"
              />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <ButtonLink href={ctaHref} class="mt-8 w-full">
          {ctaLabel}
        </ButtonLink>
      </aside>
    </div>
  </section>

  {hasExamples && (
    <section class="bg-surface" aria-labelledby="proyectos-relacionados">
      <div class="container-site grid gap-12 py-16 md:py-24 lg:grid-cols-2 lg:items-center">
        {image && (
          <Image
            src={image}
            alt={imageAlt ?? ""}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1200px) 560px, (min-width: 1024px) 46vw, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full rounded-lg object-cover"
          />
        )}
        <div class="flex flex-col gap-6">
          <p class={labelClass}>Experiencia</p>
          <h2
            id="proyectos-relacionados"
            class="text-[26px] leading-8 font-semibold tracking-[-0.01em] md:text-[34px] md:leading-10"
          >
            Proyectos en los que hemos trabajado
          </h2>
          <ul class="flex flex-col divide-y divide-border border-y border-border">
            {examples.map((example) => (
              <li class="flex flex-col gap-1 py-4">
                <span class="font-semibold text-ink">{example.title}</span>
                <span class="inline-flex items-center gap-2 text-sm leading-5 font-medium text-ink-muted">
                  <MapPin size={20} stroke-width={1.75} aria-hidden="true" />
                  {example.location}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section
    class:list={[hasExamples ? "bg-surface-sunken" : "bg-surface"]}
    aria-labelledby="otros-servicios"
  >
    <div class="container-site py-16 md:py-24">
      <h2
        id="otros-servicios"
        class="text-[26px] leading-8 font-semibold tracking-[-0.01em] md:text-[34px] md:leading-10"
      >
        Otros servicios
      </h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((other) => (
          <li>
            <a
              href={`/servicios/${other.data.slug}`}
              class="group flex min-h-14 items-center gap-3 rounded-md border border-border bg-surface-raised px-4 py-3 font-medium text-ink no-underline transition-colors duration-200 hover:border-border-strong hover:text-ink"
            >
              <span class="text-brand">
                <ServiceIcon name={other.data.icon} size={20} />
              </span>
              <span class="flex-1">{other.data.title}</span>
              <ArrowRight
                size={20}
                stroke-width={1.75}
                aria-hidden="true"
                class="text-ink-muted transition-transform duration-200 group-hover:translate-x-1"
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlock
    background={hasExamples ? "surface" : "surface-sunken"}
    href={ctaHref}
    label={ctaLabel}
    whatsapp={whatsapp}
  />
</BaseLayout>
