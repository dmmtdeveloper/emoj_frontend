---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientsStrip from "../components/home/ClientsStrip.astro";
import Hero from "../components/home/Hero.astro";
import ClosingScene from "../components/home/scenes/ClosingScene.astro";
import ObraScene from "../components/home/scenes/ObraScene.astro";
import PlanoScene from "../components/home/scenes/PlanoScene.astro";
import ReelScene from "../components/home/scenes/ReelScene.astro";
import ServicesScene from "../components/home/scenes/ServicesScene.astro";
import StackScene from "../components/home/scenes/StackScene.astro";
import YearsScene from "../components/home/scenes/YearsScene.astro";
import { organizationJsonLd } from "../lib/structured-data";
import { SITE_NAME } from "../lib/site";
import { contentSource } from "../lib/content";
import { railProjects } from "../lib/content/rail-projects";
import { getServiceTitles } from "../lib/get-services";

// Rendered on demand and cached; publishing refreshes it (src/pages/_revalidate.ts).
export const prerender = false;

const source = contentSource();
const [projects, hero] = await Promise.all([
  source.getProjects(),
  source.findHomeHero(),
]);
/** The home reel shows every published project, the featured ones first. */
const featured = railProjects(projects, 12);
const serviceTitles = await getServiceTitles();
---

{/*
  The home: the hero (the photo slideshow), then seven scroll chapters
  ("del primer trazo a la obra"): each chapter pins and its scene plays
  with the scroll (src/scripts/scenes.ts). `data-nav-section` on each
  chapter lets the header highlight its link (src/scripts/nav-spy.ts).
*/}
<BaseLayout
  title={SITE_NAME}
  description="Consultora de ingeniería civil en Quilpué con más de 30 años: obras sanitarias, viales, cálculo estructural y geotecnia en Valparaíso y Coquimbo."
  jsonLd={[organizationJsonLd(Astro.site)]}
  headerOverlay
>
  <Hero hero={hero} />
  <ServicesScene />
  <ObraScene />
  <PlanoScene />
  {featured.length > 0 && (
    <ReelScene projects={featured} serviceTitles={serviceTitles} />
  )}
  <YearsScene />
  <ClientsStrip />
  <StackScene />
  <ClosingScene />
</BaseLayout>
<script>
  import "../scripts/scenes";
</script>
