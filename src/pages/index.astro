---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientsStrip from "../components/home/ClientsStrip.astro";
import Hero from "../components/home/Hero.astro";
import ContactChapter from "../components/home/chapters/ContactChapter.astro";
import WorkChapter from "../components/home/chapters/WorkChapter.astro";
import PlanChapter from "../components/home/chapters/PlanChapter.astro";
import ProjectsChapter from "../components/home/chapters/ProjectsChapter.astro";
import ServicesChapter from "../components/home/chapters/ServicesChapter.astro";
import ReasonsChapter from "../components/home/chapters/ReasonsChapter.astro";
import YearsChapter from "../components/home/chapters/YearsChapter.astro";
import { organizationJsonLd } from "../lib/structured-data";
import { SITE_NAME } from "../lib/site";
import { contentSource } from "../lib/content";
import { railProjects } from "../lib/content/rail-projects";
import { getServiceTitles } from "../lib/get-services";
import { chapterNumbers } from "../lib/home-chapters";

// Rendered on demand and cached; publishing refreshes it (src/pages/_revalidate.ts).
export const prerender = false;

const source = contentSource();
const [projects, hero] = await Promise.all([
  source.getProjects(),
  source.findHomeHero(),
]);
/** The home reel shows every published project, the featured ones first. */
const featured = railProjects(projects, 12);
const serviceTitles = await getServiceTitles();
const showProjects = featured.length > 0;
/** Numbered from the chapters actually rendered (the hero is 01). */
const n = chapterNumbers([
  "services",
  "work",
  "plan",
  ...(showProjects ? (["projects"] as const) : []),
  "years",
  "reasons",
  "contact",
]);
---

{/*
  The home: the hero (the photo slideshow), then the scroll chapters
  ("del primer trazo a la obra"): most chapters pin and their scene plays
  with the scroll (src/scripts/chapters/scrub.ts); chapter 03 flows with the
  page. `data-nav-section` on each
  chapter lets the header highlight its link (src/scripts/nav-spy.ts).
*/}
<BaseLayout
  title={SITE_NAME}
  description="Consultora de ingeniería civil en Quilpué con más de 30 años: obras sanitarias, viales, cálculo estructural y geotecnia en Valparaíso y Coquimbo."
  jsonLd={[organizationJsonLd(Astro.site)]}
  headerOverlay
>
  <Hero hero={hero} />
  <ServicesChapter number={n.services} />
  <WorkChapter number={n.work} />
  <PlanChapter number={n.plan} />
  {showProjects && n.projects && (
    <ProjectsChapter
      number={n.projects}
      projects={featured}
      serviceTitles={serviceTitles}
    />
  )}
  <YearsChapter number={n.years} />
  <ClientsStrip />
  <ReasonsChapter number={n.reasons} />
  <ContactChapter number={n.contact} />
</BaseLayout>
