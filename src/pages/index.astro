---
import AboutTeaser from "../components/home/AboutTeaser.astro";
import FactsBand from "../components/home/FactsBand.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import HeroScene from "../components/home/scenes/HeroScene.astro";
import ServicesScene from "../components/home/scenes/ServicesScene.astro";
import WhyEmoj from "../components/home/WhyEmoj.astro";
import WorkFlow from "../components/home/WorkFlow.astro";
import CtaBlock from "../components/ui/CtaBlock.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { organizationJsonLd } from "../lib/structured-data";
import { SITE_NAME } from "../lib/site";
import { contentSource } from "../lib/content";
import { railProjects } from "../lib/content/rail-projects";
import { getServiceTitles } from "../lib/get-services";

// Rendered on demand and cached; publishing refreshes it (src/pages/_revalidate.ts).
export const prerender = false;

const source = contentSource();
const [projects, hero] = await Promise.all([
  source.getProjects(),
  source.findHomeHero(),
]);
/** The home rail shows every published project, the featured ones first. */
const featured = railProjects(projects, 12);
const serviceTitles = await getServiceTitles();
const hasFeatured = featured.length > 0;
---

<BaseLayout
  title={SITE_NAME}
  description="Consultora de ingeniería civil en Quilpué con más de 30 años: obras sanitarias, viales, cálculo estructural y geotecnia en Valparaíso y Coquimbo."
  jsonLd={[organizationJsonLd(Astro.site)]}
>
  <HeroScene hero={hero} />
  {/* `data-nav-section`: the header highlights that link while the
      section is on screen (src/scripts/nav-spy.ts). */}
  <ServicesScene />
  <div data-nav-section="/nosotros">
    <WorkFlow />
  </div>
  {hasFeatured && (
    <div data-nav-section="/proyectos">
      <FeaturedProjects projects={featured} serviceTitles={serviceTitles} />
    </div>
  )}
  <div data-nav-section="/nosotros">
    <WhyEmoj background={hasFeatured ? "surface-sunken" : "surface"} />
    <FactsBand />
    <AboutTeaser />
  </div>
  <div data-nav-section="/contacto">
    <CtaBlock background="surface-sunken" />
  </div>
</BaseLayout>
<script>
  import "../scripts/scenes";
</script>
