---
import AboutTeaser from "../components/home/AboutTeaser.astro";
import ClientsStrip from "../components/home/ClientsStrip.astro";
import FactsBand from "../components/home/FactsBand.astro";
import Hero from "../components/home/Hero.astro";
import ServicesSection from "../components/home/ServicesSection.astro";
import WhyEmoj from "../components/home/WhyEmoj.astro";
import CtaBlock from "../components/ui/CtaBlock.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { organizationJsonLd } from "../lib/structured-data";
import { SITE_NAME } from "../lib/site";
---

<BaseLayout
  title={SITE_NAME}
  description="Consultora de ingeniería civil en Quilpué con más de 30 años: obras sanitarias, viales, cálculo estructural y geotecnia en Valparaíso y Coquimbo."
  jsonLd={[organizationJsonLd(Astro.site)]}
>
  <Hero />
  <ClientsStrip />
  <ServicesSection />
  <WhyEmoj />
  <FactsBand />
  <AboutTeaser />
  <CtaBlock background="surface-sunken" />
</BaseLayout>
