---
import { ArrowRight } from "@lucide/astro";
import { getImage, Image } from "astro:assets";
import ServiceIcon from "../../components/services/ServiceIcon.astro";
import ArrowLink from "../../components/ui/ArrowLink.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import CtaBlock from "../../components/ui/CtaBlock.astro";
import ButtonLink from "../../components/ui/ButtonLink.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { MediaRef } from "../../lib/api/client";
import { contentSource } from "../../lib/content";
import { fitWidth } from "../../lib/content/format";
import { mediaPath } from "../../lib/content/media";
import { setPreviewHeaders } from "../../lib/content/preview";
import { projectTransitionName } from "../../lib/content/transition";
import { getServices } from "../../lib/get-services";
import { projectJsonLd } from "../../lib/structured-data";

// Rendered on demand and cached; publishing refreshes it (src/pages/_revalidate.ts).
export const prerender = false;

// /preview rewrites here with the draft in locals (src/pages/preview.astro).
const draft = Astro.locals.preview;
const isPreview = draft?.kind === "project";
const project = isPreview
  ? draft.project
  : await contentSource().findProject(Astro.params.slug ?? "");
if (!project) return Astro.rewrite("/no-encontrada");
const whatsapp = { kind: "project", title: project.title } as const;
if (isPreview) setPreviewHeaders(Astro.response.headers);

/** Published photos come from /media; a draft's are not there yet. */
const photo = (image: MediaRef) =>
  isPreview ? image.url : mediaPath("proyectos", project.slug, image);
const allServices = await getServices();
const services = project.services
  .map((slug) => allServices.find((s) => s.data.slug === slug))
  .filter((s) => s !== undefined);

const site = Astro.site ?? new URL("https://emoj.cl");
const pageUrl = new URL(`/proyectos/${project.slug}`, site).href;
const place = [project.location, project.region].filter(Boolean).join(", ");

const ogSource = project.seo.ogImage ?? project.cover;
const ogImage =
  ogSource && !isPreview
    ? await getImage({
        src: mediaPath("proyectos", project.slug, ogSource),
        width: 1200,
        height: 630,
        fit: "cover",
        format: "jpeg",
      })
    : undefined;

/** Plain-text long fields: blank lines separate paragraphs. */
function paragraphs(text: string): string[] {
  return text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
}

const story = [
  { id: "desafio", title: "El desafío", text: project.challenge },
  { id: "solucion", title: "La solución", text: project.solution },
  { id: "resultado", title: "El resultado", text: project.result },
].filter((section) => section.text.trim() !== "");

/** The project sheet: the place first (the big sage block), then the rest. */
const sheet = [
  { label: "Ubicación", value: place },
  { label: "Cliente", value: project.client },
  { label: "Año", value: project.year ? String(project.year) : "" },
].filter((item) => item.value !== "");
const eyebrow = [services[0]?.data.title, project.location]
  .filter(Boolean)
  .join(" · ");

const firstService = project.services[0];
const ctaHref = firstService
  ? `/contacto?servicio=${firstService}`
  : "/contacto";
---

<BaseLayout
  whatsapp={whatsapp}
  preview={isPreview}
  title={project.seo.title}
  description={project.seo.description}
  {...(ogImage
    ? { image: ogImage.src, imageAlt: ogSource?.alt ?? project.title }
    : {})}
  jsonLd={[
    projectJsonLd(
      {
        url: pageUrl,
        title: project.title,
        summary: project.summary,
        location: project.location,
        region: project.region,
        client: project.client,
        ...(project.year ? { year: project.year } : {}),
        serviceNames: services.map((s) => s.data.title),
        ...(ogImage ? { image: new URL(ogImage.src, site).href } : {}),
      },
      Astro.site,
    ),
  ]}
>
  <section aria-labelledby="ficha-titulo" class="bg-plum-950 text-sand-50">
    <div class="container-site grid gap-8 py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:grid-rows-[auto_1fr] lg:gap-x-14 lg:py-20">
      <div class="flex min-w-0 flex-col gap-8 lg:col-start-1 lg:row-start-1">
        <Breadcrumb
          inverse
          items={[
            { label: "Inicio", href: "/" },
            { label: "Proyectos", href: "/proyectos" },
            { label: project.title, href: `/proyectos/${project.slug}` },
          ]}
        />
        <div class="flex flex-col gap-5">
          {eyebrow && (
            <p class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sage-300 uppercase">
              {eyebrow}
            </p>
          )}
          <h1
            id="ficha-titulo"
            class="text-[clamp(2.25rem,1.6rem+2.8vw,4.25rem)] leading-[1.02] font-semibold tracking-[-0.045em] text-balance"
          >
            {project.title}
          </h1>
          {project.summary && (
            <p class="text-lead max-w-[52ch] text-sand-100">
              {project.summary}
            </p>
          )}
        </div>
      </div>

      {project.cover && (
        <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
          <Image
            src={photo(project.cover)}
            alt={project.cover.alt}
            {...fitWidth(project.cover, 1600)}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1200px) 600px, (min-width: 1024px) 50vw, calc(100vw - 32px)"
            loading="eager"
            fetchpriority="high"
            data-vt={projectTransitionName(project.slug)}
            class="vt-project aspect-[4/3] w-full rounded-l-signature object-cover lg:sticky lg:top-24 lg:aspect-auto lg:h-[min(80vh,760px)]"
          />
        </div>
      )}

      <div class="flex min-w-0 flex-col gap-8 lg:col-start-1 lg:row-start-2">
        {sheet.length > 0 && (
          <dl class="grid grid-cols-2 gap-3">
            {sheet.map((item, i) => (
              <div
                class:list={[
                  "flex flex-col gap-1.5 rounded-lg px-5 py-4 md:px-6 md:py-5",
                  i === 0
                    ? "col-span-2 bg-accent text-on-accent"
                    : "bg-plum-900",
                  i > 0 &&
                    i === sheet.length - 1 &&
                    i % 2 === 1 &&
                    "col-span-2",
                ]}
              >
                <dt
                  class:list={[
                    "font-data text-[12px] leading-4 font-medium tracking-[0.1em] uppercase",
                    i === 0 ? "text-on-accent" : "text-sand-300",
                  ]}
                >
                  {item.label}
                </dt>
                <dd
                  class:list={[
                    "font-data font-medium tracking-[-0.02em]",
                    i === 0
                      ? "text-[28px] leading-9 md:text-[36px] md:leading-10"
                      : "text-xl leading-7",
                  ]}
                >
                  {item.value}
                </dd>
              </div>
            ))}
          </dl>
        )}

        {services.length > 0 && (
          <div class="flex flex-col gap-3">
            <p class="font-data text-[12px] leading-4 font-medium tracking-[0.1em] text-sand-300 uppercase">
              {services.length === 1 ? "Especialidad" : "Especialidades"}
            </p>
            <ul class="flex flex-wrap gap-2">
              {services.map((service) => (
                <li>
                  <a
                    href={`/servicios/${service.data.slug}`}
                    class="inline-flex min-h-9 items-center rounded-full border border-sand-50/30 px-3.5 text-sm leading-5 font-medium text-sand-50 no-underline transition-colors hover:border-sand-50/70 hover:text-sand-50"
                  >
                    {service.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {story.length > 0 && (
          <ol class="flex flex-col border-b border-plum-800">
            {story.map((section, i) => (
              <li class="grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 border-t border-plum-800 py-6">
                <span
                  class="font-data text-sm leading-7 font-medium text-sage-300"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="flex flex-col gap-3">
                  <h2
                    id={section.id}
                    class="text-[22px] leading-7 font-semibold"
                  >
                    {section.title}
                  </h2>
                  <div class="flex max-w-[65ch] flex-col gap-4 text-sand-100">
                    {paragraphs(section.text).map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        )}

        <ButtonLink
          href={ctaHref}
          variant="sage"
          pill
          class="min-h-13 self-start px-7 text-base"
        >
          Cotiza un proyecto similar
          <ArrowRight size={20} stroke-width={1.75} aria-hidden="true" />
        </ButtonLink>
      </div>
    </div>
  </section>

  {project.gallery.length > 0 && (
    <section class="bg-surface-sunken" aria-labelledby="galeria">
      <div class="container-site flex flex-col gap-8 py-16 md:py-24">
        <SectionHeading id="galeria" eyebrow="En terreno" title="Galería" />
        <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-6">
          {project.gallery.map((image) => (
            <li>
              <Image
                src={photo(image)}
                alt={image.alt}
                {...fitWidth(image, 800)}
                widths={[320, 640, 800]}
                sizes="(min-width: 1200px) 373px, (min-width: 768px) 31vw, 46vw"
                loading="lazy"
                class="aspect-[4/3] w-full rounded-lg object-cover"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {services.length > 0 && (
    <section
      class:list={[
        project.gallery.length > 0 ? "bg-surface" : "bg-surface-sunken",
      ]}
      aria-labelledby="servicios-relacionados"
    >
      <div class="container-site flex flex-col gap-8 py-16 md:py-24">
        <SectionHeading
          id="servicios-relacionados"
          eyebrow="Especialidades"
          title="Servicios relacionados"
        >
          <ArrowLink slot="action" href="/proyectos">
            Ver todos los proyectos
          </ArrowLink>
        </SectionHeading>
        <ul
          class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
          data-reveal-stagger
        >
          {services.map((service) => (
            <li>
              <a
                href={`/servicios/${service.data.slug}`}
                class="group flex min-h-14 items-center gap-3 rounded-md border border-border bg-surface-raised px-4 py-3 font-medium text-ink no-underline transition-colors duration-200 hover:border-border-strong hover:text-ink"
              >
                <span class="text-brand">
                  <ServiceIcon name={service.data.icon} size={20} />
                </span>
                <span class="flex-1">{service.data.title}</span>
                <ArrowRight
                  size={20}
                  stroke-width={1.75}
                  aria-hidden="true"
                  class="text-ink-muted transition-transform duration-200 group-hover:translate-x-1"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBlock
    title="¿Tienes un proyecto similar?"
    text="Cuéntanos dónde está y qué necesitas. Te ayudamos a definir el alcance, los plazos y los entregables."
    href={ctaHref}
    label="Cotiza un proyecto similar"
    background={project.gallery.length > 0 ? "surface-sunken" : "surface"}
    whatsapp={whatsapp}
  />
</BaseLayout>
