---
import NewsListing from "../../../components/news/NewsListing.astro";
import { getNews } from "../../../lib/content";
import { NEWS_PER_PAGE, paginate } from "../../../lib/content/format";
import type { NewsSummary } from "../../../lib/content/types";

/** Pages 2..n of the news index; page 1 is /noticias. */
export async function getStaticPaths() {
  const news = await getNews();
  const pages = paginate(news, NEWS_PER_PAGE);
  return pages.slice(1).map((articles, i) => ({
    params: { page: String(i + 2) },
    props: { articles, page: i + 2, pages: pages.length, total: news.length },
  }));
}

interface Props {
  articles: NewsSummary[];
  page: number;
  pages: number;
  total: number;
}

const { articles, page, pages, total } = Astro.props;
---

<NewsListing articles={articles} page={page} pages={pages} total={total} />
