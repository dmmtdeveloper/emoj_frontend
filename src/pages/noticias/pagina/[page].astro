---
import NewsListing from "../../../components/news/NewsListing.astro";
import { contentSource } from "../../../lib/content";
import { NEWS_PER_PAGE, paginate } from "../../../lib/content/format";

/** Pages 2..n, rendered on demand; page 1 is /noticias. */
export const prerender = false;

const page = /^[2-9]$|^[1-9][0-9]+$/.test(Astro.params.page ?? "")
  ? Number(Astro.params.page)
  : NaN;
const pages = Number.isNaN(page)
  ? []
  : paginate(await contentSource().getNews(), NEWS_PER_PAGE);
const articles = pages[page - 1];
if (!articles) return Astro.rewrite("/no-encontrada");
---

<NewsListing articles={articles} page={page} pages={pages.length} />
