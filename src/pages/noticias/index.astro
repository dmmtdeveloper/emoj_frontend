---
import NewsListing from "../../components/news/NewsListing.astro";
import { contentSource } from "../../lib/content";
import { NEWS_PER_PAGE, paginate } from "../../lib/content/format";

export const prerender = false;

const news = await contentSource().getNews();
const pages = paginate(news, NEWS_PER_PAGE);
---

<NewsListing
  articles={pages[0] ?? []}
  page={1}
  pages={pages.length}
  total={news.length}
/>
