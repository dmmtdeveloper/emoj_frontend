---
import NewsListing from "../../components/news/NewsListing.astro";
import { contentSource } from "../../lib/content";
import { NEWS_PER_PAGE, paginate } from "../../lib/content/format";

export const prerender = false;

const pages = paginate(await contentSource().getNews(), NEWS_PER_PAGE);
---

<NewsListing articles={pages[0] ?? []} page={1} pages={pages.length} />
