---
/**
 * An article, in the home's voice:
 * - The cover full-bleed under the transparent header, with the category,
 *   title, date and reading time over it (plum header without a cover).
 *   The card photo morphs into it on navigation (.vt-project).
 * - A reading progress line along the top (motion.css `.read-progress`).
 * - The excerpt as the lead, then the body and the photo gallery (a
 *   mosaic that opens a full-screen viewer). On desktop the share links
 *   stay beside the text; on phones they follow it.
 * - The location, when the article has one, beside the date.
 * - "Más noticias": the newest other articles, and the closing CTA.
 */
import { Link as LinkIcon, MapPin } from "@lucide/astro";
import { getImage } from "astro:assets";
import { render } from "astro:content";
import NewsCard from "../../components/news/NewsCard.astro";
import PhotoGallery from "../../components/ui/PhotoGallery.astro";
import ArrowLink from "../../components/ui/ArrowLink.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import CtaBlock from "../../components/ui/CtaBlock.astro";
import SocialIcon from "../../components/ui/SocialIcon.astro";
import WhatsAppIcon from "../../components/ui/WhatsAppIcon.astro";
import CoverImage from "../../components/ui/CoverImage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticleEntry, getNews } from "../../lib/content";
import { formatDate, shareLinks } from "../../lib/content/format";
import { moreNews } from "../../lib/content/news-listing";
import {
  readingMinutes,
  readingTimeLabel,
} from "../../lib/content/reading-time";
import { newsTransitionName } from "../../lib/content/transition";
import type { NewsDetail } from "../../lib/content/types";
import { articleJsonLd } from "../../lib/structured-data";

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((article) => ({
    params: { slug: article.slug },
    props: { article, news },
  }));
}

interface Props {
  article: NewsDetail;
  /** Every article, newest first (for "Más noticias"). */
  news: NewsDetail[];
}

const { article, news } = Astro.props;
const { Content } = await render(await getArticleEntry(article.slug));
const whatsapp = { kind: "article", title: article.title } as const;
const site = Astro.site ?? new URL("https://emoj.cl");
const pageUrl = new URL(`/noticias/${article.slug}`, site).href;
const share = shareLinks(pageUrl, article.title);
const reading = readingTimeLabel(readingMinutes(article.body, article.excerpt));
const others = moreNews(news, article.slug, 3);
const gallery = article.gallery;

const ogSource = article.seo.ogImage ?? article.cover;
const ogImage = ogSource
  ? await getImage({
      src: ogSource.src,
      width: 1200,
      height: 630,
      fit: "cover",
      format: "jpeg",
    })
  : undefined;

const shareLink =
  "inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-surface-raised px-4 py-2 text-sm leading-5 font-medium text-ink no-underline transition-colors duration-200 hover:border-brand hover:text-brand";
---

<BaseLayout
  whatsapp={whatsapp}
  headerOverlay={Boolean(article.cover)}
  title={article.seo.title}
  description={article.seo.description}
  {...(ogImage
    ? { image: ogImage.src, imageAlt: ogSource?.alt ?? article.title }
    : {})}
  jsonLd={[
    articleJsonLd(
      {
        url: pageUrl,
        title: article.title,
        description: article.excerpt || article.seo.description,
        publishedAt: article.publishedAt,
        category: article.category,
        ...(ogImage ? { image: new URL(ogImage.src, site).href } : {}),
      },
      Astro.site,
    ),
  ]}
>
  <div class="read-progress" aria-hidden="true"></div>

  <article>
    <header
      class:list={[
        "relative isolate overflow-hidden bg-plum-950 text-sand-50",
        article.cover && "-mt-(--header-h)",
      ]}
    >
      {article.cover && (
        <>
          {/* The cover, drifting slower than the page on desktop (motion.css). */}
          <div class="hero__parallax absolute inset-0 -z-10 overflow-hidden">
            <CoverImage
              image={article.cover}
              name={newsTransitionName(article.slug)}
            />
          </div>
          {/* Veils as on the project page: the photo leads. */}
          <div class="ficha-veils pointer-events-none absolute inset-0 -z-10">
            <div
              class="absolute inset-0 bg-linear-to-t from-plum-950/95 via-plum-950/55 via-55% to-plum-950/25 md:bg-plum-950/20 md:bg-none"
              aria-hidden="true"
            ></div>
            <div
              class="absolute inset-0 hidden bg-linear-to-r from-plum-950/85 via-plum-950/45 via-45% to-transparent to-75% md:block"
              aria-hidden="true"
            ></div>
            <div
              class="absolute inset-0 hidden bg-linear-to-t from-plum-950/85 to-transparent to-45% md:block"
              aria-hidden="true"
            ></div>
          </div>
        </>
      )}

      <div
        class:list={[
          "ficha-content hero__content container-site flex flex-col justify-end gap-6 pb-10 md:gap-7 md:pb-14",
          article.cover
            ? "min-h-[max(560px,82svh)] pt-[calc(var(--header-h)+40px)]"
            : "pt-12 md:pt-16",
        ]}
      >
        <div class="hidden md:block">
          <Breadcrumb
            inverse
            items={[
              { label: "Inicio", href: "/" },
              { label: "Noticias", href: "/noticias" },
              { label: article.title, href: `/noticias/${article.slug}` },
            ]}
          />
        </div>
        <p class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-sage-300 uppercase">
          Noticias{article.category && <> · {article.category}</>}
        </p>
        <h1 class="max-w-[22ch] text-[clamp(2rem,1.4rem+2.4vw,3.5rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance">
          {article.title}
        </h1>
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-data text-sm leading-5 font-medium text-sand-100">
          <time datetime={article.publishedAt}>
            {formatDate(article.publishedAt)}
          </time>
          {article.location && (
            <>
              <span aria-hidden="true" class="text-sage-300">
                ·
              </span>
              <span class="inline-flex items-center gap-1.5">
                <MapPin
                  size={16}
                  stroke-width={1.75}
                  aria-hidden="true"
                  class="text-sage-300"
                />
                <span class="sr-only">Lugar:</span>
                {article.location}
              </span>
            </>
          )}
          <span aria-hidden="true" class="text-sage-300">
            ·
          </span>
          <span>{reading}</span>
        </p>
      </div>
    </header>

    <div class="bg-surface">
      <div class="container-site grid gap-12 py-12 md:py-20 lg:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] lg:gap-16 lg:py-24">
        <div class="flex min-w-0 flex-col gap-8 lg:col-start-2">
          {article.excerpt && (
            <p
              data-reveal
              class="max-w-[38ch] border-l-2 border-brand pl-5 text-[clamp(1.25rem,1.1rem+0.6vw,1.625rem)] leading-[1.4] font-medium tracking-[-0.01em] text-ink md:pl-6"
            >
              {article.excerpt}
            </p>
          )}
          <div class="article-body">
            <Content />
          </div>
          {gallery.length > 0 && (
            <section
              aria-labelledby="fotos"
              class="flex flex-col gap-5 border-t border-border pt-8"
            >
              <h2
                id="fotos"
                class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-ink-muted uppercase"
              >
                Fotos · {String(gallery.length).padStart(2, "0")}
              </h2>
              <PhotoGallery photos={gallery} layout="narrow" />
            </section>
          )}
        </div>

        <aside
          aria-labelledby="compartir"
          class="lg:col-start-1 lg:row-start-1 lg:self-start lg:pt-1 lg:sticky lg:top-28"
        >
          <div class="flex max-w-[65ch] flex-col gap-4 border-t border-border pt-8 lg:border-t-0 lg:pt-0">
            <h2
              id="compartir"
              class="font-data text-[12px] leading-4 font-medium tracking-[0.1em] text-ink-muted uppercase"
            >
              Comparte esta noticia
            </h2>
            <div class="flex flex-wrap items-center gap-2 lg:flex-col lg:items-start">
              <a
                href={share.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class={shareLink}
              >
                <SocialIcon name="LinkedIn" />
                LinkedIn
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
              <a
                href={share.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class={shareLink}
              >
                <WhatsAppIcon size={20} />
                WhatsApp
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
              <button
                type="button"
                data-copy-link={pageUrl}
                class:list={[shareLink, "cursor-pointer"]}
                hidden
              >
                <LinkIcon size={20} stroke-width={1.75} aria-hidden="true" />
                Copiar enlace
              </button>
              <span
                data-copy-status
                role="status"
                class="text-sm leading-5 font-medium text-ink-muted"
              ></span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {others.length > 0 ? (
    <section aria-labelledby="mas-noticias" class="bg-surface-sunken">
      <div class="container-site flex flex-col gap-10 py-16 md:gap-12 md:py-24">
        <div
          data-reveal
          class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-12"
        >
          <div class="flex flex-col gap-4">
            <p class="font-data text-[13px] leading-4 font-medium tracking-[0.1em] text-brand uppercase">
              Más noticias
            </p>
            <h2 id="mas-noticias" class="text-h2 text-ink">
              Sigue <em class="font-medium text-brand">leyendo</em>.
            </h2>
          </div>
          <ArrowLink href="/noticias" class="self-start text-ink md:self-auto">
            Ver todas las noticias
          </ArrowLink>
        </div>
        <ul
          class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-8"
          data-reveal-stagger
        >
          {others.map((other) => (
            <li>
              <NewsCard article={other} headingLevel="h3" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : (
    <div class="bg-surface">
      <div class="container-site pb-12">
        <ArrowLink href="/noticias" class="text-ink">
          Ver todas las noticias
        </ArrowLink>
      </div>
    </div>
  )}

  <CtaBlock
    background={others.length > 0 ? "surface" : "surface-sunken"}
    whatsapp={whatsapp}
  />
</BaseLayout>

<script>
  import { initCopyLinks } from "../../scripts/copy-link";
  initCopyLinks();
</script>
