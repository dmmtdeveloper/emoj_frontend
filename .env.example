# Canonical public origin of the site. Used for canonical URLs, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://emoj.cl

# Base URL of the EMOJ Go API (emoj_backend). The pages with projects and news
# read it when they are rendered (on demand, then cached). Local default for
# development; https://api-staging-25e9.up.railway.app uses staging.
PUBLIC_API_URL=http://localhost:8080

# Cloudflare Turnstile site key (public) for the contact form.
# When unset, the site uses Cloudflare's test key 1x00000000000000000000AA,
# which always passes; pair it with the test secret in the API.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret for refreshing cached pages after a change in the panel (server
# only; set it in Vercel too). Generate one with `openssl rand -hex 32`.
# Not needed in `pnpm dev`, where every page is rendered fresh.
REVALIDATE_TOKEN=
